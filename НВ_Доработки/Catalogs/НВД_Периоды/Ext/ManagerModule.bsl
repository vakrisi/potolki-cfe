Функция ПолучитьМассивПериодов(ПериодИерархии, Периодичность) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Периоды.Ссылка
	               |ИЗ
	               |	Справочник.НВД_Периоды КАК Периоды
	               |ГДЕ
	               |	Периоды.Ссылка В ИЕРАРХИИ(&ПериодИерархии)
	               |	И Периоды.Периодичность = &Периодичность
	               |	И Периоды.ПометкаУдаления = ЛОЖЬ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Периоды.ДатаНачала";
	Запрос.УстановитьПараметр("ПериодИерархии", ПериодИерархии);
	Запрос.УстановитьПараметр("Периодичность", Периодичность);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции // ПолучитьМассивПериодов()
