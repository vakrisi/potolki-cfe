Функция ПараметрыДляСБПЗаполнены() 
	
	Если ЗначениеЗаполнено(Объект.НВД_ОрганизацияСБП) И ЗначениеЗаполнено(Объект.НВД_СчетСБП) И 
		Объект.НВД_ИспользоватьСБП И ЗначениеЗаполнено(Объект.НВД_СчетСБП.НВД_legalId) И 
		ЗначениеЗаполнено(Объект.НВД_СчетСБП.НВД_merchantId) Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;	
	
КонецФункции  

&НаКлиенте
Функция ПолучитьПараметрыПодключенияСБП() 
	
	Результат = Новый Структура;
	Результат.Вставить("ЗащитаСоединения"	, Новый ЗащищенноеСоединениеOpenSSL(Неопределено, Неопределено));
	Результат.Вставить("АдресСервиса"		, "testapi.sbp.gazprombank.ru");
	Результат.Вставить("ПортСервиса"		, 9443);
	
	Возврат Результат; 
	
КонецФункции // ПолучитьЗащищенноеСоединениеБСП()

