&НаСервере
Процедура ЗаполнитьОрганизациюИСчетДляСБП()	
	Если НЕ ЗначениеЗаполнено(Объект.НВД_ОрганизацияСБП) Тогда
		МассивОрагизацийССБП = СформироватьМассивОрганизацийССБП();
		Если МассивОрагизацийССБП.Количество() > 0 Тогда
			Объект.НВД_ОрганизацияСБП = МассивОрагизацийССБП[0];
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.НВД_СчетСБП) И ЗначениеЗаполнено(Объект.НВД_ОрганизацияСБП) Тогда 
		Объект.НВД_СчетСБП	= Объект.НВД_ОрганизацияСБП.НВД_СчетДляСБП;
	КонецЕсли;	
КонецПроцедуры

