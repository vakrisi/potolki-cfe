&НаСервере
Функция ПолучитьСтруктуруПараметровСчетаДляСПБ(БанковскийСчет)
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("legalId", БанковскийСчет.НВД_legalId);
	СтруктураПараметров.Вставить("merchantId", БанковскийСчет.НВД_merchantId);
	СтруктураПараметров.Вставить("account", БанковскийСчет.НомерСчета);
	
	Возврат СтруктураПараметров;
	
КонецФункции	

&НаКлиенте
Функция ПолучитьJSONРегистрацииInvoiceМетки() Экспорт   
	
	Результат = Новый Структура("Результат, ПричинаОтказа, СтрокаQRМетки", Ложь, "", "");
	
	ПараметрыЗаписи_JSON = Новый ПараметрыЗаписиJSON(, Символы.Таб);
	Запись_JSON = Новый ЗаписьJSON;
	Запись_JSON.УстановитьСтроку(ПараметрыЗаписи_JSON);
	
	СтруктураПараметровСчетаДляСПБ = ПолучитьСтруктуруПараметровСчетаДляСПБ(Объект.НВД_СчетСБП);
	
	СтруктураКода = Новый Структура();
	СтруктураКода.Вставить("legalId"						, СтруктураПараметровСчетаДляСПБ.legalId);
	СтруктураКода.Вставить("account"						, СтруктураПараметровСчетаДляСПБ.account);
	СтруктураКода.Вставить("merchantId"						, СтруктураПараметровСчетаДляСПБ.merchantId);
	СтруктураКода.Вставить("templateVersion"				, "01");
	СтруктураКода.Вставить("qrcType"						, "01");
	//СтруктураКода.Вставить("amount"							, "1500");
	//СтруктураКода.Вставить("currency"						, "RUB");
	СтруктураКода.Вставить("paymentPurpose"					, НазначениеПлатежаНаСервере(Объект.Ссылка));
	//СтруктураКода.Вставить("paymentDetails"					, СтруктураДеталиПолупки);
	СтруктураКода.Вставить("callbackMerchantNotifications"	, "http://1c.optceiling.ru/workbase/hs/gpb");         //     свой url  
	СтруктураКода.Вставить("mediaType"						, "image/png");
	СтруктураКода.Вставить("width"						    , "300");
	СтруктураКода.Вставить("height"						    , "300");
	
	ЗаписатьJSON(Запись_JSON, СтруктураКода);
	
	//Запись_JSON.ЗаписатьКонецОбъекта();
	Строка_JSON	= Запись_JSON.Закрыть();
	
	Результат.Результат		= Истина;
	Результат.ПричинаОтказа	= "";
	Результат.СтрокаQRМетки	= Строка_JSON;
	
	Возврат Результат; 
	
КонецФункции // ПолучитьJSONФормированияQRКода()

&НаКлиенте
Функция РегистрацияInvoiceМетки()  
	
	Результат = Новый Структура("Результат, ПричинаОтказа, СтрокаQRМетки, QRCLD, mediaType, content", Ложь, "", "", "", "", "");
	
	ИмячЭтапа = "Регистрация Invoice Метки";
	
	//сформриуем JSON строку запроса
	СтруктураInvoiceМетки = ПолучитьJSONРегистрацииInvoiceМетки();
	
	Если СтруктураInvoiceМетки.Результат Тогда
		СтрокаТелаЗапроса = СтруктураInvoiceМетки.СтрокаQRМетки;
		
		Заголовки = Новый Соответствие;
		//Заголовки.Вставить("Host","195.225.38.125");
		Заголовки.Вставить("Content-Type", "application/json");
		//Заголовки.Вставить("Content-Type", "text/plain");
		//--data-raw '
		
		ПараметрыСоединения = ПолучитьПараметрыПодключенияСБП();
		
		HTTP_Запрос = Новый HTTPЗапрос("/merchant/v1/qrc-data", Заголовки);
		HTTP_Запрос.УстановитьТелоИзСтроки(СтрокаТелаЗапроса);  
		
		НТТР_Соединение = Новый HTTPСоединение(ПараметрыСоединения.АдресСервиса //сервер
		, ПараметрыСоединения.ПортСервиса //порт
		, "LA0000047585"//пользователь
		, "Km27b8fkeTuuBo"//пароль
		, //прокси
		, //таймаут
		, ПараметрыСоединения.ЗащитаСоединения //параметры защиты соединения... корое где SSL сертификат барть
		, //испольовать аутентификацию ОС
		);
		//-- 
		
		Попытка
			HTTP_Ответ = НТТР_Соединение.ОтправитьДляОбработки(HTTP_Запрос); //это POST запрос  
		Исключение
		    Сообщить(ОписаниеОшибки());
			Возврат Результат;  
		КонецПопытки; 
		
		ТекстОтветаHTTP = HTTP_Ответ.ПолучитьТелоКакСтроку(); 
		
		//Сообщить(ТекстОтветаHTTP);
		
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТекстОтветаHTTP);
		ДанныеJSON = ПрочитатьJSON(ЧтениеJSON);
		
		Для Каждого Стр из ДанныеJSON Цикл 
			Если Стр.Ключ = "data" Тогда 
				Для Каждого СтрДата Из Стр.Значение Цикл 
					Если СтрДата.Ключ = "payload" Тогда 
						СсылкаQR = СтрДата.Значение;	
					КонецЕсли;
					Если СтрДата.Ключ = "qrcId" Тогда 
						QRCLD = СтрДата.Значение;	
					КонецЕсли;
					Если СтрДата.Ключ = "image" Тогда
						Для Каждого СтрImg Из СтрДата.Значение Цикл
							Если СтрImg.Ключ = "mediaType" Тогда 
								mediaType = СтрImg.Значение;	
							КонецЕсли;
							Если СтрImg.Ключ = "content" Тогда 
								content = СтрImg.Значение;	
							КонецЕсли;
						КонецЦикла;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		
		Результат.Результат		= Истина;
		Результат.ПричинаОтказа	= "";
		Результат.СтрокаQRМетки	= СсылкаQR; 
		Результат.QRCLD	= QRCLD;
		Результат.mediaType	= mediaType; 
		Результат.content	= content;
	Иначе
		Результат = СтруктураInvoiceМетки; //полностью копируем результаты регистрации метки
	КонецЕсли;  
	
	Возврат Результат;  
	
КонецФункции // РегистрацияInvoiceМетки()

&НаСервере
Процедура ПоместитьВОбъектНаСервере(content)
	СправочникОбъект = РеквизитФормыВЗначение("Объект");
	СправочникОбъект.НВД_imageParams_content = Новый ХранилищеЗначения(content, Новый СжатиеДанных());
	СправочникОбъект.Записать();
КонецПроцедуры	

&НаКлиенте
Процедура НВД_СгенерироватьQRКодПосле(Команда)
	Если ПараметрыДляСБПЗаполнены() Тогда
		СтруктураQRВзноса = РегистрацияInvoiceМетки(); 
		
		Если СтруктураQRВзноса.Результат Тогда
			СтрокаQRКода = СтруктураQRВзноса.СтрокаQRМетки;
			QRCLD         = СтруктураQRВзноса.QRCLD;
			content       = СтруктураQRВзноса.content;
			Объект.НВД_СтрокаQRМетки = СтрокаQRКода;
			Объект.НВД_qrcld = QRCLD;
			Записать();
			
			ДД = Base64Значение(content);
			Картинка = Новый Картинка(ДД, Ложь);
			СсылкаНаИзображениеQR = ПоместитьВоВременноеХранилище(Картинка, Новый УникальныйИдентификатор);
			ПоместитьВОбъектНаСервере(content);
			
			ЭтаФорма.ОбновитьОтображениеДанных();
		Иначе 
			Сообщить("Не удалось сгенерировать QR!");
		КонецЕсли;		
	Иначе 
		ПоказатьПредупреждение(, "Проверьте, заполнены ли все параметры");
	КонецЕсли; 
КонецПроцедуры

