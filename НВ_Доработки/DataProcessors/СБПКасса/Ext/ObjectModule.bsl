Функция ПоступлениеНаРасчетныйСчетвJSON(ДокументСсылка, ПараметрыРаботы)
	
	
	//Поменять на ставку НДС Организации
	НДС = УчетНДС.СтавкаНДСПоУмолчанию(ДокументСсылка.Организация);
	//НДС = Перечисления.СтавкиНДС.БезНДС;
	
	// варианты из комментария или назначения платежа
	НаименованиеУслуги = "Натяжной потолок";
	
	Если НЕ ПараметрыРаботы.Свойство("GUID_1С") Тогда
		ПараметрыРаботы.Вставить("GUID_1С");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ПараметрыРаботы.GUID_1С) Тогда
		ПараметрыРаботы.GUID_1С = Строка(ДокументСсылка.УникальныйИдентификатор());
	КонецЕсли;	
	
	//nva
	//Если ДокументСсылка.РасшифровкаПлатежа.Количество()  > 0 Тогда
	//	 Для каждого СтрокаРасшифровки Из ДокументСсылка.РасшифровкаПлатежа Цикл
	//	 	 НДСУслуги = СтрокаРасшифровки.СтавкаНДС;
	//		 Прервать;
	//	 КонецЦикла;
	//КонецЕсли;
	
	ТелоЗапроса = Новый Структура;
	ТелоЗапроса.Вставить("external_id",  ПараметрыРаботы.GUID_1С);
	
	Чек = Новый Структура;
	
	
	Клиент =  Новый Структура;  
	//сюда надо вписать эл. адрес клиента
	Клиент.Вставить("email",НВД_ОбщийМодульСервер.ПолучитьEmailКонтрагента(ДокументСсылка.Контрагент));
	Если ЗначениеЗаполнено(ПараметрыРаботы.ТелефонКлиентаСБП) Тогда
		ТелефонКонтрагента = ПараметрыРаботы.ТелефонКлиентаСБП;
	Иначе	
		ТелефонКонтрагента = НВД_ОбщийМодульСервер.ПолучитьТелефонКонтрагента(ДокументСсылка.Контрагент);
	КонецЕсли;

    ТелефонКонтрагента = СтрСоединить(СтрРазделить(ТелефонКонтрагента, СтрСоединить(СтрРазделить(ТелефонКонтрагента, "0123456789"), "")), "");
	
	ТелефонКонтрагента = ?(Лев(ТелефонКонтрагента,1) = "8" ИЛИ Лев(ТелефонКонтрагента,1) = "7", Прав(ТелефонКонтрагента, СтрДлина(ТелефонКонтрагента)-1), ТелефонКонтрагента);
	
	Клиент.Вставить("phone", ТелефонКонтрагента); 
	
	Если ЗначениеЗаполнено(ДокументСсылка.Контрагент) Тогда
		
		РеквизитыКонтрагента = НВД_ОбщегоНазначения.ИННКПППоОрганизацииКонтрагенту(ДокументСсылка.Контрагент);
		ИННКонтрагента = РеквизитыКонтрагента.ИНН;
		Если ЗначениеЗаполнено(ИННКонтрагента) Тогда
			Клиент.Вставить("inn",ИННКонтрагента);
		КонецЕсли;
		// варианты из назаначения платежа или комментария
		Клиент.Вставить("name",ДокументСсылка.Контрагент.Наименование);
	КонецЕсли;
	
	Организация =  Новый Структура;
	Организация.Вставить("email",ПараметрыРаботы.ЭлПочтаОрганизации);
	
	РеквизитыОрганизации = НВД_ОбщегоНазначения.ИННКПППоОрганизацииКонтрагенту(ДокументСсылка.Организация);
	
	ИННОрганизации = РеквизитыОрганизации.ИНН;
	Если ПараметрыРаботы.ИмяСервера = "testonline.atol.ru" Тогда
		ИННОрганизации = "5544332219";
	КонецЕсли;
	Если ЗначениеЗаполнено(ИННОрганизации) Тогда
		Организация.Вставить("inn",ИННОрганизации);
	КонецЕсли;
	Если СтрДлина(ИННОрганизации) <> 10 И СтрДлина(ИННОрганизации) <> 12 Тогда
		ПараметрыРаботы.ТекстСообщения =  "Неправильно указа ИНН организации";
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ПараметрыРаботы.ТекстСообщения;
		Сообщение.Сообщить(); 
		Возврат Неопределено;
	КонецЕсли;
	Организация.Вставить("payment_address",ПараметрыРаботы.СайтОрганизации);
	
	КодНалога = "vat22";
	
	Если НДС = Перечисления.СтавкиНДС.НДС18 Тогда
		КодНалога = "vat18";
	ИначеЕсли НДС = Перечисления.СтавкиНДС.НДС20 Тогда
		КодНалога = "vat20";
	ИначеЕсли НДС = Перечисления.СтавкиНДС.НДС22 Тогда
		КодНалога = "vat22";	
	ИначеЕсли НДС = Перечисления.СтавкиНДС.БезНДС Тогда
		КодНалога = "none";
	КонецЕсли;
	
	Товары = ПолучитьМассивТоваров(ДокументСсылка, ПараметрыРаботы, КодНалога);
	
	// vats
	Если КодНалога <> "none" Тогда
		
		Налоги = Новый Массив;
		
		СТрокаНалоги = Новый Структура;
		СтрокаНалоги.Вставить("type",КодНалога);
		
		ЗначениеСтавкиНДС = УчетНДС.ПолучитьСтавкуНДС(НДС);
		СуммаНДС = Окр(УчетНДС.РассчитатьСуммуНДС(ДокументСсылка.Сумма, Истина, Истина,ЗначениеСтавкиНДС), 2);
		
		СтрокаНалоги.Вставить("sum", СуммаНДС);
		Налоги.Добавить(СтрокаНалоги);
	КонецЕсли;
	
	Оплаты = Новый Массив;
	СтрокаОплаты = Новый Структура;
	Если ПараметрыРаботы.ВидОплаты = 0 Тогда
		ПараметрыРаботы.ВидОплаты = 1; 
	КонецЕсли;
	СтрокаОплаты.Вставить("type",ПараметрыРаботы.ВидОплаты);
	СтрокаОплаты.Вставить("sum",ДокументСсылка.Сумма);
	Оплаты.Добавить(СтрокаОплаты);
	
	Чек.Вставить("client",Клиент);			
	Чек.Вставить("company",Организация);			
	Чек.Вставить("items",Товары);			
	Чек.Вставить("payments",Оплаты);			
	Если КодНалога <> "none" Тогда
		Чек.Вставить("vats",Налоги);			
	КонецЕсли;
	Чек.Вставить("total",ДокументСсылка.Сумма);			
	
	ТелоЗапроса.Вставить("receipt",Чек);			
	ТелоЗапроса.Вставить("timestamp",Формат(ДокументСсылка.Дата,"ДЛФ=DT"));			
	
	ПараметрыЗаписиJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, "  ");
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписиJSON);
	ЗаписатьJSON(ЗаписьJSON, ТелоЗапроса);
	ТекстJSON = ЗаписьJSON.Закрыть();
	
	Возврат ТекстJSON;
	
КонецФункции

