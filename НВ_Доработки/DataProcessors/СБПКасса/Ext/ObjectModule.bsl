	Организация.Вставить("payment_address",ПараметрыРаботы.СайтОрганизации);
	
	
	Товары = Новый Массив;
	
	СтрокаТЧ = Новый Структура;
	
	СтрокаТЧ.Вставить("name",  НаименованиеУслуги);
	СтрокаТЧ.Вставить("price",  ДокументСсылка.Сумма);
	СтрокаТЧ.Вставить("quantity", 1);
	СтрокаТЧ.Вставить("sum", ДокументСсылка.Сумма);
	
	Если Не ЗначениеЗаполнено(ПараметрыРаботы.СпособРасчета) Тогда
		ПараметрыРаботы.СпособРасчета = "full_payment";
	КонецЕсли;
	СтрокаТЧ.Вставить("payment_method", ПараметрыРаботы.СпособРасчета);
	
	Если Не ЗначениеЗаполнено(ПараметрыРаботы.ПредметРасчета) Тогда
		ПараметрыРаботы.ПредметРасчета = "service";
	КонецЕсли;
	СтрокаТЧ.Вставить("payment_object", ПараметрыРаботы.ПредметРасчета);
	
	Налог = Новый Структура;
	КодНалога = "none";
	
	Если НДСУслуги = Перечисления.СтавкиНДС.НДС18 Тогда
		КодНалога = "vat18";
	ИначеЕсли НДСУслуги = Перечисления.СтавкиНДС.НДС20 Тогда
		КодНалога = "vat20";
	ИначеЕсли НДСУслуги = Перечисления.СтавкиНДС.НДС22 Тогда
		КодНалога = "vat22";	
	ИначеЕсли НДСУслуги = Перечисления.СтавкиНДС.БезНДС Тогда
		КодНалога = "none";
	Иначе 
		КодНалога = "none";
	КонецЕсли;
	
	Налог.Вставить("type",КодНалога);
	
	СтрокаТЧ.Вставить("vat",Налог);
	
	Товары.Добавить(СтрокаТЧ);
	
	// vats
	Если КодНалога <> "none" Тогда
		
		Налоги = Новый Массив;
		
		СТрокаНалоги = Новый Структура;
		СтрокаНалоги.Вставить("type",КодНалога);
		
		ЗначениеСтавкиНДС = УчетНДС.ПолучитьСтавкуНДС(НДСУслуги);
		СуммаНДС = Окр(УчетНДС.РассчитатьСуммуНДС(ДокументСсылка.Сумма, Истина, ЗначениеСтавкиНДС), 2);
		
		СтрокаНалоги.Вставить("sum", СуммаНДС);
		Налоги.Добавить(СтрокаНалоги);
	КонецЕсли;
	
	Оплаты = Новый Массив;
	СтрокаОплаты = Новый Структура;
	Если ПараметрыРаботы.ВидОплаты = 0 Тогда
		ПараметрыРаботы.ВидОплаты = 1; 
	КонецЕсли;
	СтрокаОплаты.Вставить("type",ПараметрыРаботы.ВидОплаты);
	СтрокаОплаты.Вставить("sum",ДокументСсылка.Сумма);
	Оплаты.Добавить(СтрокаОплаты);
	
	Чек.Вставить("client",Клиент);			
	Чек.Вставить("company",Организация);			
	Чек.Вставить("items",Товары);			
	Чек.Вставить("payments",Оплаты);			
	Если КодНалога <> "none" Тогда
		Чек.Вставить("vats",Налоги);			
	КонецЕсли;
	Чек.Вставить("total",ДокументСсылка.Сумма);			
	
	ТелоЗапроса.Вставить("receipt",Чек);			
	ТелоЗапроса.Вставить("timestamp",Формат(ДокументСсылка.Дата,"ДЛФ=DT"));			
	
	ПараметрыЗаписиJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, "  ");
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписиJSON);
	ЗаписатьJSON(ЗаписьJSON, ТелоЗапроса);
	ТекстJSON = ЗаписьJSON.Закрыть();
	
	Возврат ТекстJSON;
	
КонецФункции

Процедура ПроверитьЧек(ДокСсылка, ТекстСообщения, НадоСоздавать = Ложь, ТипОперации = "", uuid_Атол = "" ) Экспорт
	
	Если Не ЗначениеЗаполнено(uuid_Атол) Тогда
		Если ТипОперации = "" или ТипОперации = "Приход" Тогда
			uuid_Атол = ДокСсылка.UUID_АТОЛ;
			url_Атол = ДокСсылка.СсылкаНаЧек;
		ИначеЕсли ТипОперации = "Возврат прихода" Тогда
			uuid_Атол = ДокСсылка.UUID_АТОЛ;
			url_Атол = ДокСсылка.СсылкаНаЧек;
			UUID_1С_Возврат = ДокСсылка.UUID_1С_Возврат;
		ИначеЕсли ТипОперации = "Коррекция прихода" Тогда
			uuid_Атол = ДокСсылка.UUID_АТОЛ_Корректирующий;
			url_Атол = ДокСсылка.СсылкаНаЧек_Корректирующий;
			UUID_1С_Корректирующий = ДокСсылка.UUID_1С_Корректирующий;
		КонецЕсли;
	КонецЕсли;
	
	Если uuid_Атол = Неопределено или ПустаяСтрока(uuid_Атол) Тогда
		НадоСоздавать = Истина;
		Возврат;
	КонецЕсли;
		
   	ПараметрыРаботы = ПолучитьПараметрыПодключенияКОнЛайнКассе();
	ПараметрыРаботы.Вставить("ТипОперации",ТипОперации);
	ПараметрыРаботы.Вставить("UUID_1С_Возврат",UUID_1С_Возврат);
	ПараметрыРаботы.Вставить("UUID_1С_Корректирующий",UUID_1С_Корректирующий);
	
	ПолучитьGUIDСсылки(ПараметрыРаботы,ДокСсылка);
	
	ПараметрыРаботы.МетодЗапроса = "GET";

	ПараметрыРаботы.ТекстЗапроса = "possystem/v4/" + ПараметрыРаботы.КодГруппы + "/report/" + uuid_Атол +"?token=" + ПараметрыРаботы.Токен;
	ПараметрыРаботы.Операция = "report";
	ПараметрыРаботы.uuid_Атол = uuid_Атол;
	
	ОтветПолучен = Ложь;
	ОтветПолучен = ПолучитьОтветССайта(ПараметрыРаботы);
	
	Если ОтветПолучен = Ложь или Не ЗначениеЗаполнено(ПараметрыРаботы.ОтветСервера) Тогда
		ДобавитьОписаниеОшибки(ПараметрыРаботы, НСтр("ru = 'Ответ не получен.'"));
		ТекстСообщения = ТекстСообщения + Символы.ПС + ПараметрыРаботы.ТекстСообщения;
		НадоСоздавать = Истина;
		Возврат;
	КонецЕсли;
	
	JSON = Новый ЧтениеJSON();
	JSON.УстановитьСтроку(ПараметрыРаботы.ОтветСервера);
	Результат = ПрочитатьJSON(JSON);
	
	uuidПолучен = Ложь;
	НомерЧека = 0;
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		Если Результат.Свойство("uuid") Тогда
			Если Не ПустаяСтрока(Результат.uuid) и uuid_Атол <> Результат.uuid Тогда		
				Попытка
					ВписатьВДокументЗначение(ДокСсылка, "uuid_Атол", Результат.uuid);
				Исключение
					ДобавитьОписаниеОшибки(ПараметрыРаботы, НСтр("ru = 'Не удалось записать документ.'")
					+ Символы.ПС + ДокСсылка + Символы.ПС 
					+ ПараметрыРаботы.ОтветСервера);
				КонецПопытки;	
			КонецЕсли;
		Иначе
			НадоСоздавать = Истина;
		КонецЕсли;
		Если Результат.Свойство("error") Тогда
			Если Результат.error <> Неопределено Тогда
				ДобавитьОписаниеОшибки(ПараметрыРаботы, НСтр("ru = 'Ответ не получен.'")
				+ Символы.ПС 
				+ ПараметрыРаботы.ОтветСервера);
				ТекстСообщения = ТекстСообщения + Символы.ПС + ПараметрыРаботы.ОтветСервера;
				// уже есть
				Если Результат.error.code = 33 Тогда
					НадоСоздавать = Ложь;
				ИначеЕсли Результат.error.code = 1 Тогда //был превышен таймаут чек не пробился
					НадоСоздавать = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если Результат.Свойство("payload") Тогда
			Если Результат.payload <> Неопределено Тогда
				Если Результат.payload.Свойство("ofd_receipt_url") Тогда
					ofd_receipt_url = Результат.payload.ofd_receipt_url;
				КонецЕсли;
				Если Результат.payload.Свойство("fiscal_receipt_number") Тогда
					НомерЧека = Результат.payload.fiscal_receipt_number;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если Результат.Свойство("status") Тогда
			status = Результат.status;
		КонецЕсли;
		Если НомерЧека <> 0 и status <> "fail" Тогда
			uuidПолучен = Истина;
			//ВписатьНомерЧека(ДокСсылка,НомерЧека);
		КонецЕсли;
		Если uuidПолучен и Не ПустаяСтрока(ofd_receipt_url) и ofd_receipt_url <> url_Атол Тогда
			Попытка
				ВписатьВДокументЗначение(ДокСсылка, "uuid_Атол", Результат.uuid);
				ВписатьВДокументЗначение(ДокСсылка, "СсылкаНаЧек", ofd_receipt_url);
			Исключение
				ДобавитьОписаниеОшибки(ПараметрыРаботы, НСтр("ru = 'Не удалось записать документ.'")
				+ Символы.ПС + ДокСсылка + Символы.ПС 
				+ ПараметрыРаботы.ОтветСервера);
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура СоздатьЧек(ДокСсылка, ТекстСообщения, ТипОперации = "", ТелефонКлиентаСБП = "") Экспорт

	ПараметрыРаботы = ПолучитьПараметрыПодключенияКОнЛайнКассе();
	ПараметрыРаботы.Вставить("ТипОперации",ТипОперации);
	ПараметрыРаботы.Вставить("ТелефонКлиентаСБП",ТелефонКлиентаСБП);
	
	ПолучитьGUIDСсылки(ПараметрыРаботы, ДокСсылка); 
	
	Если ЗначениеЗаполнено(ТекстСообщения) Тогда
		Попытка	
			JSON = Новый ЧтениеJSON();
			JSON.УстановитьСтроку(ТекстСообщения);
	        Результат = ПрочитатьJSON(JSON);
			Если ТипЗнч(Результат) = Тип("Структура") Тогда
				Если Результат.Свойство("status") И Результат.status = "fail" Тогда //на тот случай когда в системе есть чек но он не фискализирован
	            	//тогда формруем новый uuid 1С
					ПараметрыРаботы.GUID_1С = Строка(Новый УникальныйИдентификатор());
				КонецЕсли;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	Если ТипЗнч(ДокСсылка) = Тип("ДокументСсылка.ПоступлениеНаРасчетныйСчет") и (ТипОперации = "Приход" или ТипОперации = "")  Тогда
		ПараметрыРаботы.ТекстЗапроса = "possystem/v4/"+ПараметрыРаботы.КодГруппы+"/sell?token=" + ПараметрыРаботы.Токен;
		ПараметрыРаботы.Операция = "sell";
		ПараметрыРаботы.СпособРасчета = "full_payment";
		ПараметрыРаботы.ПредметРасчета = "commodity";
	ИначеЕсли ТипЗнч(ДокСсылка) = Тип("ДокументСсылка.ПоступлениеНаРасчетныйСчет") и ТипОперации = "Возврат прихода" Тогда
		ПараметрыРаботы.ТекстЗапроса = "possystem/v4/"+ПараметрыРаботы.КодГруппы+"/sell_refund?token=" + ПараметрыРаботы.Токен;
		ПараметрыРаботы.Операция = "sell_refund";
		ПараметрыРаботы.СпособРасчета = "full_payment";
		ПараметрыРаботы.ПредметРасчета = "commodity";
	ИначеЕсли ТипЗнч(ДокСсылка) = Тип("ДокументСсылка.ПоступлениеНаРасчетныйСчет") и ТипОперации = "Коррекция прихода" Тогда
		//ПараметрыРаботы.ТекстЗапроса = "possystem/v4/"+КодГруппы+"/sell_correction?token=" + Токен;
		ПараметрыРаботы.ТекстЗапроса = "possystem/v4/"+ПараметрыРаботы.КодГруппы+"/sell?token=" + ПараметрыРаботы.Токен;
		ПараметрыРаботы.Операция = "sell";
	ИначеЕсли ТипЗнч(ДокСсылка) = Тип("ДокументСсылка.СписаниеСРасчетногоСчета") Тогда
		ПараметрыРаботы.ТекстЗапроса = "possystem/v4/"+ПараметрыРаботы.КодГруппы+"/sell_refund?token=" + ПараметрыРаботы.Токен;
		ПараметрыРаботы.Операция = "sell_refund";
	КонецЕсли;
	
	ПараметрыРаботы.МетодЗапроса = "POST";
	
	// по документу сформировать тело
	Если ТипЗнч(ДокСсылка) = Тип("ДокументСсылка.ПоступлениеНаРасчетныйСчет") Тогда
		ПараметрыРаботы.ТелоЗапроса = ПоступлениеНаРасчетныйСчетвJSON(ДокСсылка,ПараметрыРаботы);
	ИначеЕсли ТипЗнч(ДокСсылка) = Тип("ДокументСсылка.СписаниеСРасчетногоСчета") Тогда
		ПараметрыРаботы.ТелоЗапроса = СписаниеСРасчетногоСчетВJSON(ДокСсылка,ПараметрыРаботы);
	КонецЕсли;
	
	Если ПараметрыРаботы.ТелоЗапроса = Неопределено Тогда
		ДобавитьОписаниеОшибки(ПараметрыРаботы, НСтр("ru = 'Не сформировано тело запроса.'"));
		ТекстСообщения = ТекстСообщения + Символы.ПС + ПараметрыРаботы.ТекстСообщения;
		Возврат;
	КонецЕсли;
	
	ОтветПолучен = Ложь;
	ОтветПолучен = ПолучитьОтветССайта(ПараметрыРаботы);
	Если ОтветПолучен = Ложь или Не ЗначениеЗаполнено(ПараметрыРаботы.ОтветСервера) Тогда
		ДобавитьОписаниеОшибки(ПараметрыРаботы, НСтр("ru = 'Ответ не получен.'"));
		ТекстСообщения = ТекстСообщения + Символы.ПС + ПараметрыРаботы.ТекстСообщения;
		Возврат;
	КонецЕсли;
	
	JSON = Новый ЧтениеJSON();
	JSON.УстановитьСтроку(ПараметрыРаботы.ОтветСервера);
	
	Результат = ПрочитатьJSON(JSON);
	uuidПолучен = Ложь;
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		Если Результат.Свойство("error") Тогда
			Если Результат.error <> Неопределено Тогда
				
				// уже существует
				Если Результат.error.code =  33 Тогда
					uuid_АТОЛ = Результат.uuid;
					uuidПолучен = Истина;
					ПроверитьЧек(ДокСсылка,ТекстСообщения, Ложь, ТипОперации, uuid_АТОЛ);
					//Возврат;
				КонецЕсли;
				
				ДобавитьОписаниеОшибки(ПараметрыРаботы, НСтр("ru = 'Ответ не получен.'")
				+ Символы.ПС 
				+ ПараметрыРаботы.ОтветСервера);
			Иначе
				НомерЧека = 0;
				Если Результат.Свойство("uuid") Тогда
					uuid_Атол = Результат.uuid;
				КонецЕсли;
				Если Результат.Свойство("timestamp") Тогда
					timestamp = Результат.timestamp;
				КонецЕсли;
				Если Результат.Свойство("status") Тогда
					status = Результат.status;
				КонецЕсли;
				Если Результат.Свойство("payload") Тогда
					Если Результат.payload <> Неопределено Тогда
						Если Результат.payload.Свойство("fiscal_receipt_number") Тогда
							НомерЧека = Результат.payload.fiscal_receipt_number;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				Если СтрДлина(uuid_Атол)  > 20 и status <> "fail" Тогда
					uuidПолучен = Истина;
					Попытка
						ВписатьВДокументЗначение(ДокСсылка, "uuid_Атол", НомерЧека);
					Исключение
						ДобавитьОписаниеОшибки(ПараметрыРаботы, НСтр("ru = 'Не удалось записать документ.'")
						+ Символы.ПС + ДокСсылка + Символы.ПС 
						+ ПараметрыРаботы.ОтветСервера);
					КонецПопытки;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если uuidПолучен Тогда
		Попытка
			ВписатьВДокументЗначение(ДокСсылка, "uuid_Атол", Результат.uuid);
		Исключение
			ДобавитьОписаниеОшибки(ПараметрыРаботы, НСтр("ru = 'Не удалось записать документ.'")
			+ Символы.ПС + ДокСсылка + Символы.ПС 
			+ ПараметрыРаботы.ОтветСервера);
		КонецПопытки;
	КонецЕсли; 
	
	ТекстСообщения = ТекстСообщения + Символы.ПС + ПараметрыРаботы.ТекстСообщения;
	
КонецПроцедуры

Процедура ВписатьВДокументЗначение(ДокСсылка, ИмяРеквизита, ЗначениеРеквизита)
	
	Если ЗначениеРеквизита = 0 Тогда
		 Возврат;
	КонецЕсли;
	
	ДокОбъект = ДокСсылка.ПолучитьОбъект();
	
	Если НЕ ОбщегоНазначения.ЕстьРеквизитОбъекта(ИмяРеквизита,ДокОбъект.Метаданные()) Тогда
		 Возврат;
	КонецЕсли;
	
	ДокОбъект[ИмяРеквизита] = ЗначениеРеквизита;
	ДокОбъект.ОбменДанными.Загрузка = Истина;
	ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
	
КонецПроцедуры

#КонецОбласти

