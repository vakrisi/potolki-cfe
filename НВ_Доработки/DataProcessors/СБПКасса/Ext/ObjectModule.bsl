Функция НовыеПараметрыЗапросаДляОнЛайнКассы()
	
	Касса = Константы.НВД_СБПКасса.Получить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТокеныДляОнлайнКасс.Касса КАК Касса,
		|	ТокеныДляОнлайнКасс.Токен КАК Токен,
		|	ТокеныДляОнлайнКасс.ДатаСоздания КАК ДатаСоздания
		|ИЗ
		|	РегистрСведений.ТокеныДляОнлайнКасс КАК ТокеныДляОнлайнКасс
		|ГДЕ
		|	ТокеныДляОнлайнКасс.Касса = &Касса";
	
	Запрос.УстановитьПараметр("Касса", Касса);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Если ТекущаяДата() - ВыборкаДетальныеЗаписи.ДатаСоздания > 23*60*60 Тогда
			//надо получить новый токен
			Токен = "";
		Иначе	
			// Берем токен из регистра
			Токен = ВыборкаДетальныеЗаписи.Токен;	
		КонецЕсли;
	Иначе
		//Надо получить новый токен
		Токен = "";
	КонецЕсли;
	
	АдресСайта = Константы.НВД_АдресСервисаСБПКассы.Получить();
	КодГруппы = Константы.НВД_КодГруппыДляКассыСБП.Получить(); 
	Логин = Константы.НВД_ЛогинДляКассыСБП.Получить();
	Пароль = Константы.НВД_ПарольСБПДляКассыСБП.Получить();
	ЭлПочтаОрганизации = Константы.НВД_ЭлПочтаДляСБПКассы.Получить();	
	СайтОрганизации = Константы.НВД_АдресСайтаДляСБПКассы.Получить();
	
	Если НЕ ЗначениеЗаполнено(АдресСайта) Тогда
		АдресСайта = "https://online.atol.ru";
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(КодГруппы) Тогда
		КодГруппы = "v4-online-atol-ru_4179";
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Логин) Тогда
		Логин = "v4-online-atol-ru";
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Пароль) Тогда
		Пароль = "iGFFuihss";
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ТекстЗапроса");
	Результат.Вставить("ТекстСообщения");
	ИмяСервера = СтрЗаменить(АдресСайта,"https://","");
	ИмяСервера = СтрЗаменить(ИмяСервера,"/","");
	Результат.Вставить("ИмяСервера",ИмяСервера);
	Результат.Вставить("Схема","https");
	Результат.Вставить("Порт");
	Результат.Вставить("Прокси",ПолучениеФайловИзИнтернета.ПолучитьПрокси(Результат.Схема));
	Результат.Вставить("ЗащищенноеСоединение", Истина);
	Результат.Вставить("ОтветСервера");
	Результат.Вставить("Соединение");
	Результат.Вставить("ТелоЗапроса");
	Результат.Вставить("GUID_1С");
	Результат.Вставить("uuid_Атол");
	Результат.Вставить("Операция");
	Результат.Вставить("МетодЗапроса");
	Результат.Вставить("Токен", Токен);
	Результат.Вставить("ТокенДатаСоздания");
	Результат.Вставить("КодГруппы", КодГруппы);
	Результат.Вставить("Логин", Логин);
	Результат.Вставить("Пароль", Пароль);
	Результат.Вставить("Касса", Касса);
	Результат.Вставить("ЭлПочтаОрганизации", ЭлПочтаОрганизации); 
	Результат.Вставить("СайтОрганизации", СайтОрганизации); 
	Результат.Вставить("СпособРасчета");
	Результат.Вставить("ПредметРасчета");
	Результат.Вставить("ВидОплаты", 0);
	Результат.Вставить("ТелефонКлиентаСБП");
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьОтветССайта(ПараметрыРаботы)

	ПараметрыРаботы.ТекстСообщения = "";
	ПараметрыРаботы.ОтветСервера = "";
	
	СоединениеССервером(ПараметрыРаботы);
	
	Если ПараметрыРаботы.Соединение = Неопределено Тогда
		ДобавитьОписаниеОшибки(ПараметрыРаботы, НСтр("ru = 'Ошибка при установке соединения с сайтом.'"));
		Возврат Ложь;
	КонецЕсли;
	
	ЗаголовокHTTP = Новый Соответствие();
	ЗаголовокHTTP.Вставить("Content-type","application/json");
	ЗаголовокHTTP.Вставить("charset","utf-8");
	Если ЗначениеЗаполнено(ПараметрыРаботы.Токен) Тогда
		ЗаголовокHTTP.Вставить("Token",ПараметрыРаботы.Токен);
	КонецЕсли;
	Если ЗначениеЗаполнено(ПараметрыРаботы.Операция) Тогда
		ЗаголовокHTTP.Вставить("operation",ПараметрыРаботы.Операция);
	КонецЕсли;
	Если ЗначениеЗаполнено(ПараметрыРаботы.КодГруппы) Тогда
		ЗаголовокHTTP.Вставить("group_code",ПараметрыРаботы.КодГруппы);
	КонецЕсли;
	ЗаголовокHTTP.Вставить("api_version","v4");
	Если ЗначениеЗаполнено(ПараметрыРаботы.uuid_Атол) Тогда
		ЗаголовокHTTP.Вставить("uuid",ПараметрыРаботы.uuid_Атол);
	КонецЕсли;
	
	HTTPЗапрос = Новый HTTPЗапрос(ПараметрыРаботы.ТекстЗапроса, ЗаголовокHTTP);
	
	Если ЗначениеЗаполнено(ПараметрыРаботы.ТелоЗапроса) Тогда
		HTTPЗапрос.УстановитьТелоИзСтроки(ПараметрыРаботы.ТелоЗапроса);
	КонецЕсли;
	
	Попытка
		Если ПараметрыРаботы.МетодЗапроса = "GET" Тогда
			HTTPОтветСервера = ПараметрыРаботы.Соединение.Получить(HTTPЗапрос);
		ИначеЕсли ПараметрыРаботы.МетодЗапроса = "PUT" Тогда
			HTTPОтветСервера = ПараметрыРаботы.Соединение.Записать(HTTPЗапрос);
		ИначеЕсли ПараметрыРаботы.МетодЗапроса = "POST" Тогда
			HTTPОтветСервера = ПараметрыРаботы.Соединение.ОтправитьДляОбработки(HTTPЗапрос);
		Иначе	
			HTTPОтветСервера = ПараметрыРаботы.Соединение.ОтправитьДляОбработки(HTTPЗапрос);
		КонецЕсли;
	Исключение
		
		ДобавитьОписаниеОшибки(ПараметрыРаботы,
			ОписаниеИсключительнойОшибки(
			НСтр("ru = 'Не удалось получить данные с сайта. 
				|Проверьте правильность адреса сервера, порт,'")
				+ Символы.ПС
				+ НСтр("ru = 'а также настройки подключения к Интернет.'")));
		
		Возврат Неопределено;
	
	КонецПопытки;
	
	КодСостояния = HTTPОтветСервера.КодСостояния;
	РасшифровкаКодаСостояния = РасшифровкаКодаСостоянияHTTP(КодСостояния);
	
	ОтветСервера = HTTPОтветСервера.ПолучитьТелоКакСтроку();
	
	Успешно = Истина;
	Если НЕ ЗначениеЗаполнено(ОтветСервера) Тогда
		Успешно = Ложь;
	КонецЕсли;
	
	ПараметрыРаботы.ОтветСервера = ОтветСервера;
	
	Если КодСостояния <> 200 Тогда
		ДобавитьОписаниеОшибки(ПараметрыРаботы, НСтр("ru = 'Ошибка получения ответа с сайта. Код ответа: '") + КодСостояния + " причина: " + РасшифровкаКодаСостояния + " ответ:" + ОтветСервера);
		Возврат Успешно;
	КонецЕсли;
		
	Если КодСостояния = 200 Тогда
		ДобавитьОписаниеОшибки(ПараметрыРаботы, НСтр("ru = 'Ошибка получения ответа с сайта. Код ответа: '") + КодСостояния + " причина: " + РасшифровкаКодаСостояния + " ответ:" + ОтветСервера);
		Возврат Успешно;
	КонецЕсли;
	
	Если Успешно = Ложь Тогда
		ДобавитьОписаниеОшибки(ПараметрыРаботы, НСтр("ru = 'Не удалось получить ответ сайта.'")) ;
	КонецЕсли;

	Возврат Успешно;
	
КонецФункции

Процедура СоединениеССервером(ПараметрыРаботы)
	
	Соединение = Неопределено;
	
	Попытка
		
		ssl = ?(ПараметрыРаботы.ЗащищенноеСоединение, Новый ЗащищенноеСоединениеOpenSSL(), Неопределено);
			
		Соединение = Новый HTTPСоединение(
			ПараметрыРаботы.ИмяСервера,
			ПараметрыРаботы.Порт,
			ПараметрыРаботы.Логин,
			ПараметрыРаботы.Пароль,
			ПараметрыРаботы.Прокси,
			1800,
			ssl
		);
		
	Исключение
		
		ПараметрыРаботы.ОписаниеОшибки = ОписаниеИсключительнойОшибки(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Не удалось установить соединение с сервером %1:%2. Проверьте правильность адреса сервера, порт, имя пользователя и пароль.'"),
					ПараметрыРаботы.ИмяСервера,
					ПараметрыРаботы.Порт));
		Соединение = Неопределено;
			
	КонецПопытки;
	
	ПараметрыРаботы.Соединение = Соединение; 
	
КонецПроцедуры

Функция РасшифровкаКодаСостоянияHTTP(КодСостояния)
	
	Если КодСостояния = 304 Тогда // Not Modified
		Расшифровка = НСтр("ru = 'Нет необходимости повторно передавать запрошенные ресурсы.'");
	ИначеЕсли КодСостояния = 400 Тогда // Bad Request
		Расшифровка = НСтр("ru = 'Запрос не может быть исполнен.'");
	ИначеЕсли КодСостояния = 401 Тогда // Unauthorized
		Расшифровка = НСтр("ru = 'Попытка авторизации на сервере была отклонена.'");
	ИначеЕсли КодСостояния = 402 Тогда // Payment Required
		Расшифровка = НСтр("ru = 'Требуется оплата.'");
	ИначеЕсли КодСостояния = 403 Тогда // Forbidden
		Расшифровка = НСтр("ru = 'К запрашиваемому ресурсу нет доступа.'");
	ИначеЕсли КодСостояния = 404 Тогда // Not Found
		Расшифровка = НСтр("ru = 'Запрашиваемый ресурс не существует на сервере.'");
	ИначеЕсли КодСостояния = 405 Тогда // Method Not Allowed
		Расшифровка = НСтр("ru = 'Метод запроса не поддерживается сервером.'");
	ИначеЕсли КодСостояния = 406 Тогда // Not Acceptable
		Расшифровка = НСтр("ru = 'Запрошенный формат данных не поддерживается сервером.'");
	ИначеЕсли КодСостояния = 407 Тогда // Proxy Authentication Required
		Расшифровка = НСтр("ru = 'Ошибка аутентификации на прокси-сервере'");
	ИначеЕсли КодСостояния = 408 Тогда // Request Timeout
		Расшифровка = НСтр("ru = 'Время ожидания сервером передачи от клиента истекло.'");
	ИначеЕсли КодСостояния = 409 Тогда // Conflict
		Расшифровка = НСтр("ru = 'Запрос не может быть выполнен из-за конфликтного обращения к ресурсу.'");
	ИначеЕсли КодСостояния = 410 Тогда // Gone
		Расшифровка = НСтр("ru = 'Ресурс на сервере был перемещен.'");
	ИначеЕсли КодСостояния = 411 Тогда // Length Required
		Расшифровка = НСтр("ru = 'Сервер требует указание ""Content-length."" в заголовке запроса.'");
	ИначеЕсли КодСостояния = 412 Тогда // Precondition Failed
		Расшифровка = НСтр("ru = 'Запрос не применим к ресурсу'");
	ИначеЕсли КодСостояния = 413 Тогда // Request Entity Too Large
		Расшифровка = НСтр("ru = 'Сервер отказывается обработать, слишком большой объем передаваемых данных.'");
	ИначеЕсли КодСостояния = 414 Тогда // Request-URL Too Long
		Расшифровка = НСтр("ru = 'Сервер отказывается обработать, слишком длинный URL.'");
	ИначеЕсли КодСостояния = 415 Тогда // Unsupported Media-Type
		Расшифровка = НСтр("ru = 'Сервер заметил, что часть запроса была сделана в неподдерживаемом формат'");
	ИначеЕсли КодСостояния = 416 Тогда // Requested Range Not Satisfiable
		Расшифровка = НСтр("ru = 'Часть запрашиваемого ресурса не может быть предоставлена'");
	ИначеЕсли КодСостояния = 417 Тогда // Expectation Failed
		Расшифровка = НСтр("ru = 'Сервер не может предоставить ответ на указанный запрос.'");
	ИначеЕсли КодСостояния = 429 Тогда // Too Many Requests
		Расшифровка = НСтр("ru = 'Слишком много запросов за короткое время.'");
	ИначеЕсли КодСостояния = 500 Тогда // Internal Server Error
		Расшифровка = НСтр("ru = 'Внутренняя ошибка сервера.'");
	ИначеЕсли КодСостояния = 501 Тогда // Not Implemented
		Расшифровка = НСтр("ru = 'Сервер не поддерживает метод запроса.'");
	ИначеЕсли КодСостояния = 502 Тогда // Bad Gateway
		Расшифровка = НСтр("ru = 'Сервер, выступая в роли шлюза или прокси-сервера, 
		                         |получил недействительное ответное сообщение от вышестоящего сервера.'");
	ИначеЕсли КодСостояния = 503 Тогда // Server Unavailable
		Расшифровка = НСтр("ru = 'Сервер временно не доступен.'");
	ИначеЕсли КодСостояния = 504 Тогда // Gateway Timeout
		Расшифровка = НСтр("ru = 'Сервер в роли шлюза или прокси-сервера 
		                         |не дождался ответа от вышестоящего сервера для завершения текущего запроса.'");
	ИначеЕсли КодСостояния = 505 Тогда // HTTP Version Not Supported
		Расшифровка = НСтр("ru = 'Сервер не поддерживает указанную в запросе версию протокола HTTP'");
	ИначеЕсли КодСостояния = 506 Тогда // Variant Also Negotiates
		Расшифровка = НСтр("ru = 'Сервер настроен некорректно, и не способен обработать запрос.'");
	ИначеЕсли КодСостояния = 507 Тогда // Insufficient Storage
		Расшифровка = НСтр("ru = 'На сервере недостаточно места для выполнения запроса.'");
	ИначеЕсли КодСостояния = 509 Тогда // Bandwidth Limit Exceeded
		Расшифровка = НСтр("ru = 'Сервер превысил отведенное ограничение на потребление трафика.'");
	ИначеЕсли КодСостояния = 510 Тогда // Not Extended
		Расшифровка = НСтр("ru = 'Сервер требует больше информации о совершаемом запросе.'");
	ИначеЕсли КодСостояния = 511 Тогда // Network Authentication Required
		Расшифровка = НСтр("ru = 'Требуется авторизация на сервере.'");
	Иначе 
		Расшифровка = НСтр("ru = '<Неизвестный код состояния>.'");
	КонецЕсли;
	
	Возврат СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = '[%1] %2'"), 
		КодСостояния, 
		Расшифровка);
	
КонецФункции

Функция ОписаниеИсключительнойОшибки(ТекстНачалаСообщения = "", ТекстОкончанияСообщения = "")
	
	ПодробноеПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	
	ТекстСообщения = НСтр("ru = 'Произошла ошибка:'")
		+ " " + ТекстНачалаСообщения
		+ ?(ПустаяСтрока(ТекстОкончанияСообщения), "", Символы.ПС + ТекстОкончанияСообщения)
		+ ?(ПустаяСтрока(ПодробноеПредставлениеОшибки), "", Символы.ПС + ПодробноеПредставлениеОшибки);
		
	Возврат ТекстСообщения;
	
КонецФункции

Процедура ДобавитьОписаниеОшибки(ПараметрыПолучения, Дополнение)

	Если ПустаяСтрока(ПараметрыПолучения.ТекстСообщения) Тогда
		ПараметрыПолучения.ТекстСообщения = Дополнение;
	Иначе
		ПараметрыПолучения.ТекстСообщения = ПараметрыПолучения.ТекстСообщения + Символы.ПС + Дополнение;
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьПараметрыПодключенияКОнЛайнКассе()
	
	ПараметрыРаботы = НовыеПараметрыЗапросаДляОнЛайнКассы();
 
	ПараметрыРаботы.ТекстЗапроса = "possystem/v4/getToken?login=" + ПараметрыРаботы.Логин + "&pass=" + ПараметрыРаботы.Пароль ;
	ПараметрыРаботы.МетодЗапроса = "GET";
	
	Если ЗначениеЗаполнено(ПараметрыРаботы.Токен) Тогда
		Возврат ПараметрыРаботы;
	КонецЕсли;
	
	ОтветПолучен = ПолучитьОтветССайта(ПараметрыРаботы);
	Если ОтветПолучен = Ложь или Не ЗначениеЗаполнено(ПараметрыРаботы.ОтветСервера) Тогда
		ДобавитьОписаниеОшибки(ПараметрыРаботы, НСтр("ru = 'Токен не получен.'"));
		ТекстСообщения = ПараметрыРаботы.ТекстСообщения;
		Возврат "";
	КонецЕсли;
	
	ТокенПолучен = Ложь;
	
	JSON = Новый ЧтениеJSON();
	JSON.УстановитьСтроку(ПараметрыРаботы.ОтветСервера);
	
	Успешно = Истина;
	
	Попытка
		Результат = ПрочитатьJSON(JSON);
	Исключение
		Успешно = Ложь;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не смогли прочитать ответ JSON с сайта " + ОписаниеОшибки();
		Сообщение.Сообщить();
		ТекстСообщения = "";
	КонецПопытки;
	
	Если Успешно и ТипЗнч(Результат) = Тип("Структура") Тогда
		//error		Неопределено
		//timestamp	"15.08.2023 19:58:27"	Строка
		//token	"ieh3KpTZmrBta7nhoVPduZz_VdY30ndPlWfOkbD-Z0w-nujYoAcW3N2aBCdxm_O4y16bYF_YFNy9ooU11CDrMuve3MEZtDnFb8mIBoNrCdw5AjHzJXgy_dmK_EJSFQ7Z"	Строка
		Если Результат.Свойство("error") Тогда
			Если Результат.error <> Неопределено Тогда
				ДобавитьОписаниеОшибки(ПараметрыРаботы, НСтр("ru = 'Токен не получен.'")
				+ Символы.ПС 
				+ ПараметрыРаботы.ОтветСервера);
			Иначе
				Если Результат.Свойство("token") Тогда
					Токен = Результат.token;
					Если СтрДлина(Токен)  > 20 Тогда
						ТокенПолучен = Истина;
						ПараметрыРаботы.Токен = Токен;
					КонецЕсли;
				КонецЕсли;
				Если Результат.Свойство("timestamp") Тогда
					ТокенВремя = Результат.timestamp;
					ТокенДействуетДо = ТокенВремя +  + 86400;
					ПараметрыРаботы.ТокенДатаСоздания = Дата(Результат.timestamp);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		ТекстСообщения = ПараметрыРаботы.ТекстСообщения;
	КонецЕсли;
	Если ЗначениеЗаполнено(ПараметрыРаботы.Токен) И ЗначениеЗаполнено(ПараметрыРаботы.ТокенДатаСоздания) Тогда
		НаборЗаписейТокеновДляОнЛайнКасс = РегистрыСведений.ТокеныДляОнлайнКасс.СоздатьНаборЗаписей();
		НаборЗаписейТокеновДляОнЛайнКасс.Отбор.Касса.Установить(ПараметрыРаботы.Касса); 
		НаборЗаписейТокеновДляОнЛайнКасс.Прочитать();
		Если НаборЗаписейТокеновДляОнЛайнКасс.Количество() = 0 Тогда
    		НовыйТокен = НаборЗаписейТокеновДляОнЛайнКасс.Добавить();
    		НовыйТокен.Касса = ПараметрыРаботы.Касса;
    		НовыйТокен.ДатаСоздания = ПараметрыРаботы.ТокенДатаСоздания; 
			НовыйТокен.Токен = ПараметрыРаботы.Токен;
		Иначе
   		 	НовыйТокен = НаборЗаписейТокеновДляОнЛайнКасс[0];
			НовыйТокен.Касса = ПараметрыРаботы.Касса;
    		НовыйТокен.ДатаСоздания = ПараметрыРаботы.ТокенДатаСоздания;
			НовыйТокен.Токен = ПараметрыРаботы.Токен;
		КонецЕсли; 
		НаборЗаписейТокеновДляОнЛайнКасс.Записать();
	КонецЕсли;
	
	Возврат ПараметрыРаботы;
	
КонецФункции	

