Процедура СоздатьЧекСПроверкойНаСуществующий(ДокументСсылка, ТипОперации) Экспорт
	
	ТекстСообщения = "";
	НадоСоздавать = Ложь;
	ПроверитьЧек(ДокументСсылка, ТекстСообщения, НадоСоздавать, ТипОперации);
	Если НадоСоздавать Тогда
		СоздатьЧек(ДокументСсылка, ТекстСообщения, ТипОперации);
	КонецЕсли;
	
КонецПроцедуры	

Процедура ПолучитьGUIDСсылки(ПараметрыРаботы, ДокСсылка)
	
	ТипОперации =ПараметрыРаботы.ТипОперации;
	
	Если ТипОперации = "" или ТипОперации = "Приход" Тогда
		ПараметрыРаботы.GUID_1С = Строка(ДокСсылка.УникальныйИдентификатор());
	ИначеЕсли ТипОперации = "Возврат прихода" Тогда
		UUID_1С_Возврат = ДокСсылка.UUID_1С_Возврат;
		Если ПустаяСтрока(UUID_1С_Возврат) Тогда
			UUID_1С_Возврат = Строка(Новый УникальныйИдентификатор);
		КонецЕсли;
		ПараметрыРаботы.GUID_1С = UUID_1С_Возврат;
		Попытка
			ВписатьВДокументЗначение(ДокСсылка, "uuid_Атол", UUID_1С_Возврат);
		Исключение
			ДобавитьОписаниеОшибки(ПараметрыРаботы, НСтр("ru = 'Не удалось записать документ.'")
			+ Символы.ПС + ДокСсылка + Символы.ПС 
			+ ПараметрыРаботы.ОтветСервера);
		КонецПопытки;		
	ИначеЕсли ТипОперации = "Коррекция прихода" Тогда
		UUID_1С_Корректирующий = ДокСсылка.UUID_1С_Корректирующий;
		Если ПустаяСтрока(UUID_1С_Корректирующий) Тогда
			UUID_1С_Корректирующий = Строка(Новый УникальныйИдентификатор);
		КонецЕсли;
		ПараметрыРаботы.GUID_1С = UUID_1С_Корректирующий;
		Попытка
			ВписатьВДокументЗначение(ДокСсылка, "uuid_Атол", UUID_1С_Корректирующий);
		Исключение
			ДобавитьОписаниеОшибки(ПараметрыРаботы, НСтр("ru = 'Не удалось записать документ.'")
			+ Символы.ПС + ДокСсылка + Символы.ПС 
			+ ПараметрыРаботы.ОтветСервера);
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

