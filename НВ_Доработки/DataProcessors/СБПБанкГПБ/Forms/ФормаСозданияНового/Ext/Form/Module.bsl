Процедура ПолучитьQRКод(Команда)
	//ПолучитьQRКодНаСервере();
    Если ПараметрыДляСБПЗаполнены() Тогда
		СтруктураQRВзноса = РегистрацияInvoiceМетки(); 
		
		Если СтруктураQRВзноса.Результат Тогда
			content       = СтруктураQRВзноса.content;
			Объект.payload = СтруктураQRВзноса.payload;
			Объект.qrcId = СтруктураQRВзноса.QRCID;
			//Записать();
			
			//записать qr код в регистр сведений
			
			ДД = Base64Значение(content);
			Картинка = Новый Картинка(ДД, Ложь);
			СсылкаНаКартинку = ПоместитьВоВременноеХранилище(Картинка, Новый УникальныйИдентификатор);
			//ПоместитьВОбъектНаСервере(content);
			ЗаписатьQRКодВРегистр(СтруктураQRВзноса);
			ЭтаФорма.ОбновитьОтображениеДанных();
