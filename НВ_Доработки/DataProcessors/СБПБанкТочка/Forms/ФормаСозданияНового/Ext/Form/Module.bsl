&НаСервере
Процедура ПолучитьQRКодНаСервере()
	Обработка = РеквизитФормыВЗначение("Объект");
	Данные = Обработка.ПолучитьQRКодПоЗаказу(Объект.Заказ);
	Если Данные.Свойство("QRКод") Тогда
		Объект.Статус                = Данные.QRКод.Статус;
		Объект.ДатаГенерации         = Данные.QRКод.ДатаГенерации;
		Объект.imageParams_width     = Данные.QRКод.imageParams_width;
		Объект.imageParams_height    = Данные.QRКод.imageParams_height;
		Объект.imageParams_mediaType = Данные.QRКод.imageParams_mediaType;
		ДД = Base64Значение(Данные.QRКод.imageParams_content);
		СсылкаНаКартинку = ПоместитьВоВременноеХранилище(Новый Картинка(ДД, Ложь), УникальныйИдентификатор);
		Объект.imageParams_content   = Данные.QRКод.imageParams_content;
		Объект.payload               = Данные.QRКод.payload;
		Объект.qrcType               = Данные.QRКод.qrcType;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьQRКод(Команда)
	//сумма ссылки ограничена константой "Максимальная сумма в ссылке СБП",
	//если у пользователя нет права создавать ссылки сверх неё
	ПроверкаЛимита = НВД_ОбщийМодульСервер.ПроверитьЛимитСуммыСсылкиСБП(Объект.Заказ, Объект.Сумма);
	Если НЕ ПроверкаЛимита.Разрешено Тогда
		ПоказатьПредупреждение(, ПроверкаЛимита.ТекстОтказа);
		Возврат;
	КонецЕсли;
	
	ПолучитьQRКодНаСервере();

	// для обновления Реквизитов
	//ЭтаФорма.Прочитать();
	//ОповеститьОбИзменении
	// Обновление данных
	ЭтаФорма.ОбновитьОтображениеДанных();
КонецПроцедуры
