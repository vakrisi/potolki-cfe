Функция СоздатьДокументПоступлениеНаРС(ДанныеПлатежа)
	
	Если ТипЗнч(ДанныеПлатежа) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	qrcId  = ДанныеПлатежа.qrcId;
	
	Если НЕ ЗначениеЗаполнено(qrcId) Тогда
		Возврат Неопределено;
	КонецЕсли; 
	
	Заказ = ДанныеПлатежа.Заказ;
	
	Если НЕ ЗначениеЗаполнено(Заказ) Тогда
		НайденЗаказ = ЛОЖЬ;
	Иначе
		НайденЗаказ = ИСТИНА;
	КонецЕсли;
	
	Если Не НайденЗаказ Тогда
		Текст = "Данный QR код не привязан к заказу" + qrcId + ", не возможно создать документ оплаты";
		ЗаписьЖурналаРегистрации(Текст, УровеньЖурналаРегистрации.Ошибка);	
		Возврат Неопределено;
	КонецЕсли;
	
	Если СтрНайти(ВРЕГ(ДанныеПлатежа.status), "ACCEPTED") = 0 Тогда
		Текст = "Данный QR код " + qrcId + " в статусе" + ДанныеПлатежа.status + ", не возможно создать документ оплаты";
		ЗаписьЖурналаРегистрации(Текст, УровеньЖурналаРегистрации.Ошибка);	
		Возврат Неопределено;
	КонецЕсли;
	
	Если НайденЗаказ Тогда
		Контрагент = Заказ.Контрагент;
	КонецЕсли;	
	
	СчетДляСБП = Константы.НВД_ОсновнойБанковскийСчетДляСБП.Получить();
	
	Если НЕ ЗначениеЗаполнено(СчетДляСБП) Тогда
		Возврат Неопределено;
	КонецЕсли; 
	
	СуммаПлатежа = ДанныеПлатежа.amount;  //в рублях
	
	Если НЕ ЗначениеЗаполнено(СуммаПлатежа) Тогда
		Текст = "У данный QR кода " + qrcId + " не указана сумма платежа, не возможно создать документ оплаты";
		ЗаписьЖурналаРегистрации(Текст, УровеньЖурналаРегистрации.Ошибка);
		Возврат Неопределено;
	КонецЕсли;
	
	//merchantId = ДанныеПлатежа.merchantId;
	
	Валюта = СчетДляСБП.Валюта;
	
	ДатаПлатежа = ТекущаяДата();
	
	//БанковскийСчетОтправителя = ДанныеПлатежа.
	Организация = Константы.НВД_ОсновнаяОрганизацияДляСБП.Получить();
	
	ПоступлениеНаРС = Документы.ПоступлениеНаРасчетныйСчет.СоздатьДокумент();
	ПоступлениеНаРС.Дата = ДатаПлатежа;
	Если НайденЗаказ Тогда
		ПоступлениеНаРС.ДобавитьОснование(Заказ);
	КонецЕсли;
	ПоступлениеНаРС.Организация = Организация;
	ПоступлениеНаРС.Валюта = Валюта;
	ПоступлениеНаРС.ВидОперации = Перечисления.ВидыОперацийПоступлениеНаРасчетныйСчет.ОплатаОтПокупателя;	
	ПоступлениеНаРС.Контрагент = Контрагент;
	ПоступлениеНаРС.Договор = Контрагент.ОсновнойДоговор;
	//ПоступлениеНаРС.КомиссияБанка = Число(ДанныеПлатежа.commissionPercent)*СуммаПлатежа/100; 
	//ПоступлениеНаРС.СтатьяРасходов = Справочники.СтатьиДоходовИРасходов.ПрочиеРасходы;
	ПоступлениеНаРС.НазначениеПлатежа = ДанныеПлатежа.paymentPurpose;
	ПоступлениеНаРС.Комментарий = "Загружен из Банка " + "qrcId:" + ДанныеПлатежа.qrcId; 
	ПоступлениеНаРС.Подразделение = Справочники.Подразделения.НайтиПоНаименованию("Основной");
	ПоступлениеНаРС.СтатьяДоходов = Справочники.СтатьиДоходовИРасходов.Продажи; 
	ПоступлениеНаРС.СтатьяДоходовПоНачислению = Справочники.СтатьиДоходовИРасходов.Продажи;
	ПоступлениеНаРС.Сумма = СуммаПлатежа;
	ПоступлениеНаРС.Счет = СчетДляСБП; 
	ПоступлениеНаРС.Автор = Пользователи.ТекущийПользователь();
	ПоступлениеНаРС.ТипПлатежногоДокумента = Перечисления.ТипыПлатежныхДокументов.ПлатежноеПоручение;
	ПоступлениеНаРС.СтавкаНДС = УчетНДС.СтавкаНДСПоУмолчанию(Организация);
	УчитыватьНДС = УчетНДС.ОрганизацияЯвляетсяПлательщикомНДС(Организация);
	ФинансыКлиентСервер.ПересчитатьСуммуНДС(ПоступлениеНаРС, УчитыватьНДС); 
	ПоступлениеНаРС.СозданПриИспользованииПодразделений = ИСТИНА;
	ПоступлениеНаРС.Подразделение = Заказ.Подразделение;
	
	ЗаполнитьПоЗаказуПокупателя(ПоступлениеНаРС, Заказ);
	
	СтрокиРаспределения = ОбщегоНазначения.ТаблицаЗначенийВМассив(ПоступлениеНаРС.РаспределениеПлатежа.Выгрузить());
	Если СтрокиРаспределения.Количество() > 0 Тогда
		
		ОбработкаТабличныхЧастейВызовСервера.РаспределитьСуммуОплатыПоДокументам(СтрокиРаспределения, ПоступлениеНаРС.Сумма, ПоступлениеНаРС.Дата, ПоступлениеНаРС.Валюта);
	
		Для каждого ДанныеСтроки из СтрокиРаспределения Цикл
			ЗаполнитьЗначенияСвойств(ПоступлениеНаРС["РаспределениеПлатежа"][ДанныеСтроки.НомерСтроки - 1], ДанныеСтроки);
		КонецЦикла;

	Конецесли;
	
	////Изменим способ Платежа в заказе
	//НовыйСпособПлатежа = Справочники.СпособыОплатыЗаказа.QRкод;
	//НадоИзменитьСпособПлатежаВЗаказе = Ложь;
	//Если Заказ.СпособОплаты <> НовыйСпособПлатежа Тогда
	//	НадоИзменитьСпособПлатежаВЗаказе = Истина;
	//	ЗаказОбъект = Заказ.ПолучитьОбъект();
	//	ЗаказОбъект.СпособОплаты = НовыйСпособПлатежа;
	//КонецЕсли;

	Попытка
		ПоступлениеНаРС.Записать(РежимЗаписиДокумента.Проведение); 

		//Если НадоИзменитьСпособПлатежаВЗаказе Тогда
		//	ЗаказОбъект.Записать();
		//КонецЕсли;
		
		Возврат ПоступлениеНаРС.Ссылка;
		
	Исключение
		Инфо1 = ОписаниеОшибки();
		Инфо2 = ИнформацияОбОшибке();
		
		Инфо = Инфо1 + "
		|" + Инфо2.Описание + "
		|" + ?(Инфо2.Причина = Неопределено, "", Инфо2.Причина.Описание);
		
		ЗаписьЖурналаРегистрации("Запись документа оплаты по Call Back GPB", УровеньЖурналаРегистрации.Ошибка,,,Инфо);
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

Процедура ЗаполнитьПоЗаказуПокупателя(ПоступлениеНаРС, ДанныеЗаполнения)
	
	МассивДокументов = Новый Массив;
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		МассивДокументов.Добавить(ДанныеЗаполнения);		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("Массив") Тогда
		МассивДокументов = ДанныеЗаполнения;
	Иначе
		Возврат;
	КонецЕсли;
	
	Документы.ЗаказПокупателя.ПроверитьВозможностьВводаНаОснованииЗаказа(МассивДокументов);
	
	Контрагент 		= МассивДокументов[0].Контрагент;
	Договор 		= МассивДокументов[0].ДоговорКонтрагента;
	Организация 	= МассивДокументов[0].Организация;
	Подразделение 	= МассивДокументов[0].Подразделение; //#5775 	
	Валюта 			= МассивДокументов[0].Валюта; //#7373
	
	ДобавлятьЗаказыВторогоПорядкаВРаспределение = НЕ Константы.НеДобавлятьЗаказыВторогоПорядкаВРаспределение.Получить();
	ДобавлятьДокументыПродажиПоЗаказам = ПолучитьФункциональнуюОпцию("ДобавлятьДокументПродажиПоЗаказуПриДобавленииЗаказаВРаспределение")
	И Константы.ВестиРасчетыПоЗаказамПоРТиУ.Получить();
	Для каждого ЭлементМассива из МассивДокументов Цикл
		Если Контрагент <> ЭлементМассива.Контрагент Тогда
			Текст = НСтр("ru = 'Контрагенты в выделенных документах различаются, создание документа невозможно'");			
			ВызватьИсключение Текст;
		КонецЕсли;
		
		ДобавитьОснование(ПоступлениеНаРС, ЭлементМассива);
		
		НоваяСтрока = ПоступлениеНаРС.РаспределениеПлатежа.Добавить();
		НоваяСтрока.Документ = ЭлементМассива;
		НоваяСтрока.Сумма = РегистрыНакопления.РасчетыПоЗаказам.ПолучитьОстатокДолгаПоЗаказу(НоваяСтрока.Документ); //ЭлементМассива.СуммаДокумента;				
		НоваяСтрока.СуммаВВалютеДокумента = НоваяСтрока.Сумма;
		Если ДобавлятьЗаказыВторогоПорядкаВРаспределение Тогда
			ФинансыСервер.ДобавитьОснованиеЗаказаВРаспределениеПлатежа(ЭлементМассива, ПоступлениеНаРС.РаспределениеПлатежа, Сумма);
		КонецЕсли;
	КонецЦикла;
	
	Сумма = ПоступлениеНаРС.РаспределениеПлатежа.Итог("Сумма");
	
	//#7709 
	//после определения суммы документа
	Если ДобавлятьДокументыПродажиПоЗаказам Тогда
		Для каждого ЭлементМассива из МассивДокументов Цикл
			ФинансыСервер.ДобавитьДокументыПродажиПоЗаказам(ПоступлениеНаРС, ЭлементМассива);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьОснование(ПоступлениеНаРС, ДанныеЗаполнения) Экспорт
	
	НайденныеСтроки = ПоступлениеНаРС.Основания.НайтиСтроки(Новый Структура("Основание", ДанныеЗаполнения));
	Если  НайденныеСтроки.Количество() = 0 Тогда
		НоваяСтрока = ПоступлениеНаРС.Основания.Добавить();
		НоваяСтрока.Основание = ДанныеЗаполнения;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьЗаказПоНомеру(лТекстПлатежа)
	
	
	ТекстПлатежа = лТекстПлатежа;
	
	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, "№", " ");
	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, "СЧ.", " ");
	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, "#", " ");      
	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, "НОМЕР", " ");
	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, "No", " ");
	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, "NО", " ");
	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, "NO", " ");      
	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, "NO", " ");
	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, ",", " ");
	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, ";", " ");
	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, "ОТ", " ");
	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, "N", " ");
	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, "P300-",  "Р300-");
	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, "РЗ00-",  "Р300-");
	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, "Р-300-", "Р300-");     
	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, "Р 300-", "Р300-");
	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, "P 300-", "Р300-");
	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, " 300-",  " Р300-");
	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, "Р600-",  "Р600-");
	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, "P600-",  "Р600-");
	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, "Р-600-", "Р600-");     
	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, "Р 600-", "Р600-");
	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, "P 600-", "Р600-");
	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, " 600-",  " Р600-"); 
	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, "P600-",  "Р600-");
	
	//Если СтрНайти(ТекстПлатежа, "300-") > 0 И СтрНайти(ТекстПлатежа, "Р") = 0 Тогда 
	//	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, "300-",  " Р300-");	
	//КонецЕсли;	
	
	НомерЗаказа = "";
	
	Если СтрЧислоВхождений(ТекстПлатежа, "@") = 2 Тогда  //Сначала ищем заказ между собачками
		
		МасСлов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекстПлатежа, "@");  		
		
		Если МасСлов.Количество() = 3 Тогда
			НомерЗаказа = СтроковыеФункцииКлиентСервер.ДополнитьСтроку(МасСлов[1], 11, "0");	
		КонецЕсли;
		
	КонецЕсли;   	
	
	СсылкаНаСчет = "";
	лСчет = "";
	Если Не ЗначениеЗаполнено(НомерЗаказа) Тогда //ищем счет
		
		МасСлов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекстПлатежа, " ", Истина);
		
		Для Каждого Эл Из МасСлов Цикл
			
			ЭлОбр = СтрЗаменить(Эл, "@", "");
			Если СтрЧислоВхождений(ЭлОбр, ".") = 1 Тогда //даты становятся номерами документов
				ЭлОбр = СтрЗаменить(ЭлОбр, ".", "");  		
			КонецЕсли;
			Если СтрДлина(ЭлОбр) = 11 Тогда
				лСчет = Документы.СчетНаОплатуКлиенту.НайтиПоНомеру(ЭлОбр, ТекущаяДата());
			КонецЕсли;
			
			Если ЗначениеЗаполнено(лСчет) Тогда
				СсылкаНаСчет = лСчет;	
			КонецЕсли;	
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НомерЗаказа)
		И Не ЗначениеЗаполнено(СсылкаНаСчет) Тогда //  Потом ищем по первому номеру в тексте, который подходит под условия
		
		МасСлов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекстПлатежа, " ", Истина); 
		Для Каждого Эл Из МасСлов Цикл
			
			//ЭлОбр = СтрЗаменить(Эл, "@", "");
			//Если СтрЧислоВхождений(ЭлОбр, ".") = 1 Тогда //даты становятся номерами документов
			//	ЭлОбр = СтрЗаменить(ЭлОбр, ".", "");  		
			//КонецЕсли;
			Если СтрДлина(ЭлОбр) >= 5 И СтрДлина(ЭлОбр) <= 6 И СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(ЭлОбр, Истина, Ложь) Тогда
				НомерЗаказа = СтроковыеФункцииКлиентСервер.ДополнитьСтроку(ЭлОбр, 11, "0");
				Если ЗначениеЗаполнено(НомерЗаказа) Тогда
					Прервать;
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НомерЗаказа) Тогда
		СсылкаНаЗаказ = Документы.CRM_Событие.НайтиПоНомеру(НомерЗаказа);
	ИначеЕсли ЗначениеЗаполнено(СсылкаНаСчет) Тогда
		СсылкаНаЗаказ = СсылкаНаСчет.ДокументОснование;		
	иначе
		СсылкаНаЗаказ = Документы.CRM_Событие.ПустаяСсылка();	
	КонецЕсли;
	
	Возврат СсылкаНаЗаказ;
	
КонецФункции

Функция ПолучитьДатуИзСтроки(ДатаСтр)
	
	ДатаДокумента = Дата(Лев(ДатаСтр, 4), Сред(ДатаСтр, 6, 2), Сред(ДатаСтр, 9, 2), Сред(ДатаСтр, 12, 2), Сред(ДатаСтр, 15, 2), Сред(ДатаСтр, 18, 2));	
	
	Возврат ДатаДокумента;
	
КонецФункции

Функция ПолучитьКонтрагентаВладельца(лПартнер)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Контрагенты.Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.Партнер = &Партнер
	|	И Контрагенты.Партнер <> ЗНАЧЕНИЕ(Справочник.Партнеры.ПустаяСсылка)";	
	Запрос.УстановитьПараметр("Партнер", лПартнер);	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда	
		Возврат Выборка.Ссылка;
	Иначе	
		Возврат Справочники.Контрагенты.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции

