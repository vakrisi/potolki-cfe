		КлючиИзменены = Истина;
	ИначеЕсли СтарыйНаборКлючей.sbp_customerCode <> Данные.НаборКлючей.sbp_customerCode Тогда
		КлючиИзменены = Истина;
	КонецЕсли;
	
	Если КлючиИзменены Тогда
		УстановитьПривилегированныйРежим(Истина);
		ЗаписатьНовыйНаборКлючейСБП(Данные.НаборКлючей);
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	//Создадим документы ПоступлениеНаРС по тем QR которые в статусе Accepted и не создан документ поступлениена РС
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	*
	|ИЗ
	|	РегистрСведений.СБП_QRКоды КАК СБП_QRКоды
	|ГДЕ
	|	СБП_QRКоды.status = ""Accepted""
	|	И СБП_QRКоды.ПоступлениеНаРС = ЗНАЧЕНИЕ(Документ.ПоступлениеНаРасчетныйСчет.ПустаяСсылка)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаЗапроса =  РезультатЗапроса.Выбрать();
	
	Пока ВыборкаЗапроса.Следующий() Цикл 	 
		ДанныеQR = Новый Структура("qrcId, status, ДатаГенерации, amount, qrcType, Заказ, ПоступлениеНаРС, createdAt, commissionPercent, paymentPurpose");
		ЗаполнитьЗначенияСвойств(ДанныеQR, ВыборкаЗапроса);
		ПолучитьДанныеQRКодаИзБанка(Данные, ДанныеQR);
		
		//поменяем статус заказа
		Заказ = ДанныеQR.Заказ.Ссылка;
		Если Заказ.ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Отменен ИЛИ  
			Заказ.ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.Новый Тогда
			ЗаказОбъект = ДанныеQR.Заказ.Ссылка.ПолучитьОбъект();
			Попытка
				ЗаказОбъект.ТекущийСтатус = Справочники.СтатусыЗаказовПокупателей.ВРаботе;
				ЗаказОбъект.Записать(РежимЗаписиДокумента.Проведение); 	
			Исключение
				Инфо1 = ОписаниеОшибки();
				Инфо2 = ИнформацияОбОшибке();
				
				Инфо = Инфо1 + "
				|" + Инфо2.Описание + "
				|" + ?(Инфо2.Причина = Неопределено, "", Инфо2.Причина.Описание);
				
				ЗаписьЖурналаРегистрации("Изменение статуса документа Заказ покупателя, в связи с оплатой по QR", УровеньЖурналаРегистрации.Ошибка,,,Инфо);
			КонецПопытки;
		КонецЕсли; 
		
		//Создадим документ ПоступлениеНаРС
		ПоступлениеНаРС = СоздатьДокументПоступлениеНаРС(ДанныеQR);
		Если ЗначениеЗаполнено(ПоступлениеНаРС) Тогда
			//запишем в РС созданный документ 
			МенеджерЗаписи = РегистрыСведений.СБП_QRКоды.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.qrcId = ВыборкаЗапроса.qrcId;
			МенеджерЗаписи.Прочитать();
			Если МенеджерЗаписи.Выбран() Тогда
				ЗаполнитьЗначенияСвойств(МенеджерЗаписи, ВыборкаЗапроса);
				МенеджерЗаписи.ПоступлениеНаРС = ПоступлениеНаРС;
				МенеджерЗаписи.Записать();
			КонецЕсли;
			
			
			//пробьём чек на кассе Атолл-онлайн
			ОбработкаСБПКасса = Обработки.СБПКасса.Создать();
			ОбработкаСБПКасса.СоздатьЧекСПроверкойНаСуществующий(ПоступлениеНаРС.Ссылка, "Приход");
		КонецЕсли;	
	КонецЦикла; 
	
	
	//удаляем отработанные QR коды
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	*
	|ИЗ
	|	РегистрСведений.СБП_QRКоды КАК СБП_QRКоды
	|ГДЕ
	|	СБП_QRКоды.ДатаГенерации <= &КонтрольнаяДата";
	
	Запрос.УстановитьПараметр("КонтрольнаяДата", ТекущаяДата()-259200); //время жизни QR кода 72 часа, QR коды старше 72 часов удаляем
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаЗапроса =  РезультатЗапроса.Выбрать();
	
	Пока ВыборкаЗапроса.Следующий() Цикл 		
		Запись = РегистрыСведений.СБП_QRКоды.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись, ВыборкаЗапроса);
		Запись.Прочитать();
		Запись.Удалить();
	КонецЦикла;    
	
	
КонецФункции	

Функция ПолучитьQRКод(Данные) 
	
	ТекстС = "Запуск API Точка банк. Запрос QR - кода";
	//Сообщить(ТекстС);
	ЗаписьЖурналаРегистрации(ТекстС, УровеньЖурналаРегистрации.Информация);
	
	//Register Qr Code
	СтрокаЗапроса = Данные.НаборКлючей.sbp_type_service + "/sbp/v1.0/qr-code/merchant/" + Данные.НаборКлючей.sbp_merchant_id + "/" + Данные.НаборКлючей.sbp_account_code + "";	
	
	СтруктураimageParams = Новый Структура;
	СтруктураimageParams.Вставить("width", 200);
	СтруктураimageParams.Вставить("height", 200);
	СтруктураimageParams.Вставить("mediaType", "image/png");
	
	СтруктураData = Новый Структура;
	СтруктураData.Вставить("merchantId", Данные.НаборКлючей.sbp_merchant_id);
	СтруктураData.Вставить("legalId", Данные.НаборКлючей.sbp_legalId);
	СтруктураData.Вставить("customerCode", Данные.НаборКлючей.sbp_customerCode);
	СтруктураData.Вставить("amount", Сумма*100); //сумма в копейках!!!!
	СтруктураData.Вставить("currency", "RUB");
	СтруктураData.Вставить("paymentPurpose", "Оплата заказа №" + Данные.Заказ.Номер +" от " + Данные.Заказ.Дата + " УИД " + Данные.Заказ.Ссылка.УникальныйИдентификатор());
	СтруктураData.Вставить("qrcType", "02");
	СтруктураData.Вставить("imageParams", СтруктураimageParams);
	СтруктураData.Вставить("sourceName", "string");
	
	BodyParams = Новый Структура;
	BodyParams.Вставить("Data", СтруктураData);
	
	СтрокаJSON = СформироватьСтрокуJSONИзСтруктуры(BodyParams);
	
	HTTPОтвет = ПолучитьЗапрошенныйФайлPOST(СтрокаЗапроса, СтрокаJSON, , Данные.НаборКлючей.sbp_accesstoken_hybrid, Данные.НаборКлючей.sbp_account_code, Данные.НаборКлючей.sbp_url_service, Данные.НаборКлючей.sbp_port_service);
	
	//ОтветСтрокой = HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8");
	
	ОтветСтрокой = БОНД_Коннектор.КакТекст(HTTPОтвет);
	
	Текст = "Запрос Точка банк. Получение QR-кода. Код состояния: " + HTTPОтвет.КодСостояния + ". Входящая информация: " + ОтветСтрокой + "";
	
	Ответ = ОпределитьОтвет(HTTPОтвет, Текст, ОтветСтрокой);
	
	Если СтрНайти(ОтветСтрокой,"token is missing") > 0 Тогда //токен не рабочий, обновляем его
		
		Данные.НаборКлючей = ЗначениеИзСтрокиВнутр(ЗначениеВСтрокуВнутр(ОбновитьТокенAPIБанкТочка(Данные.НаборКлючей)));
		
		HTTPОтвет = ПолучитьЗапрошенныйФайлPOST(СтрокаЗапроса, СтрокаJSON, , Данные.НаборКлючей.sbp_accesstoken_hybrid, Данные.НаборКлючей.sbp_account_code, Данные.НаборКлючей.sbp_url_service, Данные.НаборКлючей.sbp_port_service);
		
		//ОтветСтрокой = HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8");
		
		ОтветСтрокой = БОНД_Коннектор.КакТекст(HTTPОтвет);
		
		Текст = "Запрос Точка банк. Получение QR-кода. Код состояния: " + HTTPОтвет.КодСостояния + ". Входящая информация: " + ОтветСтрокой + "";
		
		Ответ = ОпределитьОтвет(HTTPОтвет, Текст, ОтветСтрокой);
		
	КонецЕсли;
	
	qrcId = Ответ.Data.qrcId;
	
	СтруктураQRкода = Новый Структура;
	СтруктураQRкода.Вставить("Заказ",Данные.Заказ);
	СтруктураQRкода.Вставить("qrcId",qrcId);
	СтруктураQRкода.Вставить("Статус","NotStarted");
	СтруктураQRкода.Вставить("ДатаГенерации",ТекущаяДата());
	СтруктураQRкода.Вставить("imageParams_width",Ответ.Data.image.width);
	СтруктураQRкода.Вставить("imageParams_height",Ответ.Data.image.height);
	СтруктураQRкода.Вставить("imageParams_mediaType",Ответ.Data.image.mediaType);
	СтруктураQRкода.Вставить("imageParams_content",Ответ.Data.image.content);
	СтруктураQRкода.Вставить("payload",Ответ.Data.payload);
	СтруктураQRкода.Вставить("qrcType","02");
	СтруктураQRкода.Вставить("amount",Сумма);
	
	Данные.Вставить("QRкод",СтруктураQRкода);
	Если ЗначениеЗаполнено(qrcId) Тогда
		Попытка
			МенеджерЗаписи = РегистрыСведений.СБП_QRКоды.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Заказ = Данные.Заказ;
			МенеджерЗаписи.qrcId = qrcId;
			МенеджерЗаписи.status = "NOT_STARTED";
			МенеджерЗаписи.ДатаГенерации = ТекущаяДата();
			МенеджерЗаписи.imageParams_width = Ответ.Data.image.width;
			МенеджерЗаписи.imageParams_height = Ответ.Data.image.height;
			МенеджерЗаписи.imageParams_mediaType = Ответ.Data.image.mediaType;
			Хранилище = Новый ХранилищеЗначения(Ответ.Data.image.content, Новый СжатиеДанных());
			МенеджерЗаписи.imageParams_content = Хранилище;
			МенеджерЗаписи.payload = Ответ.Data.payload;
			МенеджерЗаписи.qrcType = "02";
			МенеджерЗаписи.amount = Сумма;
			МенеджерЗаписи.Записать();
		Исключение
			Текст = "Ошибка выгрузки записи регистра сведений СБП_QRКоды: " + ОписаниеОшибки() + "";
			//Сообщить(Текст, СтатусСообщения.Важное);
			ЗаписьЖурналаРегистрации(Текст, УровеньЖурналаРегистрации.Ошибка);
		КонецПопытки;
	КонецЕсли;
	
	ДД = Base64Значение(imageParams_content);
	Картинка = Новый Картинка(ДД, Ложь);
	СсылкаНаКартинку = ПоместитьВоВременноеХранилище(Картинка, Новый УникальныйИдентификатор);
	
	Возврат Данные;
	
КонецФункции

Процедура ПолучитьДанныеQRКодаИзБанка(Данные, ДанныеQR) 
	
	ТекстС = "Запуск API Точка банк. Запрос QR - кода";
	//Сообщить(ТекстС);
	ЗаписьЖурналаРегистрации(ТекстС, УровеньЖурналаРегистрации.Информация);
	
	//Get Qr Code          https://enter.tochka.com/uapi/sbp/{apiVersion}/qr-code/{qrcId}
	СтрокаЗапроса = Данные.НаборКлючей.sbp_type_service + "/sbp/v1.0/qr-code/" + ДанныеQR.qrcId + "";	
	
	HTTPОтвет = ПолучитьЗапрошенныйФайлPOST(СтрокаЗапроса, "", "GET", Данные.НаборКлючей.sbp_accesstoken_hybrid, Данные.НаборКлючей.sbp_account_code, Данные.НаборКлючей.sbp_url_service, Данные.НаборКлючей.sbp_port_service);
	
	//ОтветСтрокой = HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8");
	
	ОтветСтрокой = БОНД_Коннектор.КакТекст(HTTPОтвет);
	
	Текст = "Запрос Точка банк. Получение данных по QR-коду. Код состояния: " + HTTPОтвет.КодСостояния + ". Входящая информация: " + ОтветСтрокой + "";
	
	Ответ = ОпределитьОтвет(HTTPОтвет, Текст, ОтветСтрокой);
	
	Если СтрНайти(ОтветСтрокой,"token is missing") > 0 Тогда //токен не рабочий, обновляем его
		
		Данные.НаборКлючей = ЗначениеИзСтрокиВнутр(ЗначениеВСтрокуВнутр(ОбновитьТокенAPIБанкТочка(Данные.НаборКлючей)));
		
		HTTPОтвет = ПолучитьЗапрошенныйФайлPOST(СтрокаЗапроса, "", "GET", Данные.НаборКлючей.sbp_accesstoken_hybrid, Данные.НаборКлючей.sbp_account_code, Данные.НаборКлючей.sbp_url_service, Данные.НаборКлючей.sbp_port_service);
		
		//ОтветСтрокой = HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8");
		
		ОтветСтрокой = БОНД_Коннектор.КакТекст(HTTPОтвет);
		
		Текст = "Запрос Точка банк. Получение данных по QR-коду. Код состояния: " + HTTPОтвет.КодСостояния + ". Входящая информация: " + ОтветСтрокой + "";
		
		Ответ = ОпределитьОтвет(HTTPОтвет, Текст, ОтветСтрокой);
		
	КонецЕсли;
	
	ДанныеQR.commissionPercent = Ответ.Data.commissionPercent;
	ДанныеQR.paymentPurpose = Ответ.Data.paymentPurpose;
	
КонецПроцедуры

Функция ПолучитьQRКодПоЗаказу(Заказ) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	НаборКлючей = ПолучитьНаборКлючейДляСБП();
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Данные = новый Структура("НаборКлючей, Заказ", НаборКлючей, Заказ);
	
	Если НаборКлючей = Неопределено Тогда
		Сообщить("По организации " + Заказ.Организация + " не настроена система быстрых платежей!", СтатусСообщения.Важное);
		Возврат Данные;
	КонецЕсли;
	
	СтарыйНаборКлючей = НаборКлючей; //запомним набор ключей, чтобы потом проверить на изменения
	
	Данные = ЗначениеИзСтрокиВнутр(ЗначениеВСтрокуВнутр(ПолучитьQRКод(Данные)));
	
	//проверим набор ключей на изменение
	КлючиИзменены = Ложь;
	Если СтарыйНаборКлючей.sbp_accesstoken_hybrid <> Данные.НаборКлючей.sbp_accesstoken_hybrid Тогда
		КлючиИзменены = Истина;
	ИначеЕсли СтарыйНаборКлючей.sbp_accesstoken_client <> Данные.НаборКлючей.sbp_accesstoken_client Тогда
		КлючиИзменены = Истина;
	ИначеЕсли СтарыйНаборКлючей.sbp_refreshtoken_hybrid <> Данные.НаборКлючей.sbp_refreshtoken_hybrid Тогда
		КлючиИзменены = Истина;
	ИначеЕсли СтарыйНаборКлючей.sbp_client_id <> Данные.НаборКлючей.sbp_client_id Тогда
		КлючиИзменены = Истина;	
	ИначеЕсли СтарыйНаборКлючей.sbp_client_secret <> Данные.НаборКлючей.sbp_client_secret Тогда
		КлючиИзменены = Истина;	
	ИначеЕсли СтарыйНаборКлючей.sbp_account_code <> Данные.НаборКлючей.sbp_account_code Тогда
		КлючиИзменены = Истина;
	ИначеЕсли СтарыйНаборКлючей.sbp_merchant_id <> Данные.НаборКлючей.sbp_merchant_id Тогда
		КлючиИзменены = Истина;
	ИначеЕсли СтарыйНаборКлючей.sbp_legalId <> Данные.НаборКлючей.sbp_legalId Тогда
		КлючиИзменены = Истина;
	ИначеЕсли СтарыйНаборКлючей.sbp_customerCode <> Данные.НаборКлючей.sbp_customerCode Тогда
		КлючиИзменены = Истина;
	КонецЕсли;
	
	Если КлючиИзменены Тогда
		УстановитьПривилегированныйРежим(Истина);
		ЗаписатьНовыйНаборКлючейСБП(Данные.НаборКлючей);
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	Возврат Данные;
КонецФункции

#КонецОбласти

#Область Запросы_POST_и_GET_к_http

Функция ОпределитьОтвет(HTTPОтвет, Текст, ОтветСтрокой)
	
	//Мас = Новый Массив;
	Отказ = Ложь;
	
	Если HTTPОтвет.КодСостояния <> 200 Тогда 
		//Сообщить(Текст, СтатусСообщения.Важное);
		ЗаписьЖурналаРегистрации(Текст, УровеньЖурналаРегистрации.Ошибка);
		Отказ = Истина;
	КонецЕсли;
	
	Структ = Новый Структура;
	
	Если Не Отказ Тогда
		Попытка
			ЧтениеJSON = Новый ЧтениеJSON; 	
			ЧтениеJSON.УстановитьСтроку(ОтветСтрокой);
			Структ = ПрочитатьJSON(ЧтениеJSON);
			Для Каждого ЭлСтр Из Структ Цикл
				Если ЗначениеЗаполнено(ЭлСтр.Значение) Тогда
					//Сообщить("" + ЭлСтр.Ключ + " " + ЭлСтр.Значение + "");
				КонецЕсли;
			КонецЦикла;
			ЧтениеJSON.Закрыть();
		Исключение
			Текст = "Ошибка выгрузки API Точка Банк: " + ОписаниеОшибки() + "";
			Сообщить(Текст, СтатусСообщения.Важное);
			ЗаписьЖурналаРегистрации(Текст, УровеньЖурналаРегистрации.Ошибка);
			Отказ = Истина;	
		КонецПопытки; 		
		
	КонецЕсли;
	
	Если Отказ = Истина Тогда			
		//Мас = Новый Массив;
		Сообщить(ОтветСтрокой);
	ИначеЕсли Найти(ОтветСтрокой, """error"":null") > 0 Или Найти(ОтветСтрокой, """errors"":null") > 0 Тогда
		//все ок	
	ИначеЕсли Найти(ОтветСтрокой, "errors") > 0 или Найти(ОтветСтрокой, "error") > 0 Тогда 
		//Мас = Новый Массив;
		Сообщить(ОтветСтрокой);
	КонецЕсли;
	
	Возврат Структ;
	
КонецФункции

Функция СформироватьСтрокуJSONИзСтруктуры(Объект)
	
	СтрокаJSON = "{";
	
	Для каждого Элемент Из Объект Цикл
		
		Если Элемент.Значение = "" Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаJSON = СтрокаJSON + """" + Элемент.Ключ + """" + ":";
		
		Если ТипЗнч(Элемент.Значение) = Тип("Строка") Тогда
			СтрокаJSON = СтрокаJSON + """" + Элемент.Значение + """";
			
		ИначеЕсли ТипЗнч(Элемент.Значение) = Тип("Число") Тогда
			СтрокаJSON = СтрокаJSON + СтрЗаменить(СтрЗаменить(Строка(Элемент.Значение), Символы.НПП, ""), ",", ".");
			
		ИначеЕсли ТипЗнч(Элемент.Значение) = Тип("Булево") Тогда
			СтрокаJSON = СтрокаJSON + Формат(Элемент.Значение, "БЛ=false; БИ=true");
			
		ИначеЕсли ТипЗнч(Элемент.Значение) = Тип("Дата") Тогда
			// преобразование в unixtime
			СтрокаJSON = СтрокаJSON + Формат(Элемент.Значение - Дата(1970,1,1,1,0,0), "ЧГ=0");
			
		ИначеЕсли ТипЗнч(Элемент.Значение) = Тип("Массив") Тогда
			СтрокаJSON = СтрокаJSON + СформироватьСтрокуJSON(Элемент.Значение);
			
		ИначеЕсли ТипЗнч(Элемент.Значение) = Тип("Структура") Тогда
			СтрокаJSON = СтрокаJSON + СформироватьСтрокуJSON(Элемент.Значение);
			
		ИначеЕсли ТипЗнч(Элемент.Значение) = Тип("ТаблицаЗначений") Тогда
			СтрокаJSON = СтрокаJSON + СформироватьСтрокуJSON(Элемент.Значение);
			
		Иначе
			//СтрокаJSON = СтрокаJSON + """" + URLEncode(Строка(Элемент.Значение)) + """";
			СтрокаJSON = СтрокаJSON + """" + Строка(Элемент.Значение) + """";
			
		КонецЕсли;
		
		СтрокаJSON = СтрокаJSON + ",";
		
	КонецЦикла;
	
	Если Прав(СтрокаJSON, 1) = "," Тогда
		СтрокаJSON = Лев(СтрокаJSON, СтрДлина(СтрокаJSON)-1);
	КонецЕсли;
	
	Возврат СтрокаJSON + "}";
	
КонецФункции

Функция ПреобразоватьвСистему(Число10,система) Экспорт
	
	Если система > 36 или система < 2 тогда
		Сообщить("Выбранная система исчисления не поддерживается");
		Возврат -1;
	КонецЕсли;
	
	СтрокаЗначений = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ";
	СтрокаСистема = "";
	Пока Число10 > 0 цикл
		РезДеления = Число10/система;
		ЧислоСистема = цел(РезДеления);
		остатокОтДеления = Число10 - система*(ЧислоСистема);
		СтрокаСистема = сред(СтрокаЗначений,остатокОтДеления+1,1)+ СтрокаСистема;
		Число10 = ?(ЧислоСистема=0,0,РезДеления); 
	КонецЦикла;
	
	Нечётное = стрДлина(СтрокаСистема) - цел(стрДлина(СтрокаСистема)/2)*2;
	Если Нечётное тогда
		СтрокаСистема = "0"+СтрокаСистема;
	КонецЕсли;
	
	Возврат СтрокаСистема;
	
КонецФункции

Функция URLEncode(стр) Экспорт  
	
	Длина=СтрДлина(Стр);
	Итог="";
	Для Н=1 По Длина Цикл
		Знак=Сред(Стр,Н,1);
		Код=КодСимвола(Знак);
		
		если ((Знак>="a")и(Знак<="z")) или
			((Знак>="A")и(Знак<="Z")) или
			((Знак>="0")и(Знак<="9")) тогда
			Итог=Итог+Знак;
		Иначе
			Если (Код>=КодСимвола("А"))И(Код<=КодСимвола("п")) Тогда
				Итог=Итог+"%"+ПреобразоватьвСистему(208,16)+"%"+ПреобразоватьвСистему(144+Код-КодСимвола("А"),16);
			ИначеЕсли (Код>=КодСимвола("р"))И(Код<=КодСимвола("я")) Тогда
				Итог=Итог+"%"+ПреобразоватьвСистему(209,16)+"%"+ПреобразоватьвСистему(128+Код-КодСимвола("р"),16);
			ИначеЕсли (Знак="ё") Тогда
				Итог=Итог+"%"+ПреобразоватьвСистему(209,16)+"%"+ПреобразоватьвСистему(145,16);
			ИначеЕсли (Знак="Ё") Тогда
				Итог=Итог+"%"+ПреобразоватьвСистему(208,16)+"%"+ПреобразоватьвСистему(129,16);
			Иначе
				Итог=Итог+"%"+ПреобразоватьвСистему(Код,16);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Итог;
	
КонецФункции

Функция СформироватьСтрокуJSONИзМассива(Объект)
	
	СтрокаJSON = "[";
	
	Для каждого Элемент Из Объект Цикл
		
		Если ТипЗнч(Элемент) = Тип("Строка") Тогда
			СтрокаJSON = СтрокаJSON + """" + Элемент + """";
			
		ИначеЕсли ТипЗнч(Элемент) = Тип("Число") Тогда
			СтрокаJSON = СтрокаJSON + СтрЗаменить(СтрЗаменить(Строка(Элемент), Символы.НПП, ""), ",", ".");
			
		ИначеЕсли ТипЗнч(Элемент) = Тип("Булево") Тогда
			СтрокаJSON = СтрокаJSON + Формат(Элемент, "БЛ=false; БИ=true");
			
		ИначеЕсли ТипЗнч(Элемент) = Тип("Дата") Тогда
			// преобразование в unixtime
			СтрокаJSON = СтрокаJSON + Формат(Элемент - Дата(1970,1,1,1,0,0), "ЧГ=0");
			
		ИначеЕсли ТипЗнч(Элемент) = Тип("Массив") Тогда
			СтрокаJSON = СтрокаJSON + СформироватьСтрокуJSON(Элемент);
			
		ИначеЕсли ТипЗнч(Элемент) = Тип("Структура") Тогда
			СтрокаJSON = СтрокаJSON + СформироватьСтрокуJSON(Элемент);
			
		ИначеЕсли ТипЗнч(Элемент) = Тип("ТаблицаЗначений") Тогда
			СтрокаJSON = СтрокаJSON + СформироватьСтрокуJSON(Элемент);
			
		Иначе
			//СтрокаJSON = СтрокаJSON + """" + URLEncode(Строка(Элемент)) + """";
			СтрокаJSON = СтрокаJSON + """" + Строка(Элемент) + """";
		КонецЕсли;
		
		СтрокаJSON = СтрокаJSON + ",";
	КонецЦикла;
	
	Если Прав(СтрокаJSON, 1) = "," Тогда
		СтрокаJSON = Лев(СтрокаJSON, СтрДлина(СтрокаJSON)-1);
	КонецЕсли;
	
	Возврат СтрокаJSON + "]";
	
КонецФункции

Функция СформироватьСтрокуJSON(Объект) Экспорт
	
	СтрокаJSON = "";
	
	Если ТипЗнч(Объект) = Тип("Массив") Тогда
		СтрокаJSON = СформироватьСтрокуJSONИзМассива(Объект);
		
	ИначеЕсли ТипЗнч(Объект) = Тип("Структура") Тогда
		СтрокаJSON = СформироватьСтрокуJSONИзСтруктуры(Объект);
		
	ИначеЕсли ТипЗнч(Объект) = Тип("ТаблицаЗначений") Тогда
		// преобразуем таблицу значений в массив структур - работает дольше, но кода меньше
		// если нужна скорость, то нужно отдельно обработать таблицу значений
		
		СоставСтруктуры = "";
		Для каждого Колонка Из Объект.Колонки Цикл
			СоставСтруктуры = СоставСтруктуры + ?(ЗначениеЗаполнено(СоставСтруктуры), ",", "") + Колонка.Имя;
		КонецЦикла;
		
		МассивСтрок = Новый Массив;
		Для каждого Строка Из Объект Цикл
			СтруктураКолонок = Новый Структура(СоставСтруктуры);
			ЗаполнитьЗначенияСвойств(СтруктураКолонок, Строка);
			МассивСтрок.Добавить(СтруктураКолонок);
		КонецЦикла;
		
		СтрокаJSON = СформироватьСтрокуJSONИзМассива(МассивСтрок);
		
	КонецЕсли;
	
	Возврат СтрокаJSON;
	
КонецФункции  

Функция УдалениеНечитаемыхСимволов( Знач Стр, ОграничитьДлину = 100)
	
	Стр = СокрЛП( Стр);
	
	Стр = СтрЗаменить( Стр, Символ(34), "");
	Стр = СтрЗаменить( Стр, "'", "");
	Стр = СтрЗаменить( Стр, ",", ".");
	
	СоответствиеНайден = Новый Соответствие;
	
	Для НомерСимвола = 1 по СтрДлина( Стр) Цикл
		
		ТекСимвол = Сред( Стр, НомерСимвола, 1);
		
		Если КодСимвола( ТекСимвол) < 32 И КодСимвола( ТекСимвол) <> 10 Тогда
			СоответствиеНайден.Вставить( ТекСимвол, "");
		КонецЕсли;
		
	КонецЦикла; // НомерСимвола = 1 по СтрДлина( Стр)
	
	Если СоответствиеНайден.Количество() > 0 Тогда
		Для Каждого ТекСимвол из СоответствиеНайден Цикл
			Стр = СтрЗаменить( Стр, ТекСимвол.Ключ, "");
		КонецЦикла;
	КонецЕсли; // ФлагНайден > 0
	
	Если СтрДлина( Стр) > ОграничитьДлину Тогда
		Стр = Лев( Стр, ОграничитьДлину);
	КонецЕсли;
	
	Возврат Стр;
	
КонецФункции

