

#Область Блок_получения_и_обновления_токена_Банка_Точка

Функция ОбновитьТокенAPIБанкТочка(НаборКлючей) Экспорт
	
	СтрокаЗапроса = "connect/token";
	
	СтрокаBodyParametrs = "client_id=" + НаборКлючей.sbp_client_id + "&client_secret=" + НаборКлючей.sbp_client_secret + "&grant_type=refresh_token&refresh_token=" + НаборКлючей.sbp_refreshtoken_hybrid;
	ЗаголовокHTTP = Новый Соответствие();
	ЗаголовокHTTP.Вставить("Content-Type", "application/x-www-form-urlencoded");
	ЗаголовокHTTP.Вставить("accept", "application/json");
	ЗаголовокHTTP.Вставить("type", "POST");
	ЗаголовокHTTP.Вставить("dataType", "json");
	
	Попытка
		//Соединение = Новый HTTPСоединение("enter.tochka.com", 443,,,,,Новый ЗащищенноеСоединениеOpenSSL); 
		//Соединение = Новый HTTPСоединение(НаборКлючей.sbp_url_service, НаборКлючей.sbp_port_service,,,,,Новый ЗащищенноеСоединениеOpenSSL);
		//HTTPЗапрос = Новый HTTPЗапрос(СтрокаЗапроса, ЗаголовокHTTP);
		//HTTPЗапрос.УстановитьТелоИзСтроки(СтрокаBodyParametrs, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
		//ОтветСервера = Соединение.ОтправитьДляОбработки(HTTPЗапрос);   
		HTTPОтвет = БОНД_Коннектор.Post("https://" + НаборКлючей.sbp_url_service + "/" + СтрокаЗапроса, СтрокаBodyParametrs, Новый Структура("Заголовки",ЗаголовокHTTP)); 		
	Исключение
		ТекстОшибки = "Связь с сервером не установлена " + ОписаниеОшибки() + "";
		Сообщить(ТекстОшибки, СтатусСообщения.Важное);
		ЗаписьЖурналаРегистрации(ТекстОшибки, УровеньЖурналаРегистрации.Ошибка);
	КонецПопытки;
	
	ОтветСтрокой = БОНД_Коннектор.КакТекст(HTTPОтвет);
	
	//ОтветСтрокой = ОтветСервера.ПолучитьТелоКакСтроку("UTF-8");
	
	Текст = "Запрос Точка банк. Получение выписки. Код состояния: " + HTTPОтвет.КодСостояния + ". Входящая информация: " + ОтветСтрокой + "";
	
	Ответ = ОпределитьОтвет(HTTPОтвет, Текст, ОтветСтрокой);
	
	НаборКлючей.sbp_refreshtoken_hybrid = Ответ.refresh_token; 
	
	НаборКлючей.sbp_accesstoken_hybrid = Ответ.access_token;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Константы.НВД_sbp_refreshtoken_hybrid.Установить(НаборКлючей.sbp_refreshtoken_hybrid);
	Константы.НВД_sbp_accesstoken_hybrid.Установить(НаборКлючей.sbp_accesstoken_hybrid);
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат НаборКлючей;
	
	
КонецФункции	

#КонецОбласти

#Область QR_коды_для_оплаты_через_СБП      

Функция ПолучитьНаборКлючейДляСБП() Экспорт 
	
	НаборКлючей = Новый Структура();
	НаборКлючей.Вставить("sbp_accesstoken_hybrid", Константы.НВД_sbp_accesstoken_hybrid.Получить()); 
	НаборКлючей.Вставить("sbp_accesstoken_client", Константы.НВД_sbp_accesstoken_client.Получить());
	НаборКлючей.Вставить("sbp_refreshtoken_hybrid", Константы.НВД_sbp_refreshtoken_hybrid.Получить());
	НаборКлючей.Вставить("sbp_client_id", Константы.НВД_sbp_client_id.Получить());
	НаборКлючей.Вставить("sbp_client_secret", Константы.НВД_sbp_client_secret.Получить());
	БанкДляСБПТочкаБанк = Константы.НВД_ОсновнойБанковскийСчетДляСБП.Получить();
	sbp_account_code = "" + БанкДляСБПТочкаБанк.НомерСчета + "/" + БанкДляСБПТочкаБанк.БИК;
	//sbp_account_code = "12345678901234567890/044525104";
	НаборКлючей.Вставить("sbp_account_code", sbp_account_code);
	НаборКлючей.Вставить("sbp_merchant_id", Константы.НВД_sbp_merchant_id.Получить());
	НаборКлючей.Вставить("sbp_legalId", Константы.НВД_sbp_legalId.Получить());
	НаборКлючей.Вставить("sbp_customerCode", Константы.НВД_sbp_customerCode.Получить());
	НаборКлючей.Вставить("sbp_callback", Константы.НВД_sbp_callback.Получить());
	НаборКлючей.Вставить("sbp_url_service", Константы.НВД_sbp_url_service.Получить());
	НаборКлючей.Вставить("sbp_port_service", Константы.НВД_sbp_port_service.Получить());	
	НаборКлючей.Вставить("sbp_type_service", Константы.НВД_sbp_type_service.Получить()); 
	
	Возврат НаборКлючей;
	
КонецФункции

Процедура ЗаписатьНовыйНаборКлючейСБП(НаборКлючей) Экспорт 
	
	Константы.НВД_sbp_accesstoken_hybrid.Установить(НаборКлючей.sbp_accesstoken_hybrid);
	Константы.НВД_sbp_accesstoken_client.Установить(НаборКлючей.sbp_accesstoken_client);
	Константы.НВД_sbp_refreshtoken_hybrid.Установить(НаборКлючей.sbp_refreshtoken_hybrid);
	Константы.НВД_sbp_client_id.Установить(НаборКлючей.sbp_client_id);
	Константы.НВД_sbp_client_secret.Установить(НаборКлючей.sbp_client_secret);
	//Константы.НВД_sbp_account_code.Установить(НаборКлючей.sbp_account_code);
	Константы.НВД_sbp_merchant_id.Установить(НаборКлючей.sbp_merchant_id);
	Константы.НВД_sbp_legalId.Установить(НаборКлючей.sbp_legalId);
	Константы.НВД_sbp_customerCode.Установить(НаборКлючей.sbp_customerCode);
	
КонецПроцедуры

