&НаСервере
Процедура ВывестиУслугиПроизводства(ДатаОтчета, СписокВидовЦен, Макет, Таб)
	
	Таб.НачатьАвтогруппировкуСтрок();
	
	ИндУсловия = Ложь;
	Если Отчет.ИндивидуальныеЦены Тогда		
		ЗапросИндЦены = Новый Запрос;
		ЗапросИндЦены.Текст = ТекстЗапросаИндивидуальныхЦенУслугРаскроя();
		ЗапросИндЦены.УстановитьПараметр("Период",  ДатаОтчета);
		ЗапросИндЦены.УстановитьПараметр("ДоговорКонтрагента", Отчет.ДоговорКонтрагента);
		ЗапросИндЦены.УстановитьПараметр("Валюта", Отчет.Валюта);
		ЗапросИндЦены.УстановитьПараметр("ОтборПоВалюте", ЗначениеЗаполнено(Отчет.Валюта));
		ТаблицаЦены = ЗапросИндЦены.Выполнить().Выгрузить();
		Если ТаблицаЦены.Количество() > 0 Тогда
			Если НЕ ТаблицаЦены[0].Отменена Тогда
				ИндУсловия = Истина;
				//#7256
				Если ЗначениеЗаполнено(ТаблицаЦены[0].ВидЦеныНаУслугиПроизводства) Тогда
					// цены по ссылке на другой вид цен
					ИндЦена = Новый Массив;
					ИндЦена.Добавить(ТаблицаЦены[0].ВидЦеныНаУслугиПроизводства);
					Запрос = Новый Запрос;
					Запрос.Текст = ТекстЗапросаЦенУслугРаскроя();
					Запрос.УстановитьПараметр("Период",  ДатаОтчета);
					//Запрос.УстановитьПараметр("ОтборПоВидамЦен", Ложь);	
					Запрос.УстановитьПараметр("ВидЦены", ИндЦена); //Новый Массив);	
					//Запрос.УстановитьПараметр("ЦенаУслуг", ТаблицаЦены[0].ВидЦеныНаУслугиПроизводства);
					Запрос.УстановитьПараметр("Валюта", Отчет.Валюта);
					Запрос.УстановитьПараметр("ОтборПоВалюте", ЗначениеЗаполнено(Отчет.Валюта));
					ТаблицаЦены = Запрос.Выполнить().Выгрузить();					
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ИндУсловия Тогда	
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапросаЦенУслугРаскроя();
		Запрос.УстановитьПараметр("Период",  ДатаОтчета);
		//Запрос.УстановитьПараметр("ОтборПоВидамЦен", Истина);
		Запрос.УстановитьПараметр("ВидЦены", СписокВидовЦен);
		//Запрос.УстановитьПараметр("ЦенаУслуг", Неопределено);
		Запрос.УстановитьПараметр("Валюта", Отчет.Валюта);
		Запрос.УстановитьПараметр("ОтборПоВалюте", ЗначениеЗаполнено(Отчет.Валюта));
		ТаблицаЦены = Запрос.Выполнить().Выгрузить();
	КонецЕсли;
	
	Если ТаблицаЦены.Количество() > 0 Тогда
		
		ОбластьМакета = Макет.ПолучитьОбласть("ЗаголовокВидаПрайса");
		Таб.Вывести(ОбластьМакета);
		
		ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаблицы");
		Таб.Вывести(ОбластьМакета);
		
		Для Каждого ТекВидЦен Из ТаблицаЦены Цикл
			Если Отчет.НесколькоВидовЦен Тогда
				ОбластьМакета = Макет.ПолучитьОбласть("ВидЦен");
				ОбластьМакета.Параметры.ВидЦены = ВРЕГ(ТекВидЦен.ВидЦены) + " (" + ТекВидЦен.Валюта + ")";
				Таб.Вывести(ОбластьМакета, 1, "ВидЦен", Истина);
			КонецЕсли;
			
			Если ТекВидЦен.Углы.Количество() > 0 Тогда
				ВывестиТаблицуУслугРаскроя(ТекВидЦен, Таб, Макет, "Углы", "Углы");
			КонецЕсли;
			Если ТекВидЦен.ВырезыApply.Количество() > 0 Тогда
				ВывестиТаблицуУслугРаскроя(ТекВидЦен, Таб, Макет, "ВырезыApply", "Вырезы Apply");
			КонецЕсли;
			Если ТекВидЦен.Фотопечать.Количество() > 0 Тогда
				ВывестиТаблицуУслугРаскроя(ТекВидЦен, Таб, Макет, "Фотопечать", "Фотопечать");
			КонецЕсли;
			Если ТекВидЦен.ДлинаШвов.Количество() > 0 Тогда
				ВывестиТаблицуУслугРаскроя(ТекВидЦен, Таб, Макет, "ДлинаШвов", "Швы по длине");
			КонецЕсли;
			Если ТекВидЦен.ДлинаПользовательскихШвов.Количество() > 0 Тогда
				ВывестиТаблицуУслугРаскроя(ТекВидЦен, Таб, Макет, "ДлинаПользовательскихШвов", "Дополнительные швы по длине");
			КонецЕсли;
			Если ТекВидЦен.ВнутренниеВырезы.Количество() > 0 Тогда
				ВывестиТаблицуУслугРаскроя(ТекВидЦен, Таб, Макет, "ВнутренниеВырезы", "Внутренние вырезы");
			КонецЕсли;
			Если ТекВидЦен.Кривые.Количество() > 0 Тогда
				ВывестиТаблицуУслугРаскроя(ТекВидЦен, Таб, Макет, "Кривые", "Криволинейный участок");
			КонецЕсли;
			Если ТекВидЦен.ДлинаШвовМногофактурный.Количество() > 0 Тогда
				ВывестиТаблицуУслугРаскроя(ТекВидЦен, Таб, Макет, "ДлинаШвовМногофактурный", "Швы в многофактурном потолке по длине");
			КонецЕсли;
			
			Если НЕ ТекВидЦен.СтоимостьУслугиЦентровкиШва = 0 Тогда
				ОбластьМакета = Макет.ПолучитьОбласть("УслугаБезОтступа");
				ОбластьМакета.Параметры.Услуга = "Центровка шва в % от заказа";
				ОбластьМакета.Параметры.Цена = ТекВидЦен.СтоимостьУслугиЦентровкиШва;
				Таб.Вывести(ОбластьМакета, 2, "ЦентровкаШва", Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Таб.ЗакончитьАвтогруппировкуСтрок();
	
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ВывестиКомплектующие(СтруктураПараметров, Макет, Таб)
	
	Таб.НачатьАвтогруппировкуСтрок();
	
	ОбластьМакета = Макет.ПолучитьОбласть("ЗаголовокВидаПрайса");
	Таб.Вывести(ОбластьМакета);
	
	Если Отчет.ВыводитьКартинки Тогда
		ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаблицы|Фото");
		Таб.Вывести(ОбластьМакета);
	КонецЕсли;
	
	ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаблицы|Данные");
	Если Отчет.ВыводитьКартинки Тогда
		Таб.Присоединить(ОбластьМакета);
	Иначе           Таб.Вывести(ОбластьМакета);
	КонецЕсли;
	
	Для НомерЦены = 0 По СтруктураПараметров.СписокВидовЦен.Количество()-1 Цикл
		ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаблицы|Цена");
		ОбластьМакета.Параметры.ВидЦен = СтруктураПараметров.СписокВидовЦен.Получить(НомерЦены).Значение;
		ОбластьМакета.Параметры.Валюта = Отчет.Валюта;
		Таб.Присоединить(ОбластьМакета);
	КонецЦикла;
	
	
	Запрос = Новый Запрос;	
	Запрос.УстановитьПараметр("Период", 				КонецДня(СтруктураПараметров.ДатаОтчета));
	Запрос.УстановитьПараметр("ВидЦены", 				СтруктураПараметров.СписокВидовЦен);
	Запрос.УстановитьПараметр("Номенклатура", 			СтруктураПараметров.СписокДляОтбораНоменклатуры);
	Запрос.УстановитьПараметр("Валюта", 				СтруктураПараметров.Валюта);
	Запрос.УстановитьПараметр("НеПоказыватьНулевыеЦены", НЕ СтруктураПараметров.ПоказыватьНулевыеЦены);
	
	Запрос.УстановитьПараметр("ИспользоватьИндивидуальныеЦены",	Отчет.ИндивидуальныеЦены);
	Запрос.УстановитьПараметр("Контрагент",				Отчет.Контрагент);
	Запрос.УстановитьПараметр("ДоговорКонтрагента",		Отчет.ДоговорКонтрагента);
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЦеныНоменклатурыИндивидуальныеСрезПоследних.Номенклатура КАК Номенклатура,
	|	ЦеныНоменклатурыИндивидуальныеСрезПоследних.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ЦеныНоменклатурыИндивидуальныеСрезПоследних.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ЦеныНоменклатурыИндивидуальныеСрезПоследних.Валюта КАК Валюта,
	|	ВЫБОР
	|		КОГДА ЦеныНоменклатурыИндивидуальныеСрезПоследних.ВидЦены = ЗНАЧЕНИЕ(Справочник.ВидыЦен.ПустаяСсылка)
	|			ТОГДА ЦеныНоменклатурыИндивидуальныеСрезПоследних.Цена
	|		ИНАЧЕ ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, 0)
	|	КОНЕЦ КАК Цена,
	|	ЦеныНоменклатурыИндивидуальныеСрезПоследних.Отменена КАК Отменена
	|ПОМЕСТИТЬ ВТ_ИндивидуальныеЦены
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатурыИндивидуальные.СрезПоследних(
	|			&Период,
	|			Контрагент = &Контрагент
	|				И ДоговорКонтрагента = &ДоговорКонтрагента
	|				И Номенклатура В ИЕРАРХИИ (&Номенклатура)
	|				И Валюта = &Валюта) КАК ЦеныНоменклатурыИндивидуальныеСрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|				&Период,
	|				Номенклатура В ИЕРАРХИИ (&Номенклатура)
	|					И Валюта = &Валюта) КАК ЦеныНоменклатурыСрезПоследних
	|		ПО ЦеныНоменклатурыИндивидуальныеСрезПоследних.Номенклатура = ЦеныНоменклатурыСрезПоследних.Номенклатура
	|			И ЦеныНоменклатурыИндивидуальныеСрезПоследних.ХарактеристикаНоменклатуры = ЦеныНоменклатурыСрезПоследних.ХарактеристикаНоменклатуры
	|			И ЦеныНоменклатурыИндивидуальныеСрезПоследних.ЕдиницаИзмерения = ЦеныНоменклатурыСрезПоследних.ЕдиницаИзмерения
	|			И ЦеныНоменклатурыИндивидуальныеСрезПоследних.ВидЦены = ЦеныНоменклатурыСрезПоследних.ВидЦены
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВидыЦен.Ссылка КАК ВидЦены,
	|	ВЫБОР
	|		КОГДА ВидыЦен.СсылочныйВидЦены = ИСТИНА
	|			ТОГДА ЕСТЬNULL(ЦеныСсылочныхСрезПоследних.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка))
	|		ИНАЧЕ ЕСТЬNULL(ЦеныСрезПоследних.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка))
	|	КОНЕЦ КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА ВидыЦен.СсылочныйВидЦены = ИСТИНА
	|			ТОГДА ЕСТЬNULL(ЦеныСсылочныхСрезПоследних.ХарактеристикаНоменклатуры, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка))
	|		ИНАЧЕ ЕСТЬNULL(ЦеныСрезПоследних.ХарактеристикаНоменклатуры, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка))
	|	КОНЕЦ КАК ХарактеристикаНоменклатуры,
	|	ВЫБОР
	|		КОГДА ВидыЦен.СсылочныйВидЦены = ИСТИНА
	|			ТОГДА ЕСТЬNULL(ЦеныСсылочныхСрезПоследних.ЕдиницаИзмерения, НЕОПРЕДЕЛЕНО)
	|		ИНАЧЕ ЕСТЬNULL(ЦеныСрезПоследних.ЕдиницаИзмерения, НЕОПРЕДЕЛЕНО)
	|	КОНЕЦ КАК ЕдиницаИзмерения,
	|	ВЫБОР
	|		КОГДА ВидыЦен.СсылочныйВидЦены = ИСТИНА
	|			ТОГДА ЕСТЬNULL(ЦеныСсылочныхСрезПоследних.Валюта, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка))
	|		ИНАЧЕ ЕСТЬNULL(ЦеныСрезПоследних.Валюта, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка))
	|	КОНЕЦ КАК Валюта,
	|	ВЫБОР
	|		КОГДА ВидыЦен.СсылочныйВидЦены = ИСТИНА
	|			ТОГДА ЕСТЬNULL(ЦеныСсылочныхСрезПоследних.Цена, 0)
	|		ИНАЧЕ ЕСТЬNULL(ЦеныСрезПоследних.Цена, 0)
	|	КОНЕЦ КАК Цена
	|ПОМЕСТИТЬ ВТ_ЦеныВрем
	|ИЗ
	|	Справочник.ВидыЦен КАК ВидыЦен
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&Период, Валюта = &Валюта) КАК ЦеныСрезПоследних
	|		ПО (ЦеныСрезПоследних.ВидЦены = ВидыЦен.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&Период, Валюта = &Валюта) КАК ЦеныСсылочныхСрезПоследних
	|		ПО (ЦеныСсылочныхСрезПоследних.ВидЦены = ВидыЦен.ВидЦеныНоменклатуры)
	|ГДЕ
	|	ВидыЦен.Ссылка В(&ВидЦены)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_ЦеныВрем.Номенклатура КАК Номенклатура,
	|	ВТ_ЦеныВрем.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ВТ_ЦеныВрем.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ВТ_ЦеныВрем.ВидЦены КАК ВидЦены,
	|	ВЫБОР
	|		КОГДА НЕ ВТ_ИндивидуальныеЦены.Цена ЕСТЬ NULL
	|			ТОГДА ВЫБОР
	|					КОГДА НЕ ВТ_ИндивидуальныеЦены.Отменена
	|						ТОГДА ВТ_ИндивидуальныеЦены.Цена
	|					ИНАЧЕ ВТ_ЦеныВрем.Цена
	|				КОНЕЦ
	|		ИНАЧЕ ВТ_ЦеныВрем.Цена
	|	КОНЕЦ КАК Цена
	|ПОМЕСТИТЬ ВТ_Цены
	|ИЗ
	|	ВТ_ЦеныВрем КАК ВТ_ЦеныВрем
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ИндивидуальныеЦены КАК ВТ_ИндивидуальныеЦены
	|		ПО (&ИспользоватьИндивидуальныеЦены)
	|			И ВТ_ЦеныВрем.Валюта = ВТ_ИндивидуальныеЦены.Валюта
	|			И ВТ_ЦеныВрем.ЕдиницаИзмерения = ВТ_ИндивидуальныеЦены.ЕдиницаИзмерения
	|			И ВТ_ЦеныВрем.Номенклатура = ВТ_ИндивидуальныеЦены.Номенклатура
	|			И ВТ_ЦеныВрем.ХарактеристикаНоменклатуры = ВТ_ИндивидуальныеЦены.ХарактеристикаНоменклатуры
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_ИндивидуальныеЦены
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_ЦеныВрем
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СправочникНоменклатура.Ссылка КАК Номенклатура,
	|	ЕСТЬNULL(СправочникХарактеристикиНоменклатуры.Ссылка, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК ХарактеристикаНоменклатуры,
	|	ЕСТЬNULL(ВТ_Цены.ЕдиницаИзмерения, СправочникНоменклатура.БазоваяЕдиницаИзмерения) КАК ЕдИзм,
	|	ЕСТЬNULL(ВТ_Цены.Цена, 0) КАК Цена,
	|	ВТ_Цены.ВидЦены КАК ВидЦены,
	|	ЕСТЬNULL(НоменклатураПрисоединенныеФайлы.ФайлХранилище, НЕОПРЕДЕЛЕНО) КАК ФайлХранилище,
	|	СправочникНоменклатура.Код КАК КодНоменклатуры
	|ИЗ
	|	Справочник.Номенклатура КАК СправочникНоменклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК СправочникХарактеристикиНоменклатуры
	|		ПО (СправочникХарактеристикиНоменклатуры.Владелец = СправочникНоменклатура.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Цены КАК ВТ_Цены
	|		ПО СправочникНоменклатура.Ссылка = ВТ_Цены.Номенклатура
	|			И (ЕСТЬNULL(СправочникХарактеристикиНоменклатуры.Ссылка, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) = ВТ_Цены.ХарактеристикаНоменклатуры)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НоменклатураПрисоединенныеФайлы КАК НоменклатураПрисоединенныеФайлы
	|		ПО (НоменклатураПрисоединенныеФайлы.ВладелецФайла = СправочникНоменклатура.Ссылка)
	|			И (НоменклатураПрисоединенныеФайлы.Ссылка = СправочникНоменклатура.ФайлКартинки)
	|ГДЕ
	|	СправочникНоменклатура.Ссылка В ИЕРАРХИИ(&Номенклатура)
	|	И НЕ СправочникНоменклатура.ЭтоГруппа
	|	И ВЫБОР
	|			КОГДА &НеПоказыватьНулевыеЦены
	|				ТОГДА ЕСТЬNULL(ВТ_Цены.Цена, 0) <> 0
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	СправочникНоменклатура.ЭтоГруппа УБЫВ,
	|	Номенклатура
	|ИТОГИ ПО
	|	Номенклатура ИЕРАРХИЯ,
	|	ЕдИзм,
	|	ХарактеристикаНоменклатуры
	|АВТОУПОРЯДОЧИВАНИЕ";
	
	ВыборкаНоменклатуры = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаНоменклатуры.Следующий() Цикл
		
		// вывод групп номенклатуры
		Если ВыборкаНоменклатуры.Номенклатура.ЭтоГруппа Тогда
			ОбластьМакета = Макет.ПолучитьОбласть("Группа|Данные");
			ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, ВыборкаНоменклатуры);
			Таб.Вывести(ОбластьМакета,ВыборкаНоменклатуры.Номенклатура.Уровень(),"Номенклатура"+ВыборкаНоменклатуры.Номенклатура.Уровень(),Истина);
			ОбластьЯчеек = Таб.Область(Таб.ВысотаТаблицы, 1, Таб.ВысотаТаблицы, 1);
			ОбластьЯчеек.Отступ = 2* ВыборкаНоменклатуры.Номенклатура.Уровень();
			Если Отчет.ВыводитьКартинки Тогда
				ОбластьМакета = Макет.ПолучитьОбласть("Группа|Фото");
				Таб.Присоединить(ОбластьМакета,ВыборкаНоменклатуры.Номенклатура.Уровень(),"Номенклатура"+ВыборкаНоменклатуры.Номенклатура.Уровень(),Истина);
			КонецЕсли;
			
			
			Для НомерЦены = 0 По СтруктураПараметров.СписокВидовЦен.Количество()-1 Цикл
				ОбластьМакета = Макет.ПолучитьОбласть("Группа|Цена");
				ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, ВыборкаНоменклатуры);
				Таб.Присоединить(ОбластьМакета,ВыборкаНоменклатуры.Номенклатура.Уровень(),"Номенклатура"+ВыборкаНоменклатуры.Номенклатура.Уровень(),Истина);
			КонецЦикла;
			
			
			
			ОбластьОбъединения = Таб.Область(Таб.ВысотаТаблицы, 1, Таб.ВысотаТаблицы, 2 + СтруктураПараметров.СписокВидовЦен.Количество() + ?(Отчет.ВыводитьКартинки, 1, 0));
			ОбластьОбъединения.Объединить();
			
			// вывод самой номенклатуры
		Иначе
			ВыборкаЕдиницИзмерения = ВыборкаНоменклатуры.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаЕдиницИзмерения.Следующий() Цикл	
				Если Отчет.ВыводитьКартинки Тогда
					ОбластьМакетаФото = Макет.ПолучитьОбласть("СтрокаСФото|Фото");
					Если ЗначениеЗаполнено(ВыборкаЕдиницИзмерения.Номенклатура.ФайлКартинки) Тогда
						ЗначениеХранилища = ВыборкаЕдиницИзмерения.Номенклатура.ФайлКартинки.ФайлХранилище.Получить();
					Иначе
						ЗначениеХранилища = Неопределено;
					КонецЕсли;
					Картинка = Новый Картинка(ЗначениеХранилища);
					ОбластьМакетаФото.Рисунки.ФотоТовара.Картинка = Картинка;									
					Таб.Вывести(ОбластьМакетаФото,ВыборкаЕдиницИзмерения.Номенклатура.Уровень(),"Номенклатура"+ВыборкаЕдиницИзмерения.Номенклатура.Уровень(),Истина);
				КонецЕсли;
				
				ОбластьМакета = Макет.ПолучитьОбласть(?(Отчет.ВыводитьКартинки, "СтрокаСФото|Данные", "Строка|Данные"));
				ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, ВыборкаЕдиницИзмерения);
				Если Отчет.ВыводитьКартинки Тогда
					Таб.Присоединить(ОбластьМакета,ВыборкаЕдиницИзмерения.Номенклатура.Уровень(),"Номенклатура"+ВыборкаЕдиницИзмерения.Номенклатура.Уровень(),Истина);
				Иначе
					Таб.Вывести(ОбластьМакета,ВыборкаЕдиницИзмерения.Номенклатура.Уровень(),"Номенклатура"+ВыборкаЕдиницИзмерения.Номенклатура.Уровень(),Истина);
				КонецЕсли;
				ОбластьЯчеек = Таб.Область(Таб.ВысотаТаблицы, 1, Таб.ВысотаТаблицы, 1);
				ОбластьЯчеек.Отступ = 2* ВыборкаЕдиницИзмерения.Номенклатура.Уровень();
				
				ВыборкаХарактеристик = ВыборкаЕдиницИзмерения.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				
				ЭтоПервый = Истина;
				Пока ВыборкаХарактеристик.Следующий() Цикл
					
					Если ВыборкаХарактеристик.ХарактеристикаНоменклатуры.Пустая() Тогда
						
						// характеристики не используются
						Цены = Новый Соответствие;
						ВыборкаЦен = ВыборкаХарактеристик.Выбрать();
						Пока ВыборкаЦен.Следующий() Цикл
							Цены.Вставить(ВыборкаЦен.ВидЦены, ВыборкаЦен.Цена);
						КонецЦикла;
						
						Для НомерЦены = 0 По СтруктураПараметров.СписокВидовЦен.Количество() - 1 Цикл
							ОбластьМакета = Макет.ПолучитьОбласть(?(Отчет.ВыводитьКартинки, "СтрокаСФото|Цена", "Строка|Цена"));
							ОбластьМакета.Параметры.Цена = Цены.Получить(СтруктураПараметров.СписокВидовЦен.Получить(НомерЦены).Значение);
							Таб.Присоединить(ОбластьМакета,ВыборкаЕдиницИзмерения.Номенклатура.Уровень(),"Номенклатура"+ВыборкаЕдиницИзмерения.Номенклатура.Уровень(),Истина);
						КонецЦикла;
						
					Иначе
						Если ЭтоПервый Тогда
							Если Отчет.ВыводитьКартинки Тогда
								ОбластьМакетаФото = Макет.ПолучитьОбласть("СтрокаСФото|Фото");
								Если ЗначениеЗаполнено(ВыборкаЕдиницИзмерения.Номенклатура.ФайлКартинки) Тогда
									ЗначениеХранилища = ВыборкаЕдиницИзмерения.Номенклатура.ФайлКартинки.ФайлХранилище.Получить();
								Иначе
									ЗначениеХранилища = Неопределено;
								КонецЕсли;
								Картинка = Новый Картинка(ЗначениеХранилища);								 
								ОбластьМакетаФото.Рисунки.ФотоТовара.Картинка = Картинка;									
								Таб.Присоединить(ОбластьМакетаФото,ВыборкаЕдиницИзмерения.Номенклатура.Уровень(),"Номенклатура"+ВыборкаЕдиницИзмерения.Номенклатура.Уровень(),Истина);
							КонецЕсли;
							
							Для НомерЦены = 0 По СтруктураПараметров.СписокВидовЦен.Количество()-1 Цикл
								ОбластьМакета = Макет.ПолучитьОбласть(?(Отчет.ВыводитьКартинки, "СтрокаСФото|Цена", "Строка|Цена"));
								Таб.Присоединить(ОбластьМакета,ВыборкаНоменклатуры.Номенклатура.Уровень(),"Номенклатура"+ВыборкаНоменклатуры.Номенклатура.Уровень(),Истина);
							КонецЦикла;	
							ЭтоПервый = Ложь;
						КонецЕсли;
						
						Цены = Новый Соответствие;
						ВыборкаЦен = ВыборкаХарактеристик.Выбрать();
						Пока ВыборкаЦен.Следующий() Цикл
							Цены.Вставить(ВыборкаЦен.ВидЦены, ВыборкаЦен.Цена);
						КонецЦикла;
						
						Если Отчет.ВыводитьКартинки Тогда								
							ОбластьМакетаФото = Макет.ПолучитьОбласть("Характеристика|Фото");
							Таб.вывести(ОбластьМакетаФото,ВыборкаЕдиницИзмерения.Номенклатура.Уровень()+1,"Характеристика"+ВыборкаЕдиницИзмерения.Номенклатура.Уровень()+1,Истина);
						КонецЕсли;
						ОбластьМакета = Макет.ПолучитьОбласть("Характеристика|Данные");
						ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, ВыборкаХарактеристик);
						Если Отчет.ВыводитьКартинки Тогда
							Таб.Присоединить(ОбластьМакета,ВыборкаЕдиницИзмерения.Номенклатура.Уровень()+1,"Характеристика"+ВыборкаЕдиницИзмерения.Номенклатура.Уровень()+1,Истина);
						Иначе
							Таб.Вывести(ОбластьМакета,ВыборкаЕдиницИзмерения.Номенклатура.Уровень()+1,"Характеристика"+ВыборкаЕдиницИзмерения.Номенклатура.Уровень()+1,Истина);
						Конецесли;
						ОбластьЯчеек = Таб.Область(Таб.ВысотаТаблицы, 1, Таб.ВысотаТаблицы, 1);
						ОбластьЯчеек.Отступ = 2* ВыборкаЕдиницИзмерения.Номенклатура.Уровень() + 2;
						
						Для НомерЦены = 0 По СтруктураПараметров.СписокВидовЦен.Количество() - 1 Цикл
							ОбластьМакета = Макет.ПолучитьОбласть("Характеристика|Цена");
							ОбластьМакета.Параметры.Цена = Цены.Получить(СтруктураПараметров.СписокВидовЦен.Получить(НомерЦены).Значение);										
							Таб.Присоединить(ОбластьМакета,ВыборкаЕдиницИзмерения.Номенклатура.Уровень()+1,"Характеристика"+ВыборкаЕдиницИзмерения.Номенклатура.Уровень()+1,Истина);
						КонецЦикла;
					КонецЕсли;
				КонецЦикла;
				
				
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Таб.ЗакончитьАвтогруппировкуСтрок();
	
КонецПроцедуры

&НаСервере
Процедура ВывестиЦеныНаПродукцию(СтруктураПараметров, Макет, Таб)
	
	Таб.НачатьАвтогруппировкуСтрок();
	
	СписокВидовЦенМатериалов = Новый СписокЗначений;
	СписокВидовЦенМатериалов.ЗагрузитьЗначения(СтруктураПараметров.СписокВидовЦен.ВыгрузитьЗначения());
	
	ОбластьМакета = Макет.ПолучитьОбласть("ЗаголовокВидаПрайса");
	Таб.Вывести(ОбластьМакета);
	
	ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаблицы|Данные");
	Таб.Вывести(ОбластьМакета);
	
	Для НомерЦены = 0 По СписокВидовЦенМатериалов.Количество()-1 Цикл
		ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаблицы|Цена");
		ОбластьМакета.Параметры.ВидЦены = ?(Отчет.ИндивидуальныеЦены, "Индивидуальная", СписокВидовЦенМатериалов.Получить(НомерЦены).Значение);
		ОбластьМакета.Параметры.Валюта = Отчет.Валюта;
		Таб.Присоединить(ОбластьМакета);
	КонецЦикла;
	//ОбластьОбъединения = Таб.Область(Таб.ВысотаТаблицы-2, 1, Таб.ВысотаТаблицы-2, 2 + 2*СтруктураПараметров.СписокВидовЦен.Количество());
	//ОбластьОбъединения.Объединить();

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЦеныИндивидуальныеСрезПоследних.Фактура КАК Фактура,
	|	ЦеныИндивидуальныеСрезПоследних.ЦветФактуры КАК ЦветФактуры,
	|	ЦеныИндивидуальныеСрезПоследних.ВидНоменклатуры КАК ВидНоменклатуры,
	|	ВЫБОР
	|		КОГДА ЦеныИндивидуальныеСрезПоследних.ВидЦены = ЗНАЧЕНИЕ(Справочник.ВидыЦен.ПустаяСсылка)
	|			ТОГДА ЦеныИндивидуальныеСрезПоследних.Цена
	|		ИНАЧЕ ЕСТЬNULL(ЦеныСрезПоследних.Цена, 0)
	|	КОНЕЦ КАК Цена,
	|	ВЫБОР
	|		КОГДА ЦеныИндивидуальныеСрезПоследних.ВидЦеныСФотопечатью = ЗНАЧЕНИЕ(Справочник.ВидыЦен.ПустаяСсылка)
	|			ТОГДА ЦеныИндивидуальныеСрезПоследних.ЦенаСФотопечатью
	|		ИНАЧЕ ЕСТЬNULL(ЦеныСФотопечатьюСрезПоследних.Цена, 0)
	|	КОНЕЦ КАК ЦенаСФотопечатью,
	|	ЦеныИндивидуальныеСрезПоследних.Отменена КАК Отменена
	|ПОМЕСТИТЬ ВТ_ИндивидуальныеЦены
	|ИЗ
	|	РегистрСведений.ЦеныМатериаловИндивидуальные.СрезПоследних(
	|			&Период,
	|			Контрагент = &Контрагент
	|				И ДоговорКонтрагента = &ДоговорКонтрагента
	|				И ВидНоменклатуры = &ВидНоменклатуры
	|				И Валюта = &Валюта) КАК ЦеныИндивидуальныеСрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныМатериалов.СрезПоследних(
	|				&Период,
	|				ВидНоменклатуры = &ВидНоменклатуры
	|					И Валюта = &Валюта) КАК ЦеныСрезПоследних
	|		ПО ЦеныИндивидуальныеСрезПоследних.Фактура = ЦеныСрезПоследних.Фактура
	|			И ЦеныИндивидуальныеСрезПоследних.ЦветФактуры = ЦеныСрезПоследних.ЦветФактуры
	|			И ЦеныИндивидуальныеСрезПоследних.ВидЦены = ЦеныСрезПоследних.ВидЦен
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныМатериалов.СрезПоследних(
	|				&Период,
	|				ВидНоменклатуры = &ВидНоменклатуры
	|					И Валюта = &Валюта) КАК ЦеныСФотопечатьюСрезПоследних
	|		ПО (ЦеныИндивидуальныеСрезПоследних.Фактура = ЦеныСрезПоследних.Фактура)
	|			И (ЦеныИндивидуальныеСрезПоследних.ЦветФактуры = ЦеныСрезПоследних.ЦветФактуры)
	|			И (ЦеныИндивидуальныеСрезПоследних.ВидЦеныСФотопечатью = ЦеныСрезПоследних.ВидЦен)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВидыЦен.Ссылка КАК ВидЦены,
	|	ВЫБОР
	|		КОГДА ВидыЦен.СсылочныйВидЦены = ИСТИНА
	|			ТОГДА ЕСТЬNULL(ЦеныСсылочныхСрезПоследних.Фактура, ЗНАЧЕНИЕ(Справочник.Фактура.ПустаяСсылка))
	|		ИНАЧЕ ЕСТЬNULL(ЦеныСрезПоследних.Фактура, ЗНАЧЕНИЕ(Справочник.Фактура.ПустаяСсылка))
	|	КОНЕЦ КАК Фактура,
	|	ВЫБОР
	|		КОГДА ВидыЦен.СсылочныйВидЦены = ИСТИНА
	|			ТОГДА ЕСТЬNULL(ЦеныСсылочныхСрезПоследних.ЦветФактуры, ЗНАЧЕНИЕ(Справочник.ЦветФактуры.ПустаяСсылка))
	|		ИНАЧЕ ЕСТЬNULL(ЦеныСрезПоследних.ЦветФактуры, ЗНАЧЕНИЕ(Справочник.ЦветФактуры.ПустаяСсылка))
	|	КОНЕЦ КАК ЦветФактуры,
	|	ВЫБОР
	|		КОГДА ВидыЦен.СсылочныйВидЦены = ИСТИНА
	|			ТОГДА ЕСТЬNULL(ЦеныСсылочныхСрезПоследних.ВидНоменклатуры, ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.ПустаяСсылка))
	|		ИНАЧЕ ЕСТЬNULL(ЦеныСрезПоследних.ВидНоменклатуры, ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.ПустаяСсылка))
	|	КОНЕЦ КАК ВидНоменклатуры,
	|	ВЫБОР
	|		КОГДА ВидыЦен.СсылочныйВидЦены = ИСТИНА
	|			ТОГДА ЕСТЬNULL(ЦеныСсылочныхСрезПоследних.Цена, 0)
	|		ИНАЧЕ ЕСТЬNULL(ЦеныСрезПоследних.Цена, 0)
	|	КОНЕЦ КАК Цена,
	|	ВЫБОР
	|		КОГДА ВидыЦен.СсылочныйВидЦены = ИСТИНА
	|			ТОГДА ЕСТЬNULL(ЦеныСсылочныхСрезПоследних.ЦенаСФотопечатью, 0)
	|		ИНАЧЕ ЕСТЬNULL(ЦеныСрезПоследних.ЦенаСФотопечатью, 0)
	|	КОНЕЦ КАК ЦенаСФотопечатью
	|ПОМЕСТИТЬ ВТ_Цены
	|ИЗ
	|	Справочник.ВидыЦен КАК ВидыЦен
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныМатериалов.СрезПоследних(
	|				&Период,
	|				ВидНоменклатуры = &ВидНоменклатуры
	|					И Валюта = &Валюта) КАК ЦеныСрезПоследних
	|		ПО (ЦеныСрезПоследних.ВидЦен = ВидыЦен.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныМатериалов.СрезПоследних(
	|				&Период,
	|				ВидНоменклатуры = &ВидНоменклатуры
	|					И Валюта = &Валюта) КАК ЦеныСсылочныхСрезПоследних
	|		ПО (ЦеныСсылочныхСрезПоследних.ВидЦен = ВидыЦен.ВидЦеныНоменклатуры)
	|ГДЕ
	|	ВидыЦен.Ссылка В(&ВидЦены)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЦветаФактур.Владелец.Родитель КАК ГруппаФактуры,
	|	ЦветаФактур.Владелец КАК Фактура,
	|	ЦветаФактур.Ссылка КАК ЦветФактуры,
	|	ЕСТЬNULL(ВТ_Цены.ВидНоменклатуры, ЕСТЬNULL(ВТ_ИндивидуальныеЦены.ВидНоменклатуры, ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.ПустаяСсылка))) КАК ВидНоменклатурыПотолка,
	|	ВЫБОР
	|		КОГДА НЕ ВТ_ИндивидуальныеЦены.Цена ЕСТЬ NULL
	|			ТОГДА ВЫБОР
	|					КОГДА НЕ ВТ_ИндивидуальныеЦены.Отменена
	|						ТОГДА ВТ_ИндивидуальныеЦены.Цена
	|					ИНАЧЕ ЕСТЬNULL(ВТ_Цены.Цена, 0)
	|				КОНЕЦ
	|		ИНАЧЕ ЕСТЬNULL(ВТ_Цены.Цена, 0)
	|	КОНЕЦ КАК Цена,
	|	ВЫБОР
	|		КОГДА НЕ ВТ_ИндивидуальныеЦены.ЦенаСФотопечатью ЕСТЬ NULL
	|			ТОГДА ВЫБОР
	|					КОГДА НЕ ВТ_ИндивидуальныеЦены.Отменена
	|						ТОГДА ВТ_ИндивидуальныеЦены.ЦенаСФотопечатью
	|					ИНАЧЕ ЕСТЬNULL(ВТ_Цены.ЦенаСФотопечатью, 0)
	|				КОНЕЦ
	|		ИНАЧЕ ЕСТЬNULL(ВТ_Цены.ЦенаСФотопечатью, 0)
	|	КОНЕЦ КАК ЦенаСФотопечатью,
	|	ВТ_Цены.ВидЦены КАК ВидЦены
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	Справочник.ЦветФактуры КАК ЦветаФактур
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Цены КАК ВТ_Цены
	|		ПО ЦветаФактур.Владелец = ВТ_Цены.Фактура
	|			И ЦветаФактур.Ссылка = ВТ_Цены.ЦветФактуры
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ИндивидуальныеЦены КАК ВТ_ИндивидуальныеЦены
	|		ПО (&ИспользоватьИндивидуальныеЦены)
	|			И ЦветаФактур.Владелец = ВТ_ИндивидуальныеЦены.Фактура
	|			И ЦветаФактур.Ссылка = ВТ_ИндивидуальныеЦены.ЦветФактуры
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &ОтборПоФактуре
	|				ТОГДА ЦветаФактур.Владелец В ИЕРАРХИИ (&Фактура)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.ГруппаФактуры КАК ГруппаФактуры,
	|	ВТ.Фактура КАК Фактура,
	|	ВТ.ЦветФактуры КАК ЦветФактуры,
	|	ВТ.ВидНоменклатурыПотолка КАК ВидНоменклатурыПотолка,
	|	ВТ.Цена КАК Цена,
	|	ВТ.ЦенаСФотопечатью КАК ЦенаСФотопечатью,
	|	ВТ.ВидЦены КАК ВидЦены
	|ИЗ
	|	ВТ КАК ВТ
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &НеПоказыватьНулевыеЦены
	|				ТОГДА ВТ.Цена <> 0
	|						ИЛИ ВТ.ЦенаСФотопечатью <> 0
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ.ВидНоменклатурыПотолка,
	|	ВТ.Фактура,
	|	ВТ.ЦветФактуры
	|ИТОГИ ПО
	|	ВидНоменклатурыПотолка,
	|	ГруппаФактуры,
	|	Фактура,
	|	ЦветФактуры
	|АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("Период", 					СтруктураПараметров.ДатаОтчета);
	Запрос.УстановитьПараметр("ВидЦены",					СтруктураПараметров.СписокВидовЦен);
	Запрос.УстановитьПараметр("ОтборПоФактуре",				СтруктураПараметров.СписокДляОтбораФактур.Количество() > 0);
	Запрос.УстановитьПараметр("Фактура",					СтруктураПараметров.СписокДляОтбораФактур);
	Запрос.УстановитьПараметр("Валюта", 					СтруктураПараметров.Валюта);
	Запрос.УстановитьПараметр("ВидНоменклатуры",			СтруктураПараметров.ВидНоменклатурыПотолки);
	Запрос.УстановитьПараметр("НеПоказыватьНулевыеЦены", 	НЕ СтруктураПараметров.ПоказыватьНулевыеЦены);
	
	Запрос.УстановитьПараметр("ИспользоватьИндивидуальныеЦены",	Отчет.ИндивидуальныеЦены);
	Запрос.УстановитьПараметр("Контрагент",					Отчет.Контрагент);
	Запрос.УстановитьПараметр("ДоговорКонтрагента",			Отчет.ДоговорКонтрагента);
	
	ВыборкаВидов = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаВидов.Следующий() Цикл
		ОбластьМакета = Макет.ПолучитьОбласть("ВидПотолка|Данные");
		ОбластьМакета.Параметры.Заполнить(ВыборкаВидов);
		Таб.Вывести(ОбластьМакета, 1);
		ОбластьМакета = Макет.ПолучитьОбласть("ВидПотолка|Цена");
		Для НомерЦены = 0 По СписокВидовЦенМатериалов.Количество()-1 Цикл
			Таб.Присоединить(ОбластьМакета, 1);
		КонецЦикла;
		ОбластьОбъединения = Таб.Область(Таб.ВысотаТаблицы, 1, Таб.ВысотаТаблицы, 2 + 2*СписокВидовЦенМатериалов.Количество());
		ОбластьОбъединения.Объединить(); 
		
		// Группа фактуры
		ВыборкаГруппФактур = ВыборкаВидов.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаГруппФактур.Следующий() Цикл
			ОбластьМакета = Макет.ПолучитьОбласть("СтрокаГруппаФактуры|Данные");
			ОбластьМакета.Параметры.Заполнить(ВыборкаГруппФактур);
			Таб.Вывести(ОбластьМакета, 2);
			ОбластьМакета = Макет.ПолучитьОбласть("СтрокаГруппаФактуры|Цена");
			Для НомерЦены = 0 По СписокВидовЦенМатериалов.Количество()-1 Цикл
				Таб.Присоединить(ОбластьМакета, 2);
			КонецЦикла;
			ОбластьОбъединения = Таб.Область(Таб.ВысотаТаблицы, 1, Таб.ВысотаТаблицы, 2 + 2*СписокВидовЦенМатериалов.Количество());
			ОбластьОбъединения.Объединить();
			
			// Фактура
			ВыборкаФактур = ВыборкаГруппФактур.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаФактур.Следующий() Цикл
				Фактура = ВыборкаФактур.Фактура;
				
				ОбластьМакета = Макет.ПолучитьОбласть("СтрокаФактура|Данные");
				ОбластьМакета.Параметры.Заполнить(ВыборкаФактур);
				Таб.Вывести(ОбластьМакета, 3);
				ОбластьМакета = Макет.ПолучитьОбласть("СтрокаФактура|Цена");
				Для НомерЦены = 0 По СписокВидовЦенМатериалов.Количество()-1 Цикл
					Таб.Присоединить(ОбластьМакета, 3);
				КонецЦикла;
				ОбластьОбъединения = Таб.Область(Таб.ВысотаТаблицы, 1, Таб.ВысотаТаблицы, 2 + 2*СписокВидовЦенМатериалов.Количество());
				ОбластьОбъединения.Объединить();
				
				ВыборкаЦветов = ВыборкаФактур.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				Пока ВыборкаЦветов.Следующий() Цикл
					ЦветФактуры = ВыборкаЦветов.ЦветФактуры;
					
					ЦеныНоменклатуры = Новый Соответствие;
					ЦеныСФотоНоменклатуры = Новый Соответствие;
					ВыборкаЦены = ВыборкаЦветов.Выбрать();
					Пока ВыборкаЦены.Следующий() Цикл
						ЦеныНоменклатуры.Вставить(ВыборкаЦены.ВидЦены, ВыборкаЦены.Цена);
						ЦеныСФотоНоменклатуры.Вставить(ВыборкаЦены.ВидЦены, ВыборкаЦены.ЦенаСФотопечатью);
					КонецЦикла;
					
					ОбластьМакета = Макет.ПолучитьОбласть("Строка|Данные");
					ОбластьМакета.Параметры.ЦветФактуры = ЦветФактуры;
					Таб.Вывести(ОбластьМакета, 4);			
					Для НомерЦены = 0 По СписокВидовЦенМатериалов.Количество() - 1 Цикл
						ОбластьМакета = Макет.ПолучитьОбласть("Строка|Цена");
						ОбластьМакета.Параметры.Цена = ЦеныНоменклатуры.Получить(СписокВидовЦенМатериалов.Получить(НомерЦены).Значение);
						ОбластьМакета.Параметры.ЦенаСФотопечатью = ЦеныСФотоНоменклатуры.Получить(СписокВидовЦенМатериалов.Получить(НомерЦены).Значение);
						Таб.Присоединить(ОбластьМакета, 4);
					КонецЦикла;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;	
	КонецЦикла;
	
	Таб.ЗакончитьАвтогруппировкуСтрок();
		
КонецПроцедуры

