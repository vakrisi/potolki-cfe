&НаСервере
Процедура СформироватьНаСервереПродукция()
	
	СписокВидовЦен = Новый СписокЗначений;
	СтруктураПараметров = Новый Структура;	
	ИнициализацияПараметровОтчета(СписокВидовЦен, СтруктураПараметров);
	
	ТекОбъект = РеквизитФормыВЗначение("Отчет");
	Макет = ТекОбъект.ПолучитьМакет("МакетПотолки");
	МакетОсновной = ТекОбъект.ПолучитьМакет("Макет");
	
	Таб = Новый ТабличныйДокумент;
	Таб.КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ОтчетПрайсЛист_Потолки";
	
	ОбластьМакета = МакетОсновной.ПолучитьОбласть("ШапкаПрайса");
	ОбластьМакета.Параметры.Организация = Отчет.Организация;
	ОбластьМакета.Параметры.Дата = Формат(Отчет.Дата,"ДЛФ=ДД");
	Таб.Вывести(ОбластьМакета);
		
	ВывестиЦеныНаПродукцию(СтруктураПараметров, Макет, Таб);
	
	Результат = Таб;
	
КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервереВсе()
		
	СписокВидовЦен = Новый СписокЗначений;
	СтруктураПараметров = Новый Структура;	
	ИнициализацияПараметровОтчета(СписокВидовЦен, СтруктураПараметров);
	
	ТекОбъект = РеквизитФормыВЗначение("Отчет");
	Макет = ТекОбъект.ПолучитьМакет("Макет");
	Таб = Новый ТабличныйДокумент;
	Таб.КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ОтчетПрайсЛист";
	
	ОбластьМакета = Макет.ПолучитьОбласть("ШапкаПрайса");
	ОбластьМакета.Параметры.Организация = Отчет.Организация;
	ОбластьМакета.Параметры.Дата = Формат(Отчет.Дата,"ДЛФ=ДД");
	Таб.Вывести(ОбластьМакета);	
		
	//КОМПЛЕКТУЮЩИЕ
	ТабВрем = Новый ТабличныйДокумент;
	ВывестиКомплектующие(СтруктураПараметров, Макет, ТабВрем);
	ПрисоединитьТабличныйДокумент(Таб, ТабВрем);
		
	//ПОТОЛКИ
	ТабВрем = Новый ТабличныйДокумент;
	МакетПотолки = ТекОбъект.ПолучитьМакет("МакетПотолки");
	ВывестиЦеныНаПродукцию(СтруктураПараметров, МакетПотолки, ТабВрем);
	ПрисоединитьТабличныйДокумент(Таб, ТабВрем);
	
	//УСЛУГИ ПРОИЗВОДСТВА
	ТабВрем = Новый ТабличныйДокумент;
	Макет = ТекОбъект.ПолучитьМакет("МакетУслугиРаскроя");	
	ВывестиУслугиПроизводства(Отчет.Дата, СписокВидовЦен, Макет, ТабВрем);
	ПрисоединитьТабличныйДокумент(Таб, ТабВрем);
	
	Результат = Таб;
	
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
	
	// №6999 переделано на вызов стандартной проверки заполнения
	Если НЕ ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	//проверка перенесена в модуль объекта
	//Если Отчет.ИндивидуальныеЦены 
	//	И (НЕ ЗначениеЗаполнено(Отчет.Контрагент) ИЛИ НЕ ЗначениеЗаполнено(Отчет.ДоговорКонтрагента)) Тогда
	//	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен контрагент или договор");
	//КонецЕсли;
	
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаПрайсЛист;
	Если Отчет.ВидПрайсЛиста = 0 Тогда
		СформироватьНаСервереКомплектующие();
	ИначеЕсли Отчет.ВидПрайсЛиста = 1 Тогда
		СформироватьНаСервереПродукция();
	ИначеЕсли Отчет.ВидПрайсЛиста = 2 Тогда
		СформироватьНаСервереУслугиПроизводства();
	ИначеЕсли Отчет.ВидПрайсЛиста = 3 Тогда	
		СформироватьНаСервереВсе();
	КонецЕсли;
КонецПроцедуры

