#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Отчет.Валюта = Константы.ВалютаУчета.Получить();
	Отчет.Дата = ТекущаяДатаСеанса();
	
	ТЗ_ПорядокВидовЦен = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
								"ОтчетПрайсЛист",
								"ПорядокВидовЦен");
	
	Отчет.ОтборВидыЦен.Очистить();
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВидыЦен.Ссылка,
	|	999 КАК Порядок,
	|	ЛОЖЬ КАК Выбрать
	|ИЗ
	|	Справочник.ВидыЦен КАК ВидыЦен";
	//Выборка = Запрос.Выполнить().Выбрать();
	ТЗ_ВидыЦен = Запрос.Выполнить().Выгрузить();
	
	Если ТЗ_ПорядокВидовЦен <> Неопределено Тогда
		Для каждого ЭлементТЗ из ТЗ_ПорядокВидовЦен Цикл
			Отбор = Новый Структура("Ссылка", ЭлементТЗ.ВидЦены);
			НайденныеСтроки = ТЗ_ВидыЦен.НайтиСтроки(Отбор);
			Если НайденныеСтроки.Количество() > 0 Тогда
				Попытка
					НайденныеСтроки[0].Порядок = ЭлементТЗ.ПорядокЦены;
					НайденныеСтроки[0].Выбрать = ЭлементТЗ.Выбрать;
				Исключение
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;
		ТЗ_ВидыЦен.Сортировать("Порядок");		
	КонецЕсли;
	
	Для каждого ЭлементТЗ из ТЗ_ВидыЦен Цикл
		НоваяСтрока = Отчет.ОтборВидыЦен.Добавить();
		НоваяСтрока.ВидЦены = ЭлементТЗ.ССылка;
		НоваяСтрока.Выбрать = ЭлементТЗ.Выбрать;
	КонецЦикла;
	
	Элементы.ГруппаИндивидуальныеЦены.Видимость = ПолучитьФункциональнуюОпцию("ИспользоватьИндивидуальныеЦены");
	УправлениеВидимостьюПоИндивидуальнымЦенам();
	
	//#3642
	ТекОбъект = РеквизитФормыВЗначение("Отчет");
	СКДНоменклатура = ТекОбъект.ПолучитьМакет("СКДНоменклатура");
	ИнициализироватьКомпоновщикНастроек(СКДНоменклатура, КомпоновщикНастроекНоменклатура);
	СКДФактура = ТекОбъект.ПолучитьМакет("СКДФактура");
	ИнициализироватьКомпоновщикНастроек(СКДФактура, КомпоновщикНастроекФактура);
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	УправлениеВидимостьюПоВидуЦен();	
КонецПроцедуры

&НаСервере
Процедура ПриСохраненииДанныхВНастройкахНаСервере(Настройки)
	
	ТЗ_ПорядокВидовЦен = Отчет.ОтборВидыЦен.Выгрузить(, "НомерСтроки, Выбрать, ВидЦены");
	Если ТЗ_ПорядокВидовЦен.Количество() > 0 Тогда
		ТЗ_ПорядокВидовЦен.Колонки.НомерСтроки.Имя = "ПорядокЦены";
		ОбщегоНазначения.ХранилищеОбщихНастроекСохранить(
			"ОтчетПрайсЛист",
			"ПорядокВидовЦен",
			ТЗ_ПорядокВидовЦен);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьЭлементыФормы();
	
	// №6999 добавлено присвоение значения по умолчанию
	Если НЕ ЗначениеЗаполнено(Отчет.ВидНоменклатурыПотолки) Тогда
