&НаСервере
Функция ПолучитьСодержаниеЯчейки(пТабличныйДокумент, Строка, Колонка)	
	Если Колонка = 0 Тогда
		Возврат "";
	КонецЕсли;	
	мСодержание = пТабличныйДокумент.Область("R" + Формат(Строка,"ЧГ=") + "C" + Формат(Колонка,"ЧГ=")).Текст;	
	Возврат СокрЛП(мСодержание);
КонецФункции

&НаСервере
Функция РазложитьНаГруппыТоваровНаСервере()
	ТекОбъект = РеквизитФормыВЗначение("Отчет");
	МакетОсновной = ТекОбъект.ПолучитьМакет("Макет");
	ОбластьГруппа=МакетОсновной.ПолучитьОбласть("Группа");
	
	СписокПрайсов=Новый СписокЗначений;
	ТабДок = ЭтотОбъект.Результат;
	Для строка=1 по ТабДок.ВысотаТаблицы цикл
		колонка1 = ПолучитьСодержаниеЯчейки(ТабДок, Строка, 1);
		Если Колонка1="Фото товара" тогда
			СтрокаОкончанияЗаголовка=СТрока;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	ГруппаТоваров="";
	ЭтоПервыйТовар=Истина;
	НовыйТабДок=Новый ТабличныйДокумент;
	Для строка=СтрокаОкончанияЗаголовка+1 по ТабДок.ВысотаТаблицы цикл
		Колонка1=ПолучитьСодержаниеЯчейки(ТабДок, Строка, 1);
		Колонка2=ПолучитьСодержаниеЯчейки(ТабДок, Строка, 2);	  
		Если Колонка2="" Тогда
			Если ГруппаТоваров<>"" и НовыйТабДок.ВысотаТаблицы<>0 Тогда
				//НовыйТабДок.Показать();
				стр=Новый Структура("Наименование,Табдок",ГруппаТоваров,НовыйТабДок);
				// стр.наименование=ГруппаТоваров;
				//стр.табдок=НовыйТабДок;
				СписокПрайсов.Добавить(стр);
				НовыйТабДок=Новый ТабличныйДокумент;
				ЭтоПервыйТовар=Истина;
			КонецЕсли;
			ГруппаТоваров=Колонка1;
		Иначе
			Если ЭтоПервыйТовар тогда
				НовыйТабДок=Новый ТабличныйДокумент;
				НовыйТабДок.Вывести(ТабДок.ПолучитьОбласть(1,,СтрокаОкончанияЗаголовка,));
				ОбластьГруппа.Параметры.Номенклатура=ГруппаТоваров;
				НовыйТабДок.Вывести(ОбластьГруппа);
			КонецЕсли;
			НовыйТабДок.Вывести(ТабДок.ПолучитьОбласть(Строка,,Строка,));
			ЭтоПервыйТовар=Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат СписокПрайсов;
КонецФункции

&НаКлиенте
Процедура СохранитьПрайсВФайлExcelСЛистамиПоГруппам() Экспорт
	Если не ЗначениеЗаполнено(ИмяФайла) Тогда
		Сообщить("Не выбран файл. Действие не будет выполнено");
		Возврат;
	КонецЕсли;
	СписокПрайсов=Новый СписокЗначений;  
	
	массивПрайсов=СформироватьДляExcel();
	СписокПрайсов.ЗагрузитьЗначения(массивПрайсов);
	
	//ИмяФайла = КаталогВременныхФайлов() + "Прайс-лист от " + Формат(Отчет.Дата,"ДЛФ=Д") +".xlsx";
	ИмяВременногоФайлаШаблон = ПолучитьИмяВременногоФайла("XLSx");
	
	Эксель    = New COMObject("Excel.Application");
	
	Попытка
		ДвоичныеДанные = ПолучитьМакетНаСервере("ШаблонExcel");
		ДвоичныеДанные.Записать(ИмяВременногоФайлаШаблон);
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
	
	Книга = Эксель.Workbooks.Open(ИмяВременногоФайлаШаблон);   
	Позиция=3;
	Первый = Ложь;
	
	//Для защиты от дублей имен
	СооИмена = Новый СписокЗначений();
	
	//Перебираем отчеты в MXL
	Для Каждого Элемент ИЗ СписокПрайсов Цикл
		ТабДок=Элемент.Значение.ТабДок;
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла("XLSx");
		ТабДок.Записать(ИмяВременногоФайла, ТипФайлаТабличногоДокумента.XLSx); //Сохраняем в временный файл
		
		ТекКнига = Эксель.Workbooks.Open(ИмяВременногоФайла);  
		
		Если Первый Тогда 
			Книга = ТекКнига; //Первый файл и есть результат, чтобы сохранялись цвета
		Иначе
			ТекКнига.Sheets(1).Copy(, Книга.Sheets(Позиция)); //Copy(Before, After)
		КонецЕсли; 
		
		
		//Защита от одинаковых ярлыков
		ТекБазаНаименование =Элемент.Значение.Наименование;
		ТекНаименование = ТекБазаНаименование; СчНаименований = 2;
		ТекНаименование=стрзаменить(ТекНаименование,"/","|");
		Пока СооИмена.НайтиПоЗначению(ТекНаименование) <> Неопределено Цикл
			ТекНаименование = ТекБазаНаименование + "(" + СчНаименований + ")";
			СчНаименований = СчНаименований + 1;
		КонецЦикла;
		СооИмена.Добавить(ТекНаименование);
		Книга.Sheets(Позиция).Name = лев(ТекНаименование,31); //Переименовываем
		//Гиперссылка
		Лист=Книга.Sheets(Позиция) ;
		Range=Эксель.Range(Эксель.Cells(1,1),Эксель.ActiveCell.SpecialCells(11));
		Col=Range.Columns.Count;
		row=Range.Rows.Count;
		строка=1;
		Пока Строка<=row Цикл
			Если стрНАйти(Лист.cells(Строка,3).Text,"http")<>0 Тогда
				//Лист.Hyperlinks.Add(Лист.Cells(Строка, 2), Лист.cells(Строка,2).Text, Лист.cells(Строка,2).Text);
				Лист.Hyperlinks.Add(Лист.Range(Лист.Cells(Строка, 1),Лист.Cells(Строка, 2)), Лист.cells(Строка,3).Text, Лист.cells(Строка,1).Text);
				Лист.cells(Строка,3).Value = "";
			КонецЕсли;
			строка=Строка+1;
		КонецЦикла;
		
		Лист.Hyperlinks.Add(Лист.Cells(1,4),"https://optceiling.ru/zastrojshhikam/","Индивидуальные цены на объекты");
		Лист.Hyperlinks.add(Лист.cells(1,2),"","Содержание!R1C1"); 
		
		
		
		Если Первый Тогда
			//Делаем доступными ярлыки листов
			Эксель.ActiveWindow.DisplayWorkbookTabs = 1; 
			Эксель.ActiveWindow.TabRatio = 0.6;  
			Первый = ложь;
		Иначе
			ТекКнига.Close();
		КонецЕсли;
		Позиция=Позиция+1;
		
		
	КонецЦикла;
	
	ЛистСодержание=Книга.Sheets(1);
	row=11;
	Для каждого НазваниеЛиста из СооИмена ЦИкл
		ЛистСодержание.cells(row,2).Value=НазваниеЛиста.Значение;
		ЛистСодержание.Hyperlinks.add(ЛистСодержание.cells(row,2),"","'"+лев(НазваниеЛиста.Значение,31)+"'!R1C1"); 
		row=row+1;	
	КонецЦикла;
	
	//Удаляем, чтобы не переспрашивал
	Файл = Новый Файл(ИмяФайла);
	Если Файл.Существует() Тогда
		УдалитьФайлы(ИмяФайла);
	КонецЕсли;
	
	Книга.SaveAs(ИмяФайла, 51); //xlWorkbookNormal -4143 Workbook normal 
	//ActiveWindow.TabRatio = 0
	Книга.Close();
	Попытка
		ЗапуститьПриложение(ИмяФайла);
	Исключение
	КОнецПопытки;
КонецПроцедуры

&НаСервере
Функция СформироватьДляExcel()
	СписокТаб=Новый Массив;
	
	
	СписокВидовЦен = Новый СписокЗначений;
	СтруктураПараметров = Новый Структура;	
	ИнициализацияПараметровОтчета(СписокВидовЦен, СтруктураПараметров);
	
	ТекОбъект = РеквизитФормыВЗначение("Отчет");
	Макет = ТекОбъект.ПолучитьМакет("МакетExcel");
	ВывестиКомплектующиеExcel(СтруктураПараметров, Макет,СписокТаб);	
	тз=ПреобразоватьМассивВТаблицуЗначений(СписокТаб);
	тз.Сортировать("Позиция");
	СписокТаб=ОбщегоНазначения.ТаблицаЗначенийВМассив(тз);	
	Возврат СПисокТаб;
КонецФункции

&НаСервере
Процедура ВывестиКомплектующиеExcel(СтруктураПараметров, Макет, СписокТаб)
	ТабШаблон=Новый ТабличныйДокумент;
	ТабШаблон.КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ОтчетПрайсЛист";
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
	ТабШаблон.Вывести(ОбластьМакета);	
	ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаблицы|Основное");
	ТабШаблон.Вывести(ОбластьМакета);
	Для каждого ВидЦен из СтруктураПараметров.СписокВидовЦен Цикл
		ОбластьМакета=Макет.ПолучитьОбласть("ШапкаТаблицы|Цена");
		Если ВидЦен.Значение.Наименование = "БП1" Тогда
			ОбластьМакета.параметры.Видцены=Строка("дилер");
		ИначеЕсли ВидЦен.Значение.Наименование = "Розничный прайс" Тогда
			ОбластьМакета.параметры.Видцены=Строка("розница");
		Иначе	
			ОбластьМакета.параметры.Видцены=Строка(ВидЦен);
		КонецЕсли;	
		ТабШаблон.Присоединить(ОбластьМакета);
	КонецЦикла;
	
	
	Запрос = Новый Запрос;	
	Запрос.УстановитьПараметр("Период", 				КонецДня(СтруктураПараметров.ДатаОтчета));
	Запрос.УстановитьПараметр("ВидЦены", 				СтруктураПараметров.СписокВидовЦен);
	Запрос.УстановитьПараметр("Номенклатура", 			СтруктураПараметров.СписокДляОтбораНоменклатуры);
	Запрос.УстановитьПараметр("Валюта", 				СтруктураПараметров.Валюта);
	Запрос.УстановитьПараметр("НеПоказыватьНулевыеЦены", НЕ СтруктураПараметров.ПоказыватьНулевыеЦены);
	
	Запрос.УстановитьПараметр("ИспользоватьИндивидуальныеЦены",	Отчет.ИндивидуальныеЦены);
	Запрос.УстановитьПараметр("Контрагент",				Отчет.Контрагент);
	Запрос.УстановитьПараметр("ДоговорКонтрагента",		Отчет.ДоговорКонтрагента);
	Запрос.УстановитьПараметр("СвойствоUrlТовара",		ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Заголовок","Url"));

	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЦеныНоменклатурыИндивидуальныеСрезПоследних.Номенклатура КАК Номенклатура,
	|	ЦеныНоменклатурыИндивидуальныеСрезПоследних.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ЦеныНоменклатурыИндивидуальныеСрезПоследних.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ЦеныНоменклатурыИндивидуальныеСрезПоследних.Валюта КАК Валюта,
	|	ВЫБОР
	|		КОГДА ЦеныНоменклатурыИндивидуальныеСрезПоследних.ВидЦены = ЗНАЧЕНИЕ(Справочник.ВидыЦен.ПустаяСсылка)
	|			ТОГДА ЦеныНоменклатурыИндивидуальныеСрезПоследних.Цена
	|		ИНАЧЕ ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, 0)
	|	КОНЕЦ КАК Цена,
	|	ЦеныНоменклатурыИндивидуальныеСрезПоследних.Отменена КАК Отменена
	|ПОМЕСТИТЬ ВТ_ИндивидуальныеЦены
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатурыИндивидуальные.СрезПоследних(
	|			&Период,
	|			Контрагент = &Контрагент
	|				И ДоговорКонтрагента = &ДоговорКонтрагента
	|				И Номенклатура В ИЕРАРХИИ (&Номенклатура)
	|				И Валюта = &Валюта) КАК ЦеныНоменклатурыИндивидуальныеСрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|				&Период,
	|				Номенклатура В ИЕРАРХИИ (&Номенклатура)
	|					И Валюта = &Валюта) КАК ЦеныНоменклатурыСрезПоследних
	|		ПО ЦеныНоменклатурыИндивидуальныеСрезПоследних.Номенклатура = ЦеныНоменклатурыСрезПоследних.Номенклатура
	|			И ЦеныНоменклатурыИндивидуальныеСрезПоследних.ХарактеристикаНоменклатуры = ЦеныНоменклатурыСрезПоследних.ХарактеристикаНоменклатуры
	|			И ЦеныНоменклатурыИндивидуальныеСрезПоследних.ЕдиницаИзмерения = ЦеныНоменклатурыСрезПоследних.ЕдиницаИзмерения
	|			И ЦеныНоменклатурыИндивидуальныеСрезПоследних.ВидЦены = ЦеныНоменклатурыСрезПоследних.ВидЦены
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВидыЦен.Ссылка КАК ВидЦены,
	|	ВЫБОР
	|		КОГДА ВидыЦен.СсылочныйВидЦены = ИСТИНА
	|			ТОГДА ЕСТЬNULL(ЦеныСсылочныхСрезПоследних.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка))
	|		ИНАЧЕ ЕСТЬNULL(ЦеныСрезПоследних.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка))
	|	КОНЕЦ КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА ВидыЦен.СсылочныйВидЦены = ИСТИНА
	|			ТОГДА ЕСТЬNULL(ЦеныСсылочныхСрезПоследних.ХарактеристикаНоменклатуры, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка))
	|		ИНАЧЕ ЕСТЬNULL(ЦеныСрезПоследних.ХарактеристикаНоменклатуры, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка))
	|	КОНЕЦ КАК ХарактеристикаНоменклатуры,
	|	ВЫБОР
	|		КОГДА ВидыЦен.СсылочныйВидЦены = ИСТИНА
	|			ТОГДА ЕСТЬNULL(ЦеныСсылочныхСрезПоследних.ЕдиницаИзмерения, НЕОПРЕДЕЛЕНО)
	|		ИНАЧЕ ЕСТЬNULL(ЦеныСрезПоследних.ЕдиницаИзмерения, НЕОПРЕДЕЛЕНО)
	|	КОНЕЦ КАК ЕдиницаИзмерения,
	|	ВЫБОР
	|		КОГДА ВидыЦен.СсылочныйВидЦены = ИСТИНА
	|			ТОГДА ЕСТЬNULL(ЦеныСсылочныхСрезПоследних.Валюта, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка))
	|		ИНАЧЕ ЕСТЬNULL(ЦеныСрезПоследних.Валюта, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка))
	|	КОНЕЦ КАК Валюта,
	|	ВЫБОР
	|		КОГДА ВидыЦен.СсылочныйВидЦены = ИСТИНА
	|			ТОГДА ЕСТЬNULL(ЦеныСсылочныхСрезПоследних.Цена, 0)
	|		ИНАЧЕ ЕСТЬNULL(ЦеныСрезПоследних.Цена, 0)
	|	КОНЕЦ КАК Цена
	|ПОМЕСТИТЬ ВТ_ЦеныВрем
	|ИЗ
	|	Справочник.ВидыЦен КАК ВидыЦен
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&Период, Валюта = &Валюта) КАК ЦеныСрезПоследних
	|		ПО (ЦеныСрезПоследних.ВидЦены = ВидыЦен.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&Период, Валюта = &Валюта) КАК ЦеныСсылочныхСрезПоследних
	|		ПО (ЦеныСсылочныхСрезПоследних.ВидЦены = ВидыЦен.ВидЦеныНоменклатуры)
	|ГДЕ
	|	ВидыЦен.Ссылка В(&ВидЦены)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_ЦеныВрем.Номенклатура КАК Номенклатура,
	|	ВТ_ЦеныВрем.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ВТ_ЦеныВрем.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ВТ_ЦеныВрем.ВидЦены КАК ВидЦены,
	|	ВЫБОР
	|		КОГДА НЕ ВТ_ИндивидуальныеЦены.Цена ЕСТЬ NULL
	|			ТОГДА ВЫБОР
	|					КОГДА НЕ ВТ_ИндивидуальныеЦены.Отменена
	|						ТОГДА ВТ_ИндивидуальныеЦены.Цена
	|					ИНАЧЕ ВТ_ЦеныВрем.Цена
	|				КОНЕЦ
	|		ИНАЧЕ ВТ_ЦеныВрем.Цена
	|	КОНЕЦ КАК Цена
	|ПОМЕСТИТЬ ВТ_Цены
	|ИЗ
	|	ВТ_ЦеныВрем КАК ВТ_ЦеныВрем
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ИндивидуальныеЦены КАК ВТ_ИндивидуальныеЦены
	|		ПО (&ИспользоватьИндивидуальныеЦены)
	|			И ВТ_ЦеныВрем.Валюта = ВТ_ИндивидуальныеЦены.Валюта
	|			И ВТ_ЦеныВрем.ЕдиницаИзмерения = ВТ_ИндивидуальныеЦены.ЕдиницаИзмерения
	|			И ВТ_ЦеныВрем.Номенклатура = ВТ_ИндивидуальныеЦены.Номенклатура
	|			И ВТ_ЦеныВрем.ХарактеристикаНоменклатуры = ВТ_ИндивидуальныеЦены.ХарактеристикаНоменклатуры
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_ИндивидуальныеЦены
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_ЦеныВрем
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СправочникНоменклатура.Ссылка КАК Номенклатура,
	|	ЕСТЬNULL(СправочникХарактеристикиНоменклатуры.Ссылка, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК ХарактеристикаНоменклатуры,
	|	ЕСТЬNULL(ВТ_Цены.ЕдиницаИзмерения, СправочникНоменклатура.БазоваяЕдиницаИзмерения) КАК ЕдИзм,
	|	ЕСТЬNULL(ВТ_Цены.Цена, 0) КАК Цена,
	|	ВТ_Цены.ВидЦены КАК ВидЦены,
	|	ЕСТЬNULL(НоменклатураПрисоединенныеФайлы.ФайлХранилище, НЕОПРЕДЕЛЕНО) КАК ФайлХранилище,
	|	СправочникНоменклатура.Код КАК КодНоменклатуры,
	|	UrlsТоваров.Значение КАК Url
	|ИЗ
	|	Справочник.Номенклатура КАК СправочникНоменклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК СправочникХарактеристикиНоменклатуры
	|		ПО (СправочникХарактеристикиНоменклатуры.Владелец = СправочникНоменклатура.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Цены КАК ВТ_Цены
	|		ПО СправочникНоменклатура.Ссылка = ВТ_Цены.Номенклатура
	|			И (ЕСТЬNULL(СправочникХарактеристикиНоменклатуры.Ссылка, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) = ВТ_Цены.ХарактеристикаНоменклатуры)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НоменклатураПрисоединенныеФайлы КАК НоменклатураПрисоединенныеФайлы
	|		ПО (НоменклатураПрисоединенныеФайлы.ВладелецФайла = СправочникНоменклатура.Ссылка)
