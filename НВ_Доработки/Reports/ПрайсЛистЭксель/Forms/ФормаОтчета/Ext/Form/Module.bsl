&НаКлиенте
Процедура ОтправитьНаПечать(Команда)
	
	КоллекцияПечатныхФорм = УправлениеПечатьюКлиент.НоваяКоллекцияПечатныхФорм("ПрайсЛист");
	ПечатнаяФорма = УправлениеПечатьюКлиент.ОписаниеПечатнойФормы(КоллекцияПечатныхФорм, "ПрайсЛист");
	ПечатнаяФорма.СинонимМакета = "ПрайсЛист";
	ПечатнаяФорма.ТабличныйДокумент = Результат;
	ПечатнаяФорма.ИмяФайлаПечатнойФормы = "ПрайсЛист";
	
	ОбластиОбъектов = Новый СписокЗначений;
	
	УправлениеПечатьюКлиент.ПечатьДокументов(КоллекцияПечатныхФорм, ОбластиОбъектов);

КонецПроцедуры

&НаСервере
Функция ОтправитьПоПочтеНаСервере()
	
	ЗаголовокНовогоПисьма = "Прайс-лист от " + Формат(Отчет.Дата,"ДЛФ=Д") + " компании " + Отчет.Организация.Наименование;
	
	ТекстПисьма = "Добрый день!
	| Высылаем вам прайс-лист.";	
	
	НовоеПисьмо = РаботаСЭлектроннойПочтой.СформироватьЭлектронноеПисьмо(ЗаголовокНовогоПисьма, , ТекстПисьма);
	
	Возврат НовоеПисьмо;				
				
КонецФункции

&НаКлиенте
Процедура ОтправитьПоПочте(Команда)
	Если Отчет.Организация.Пустая() Тогда 
		ПоказатьПредупреждение(,"Не указана организация");
	Иначе
		//Если Отчет.ВыводитьКартинки Тогда 
		//	
		//	ПоказатьПредупреждение(, "Файл прайс-листа с картинками будет большим и не сможет быть отправлен по почте.
		//								|Сформируйте прайс без картинок и повторите отправку по почте");
		//	Элементы.ГруппаОтправить.Доступность = Ложь;
		//	
		//Иначе
			
			НовоеПисьмо = ОтправитьПоПочтеНаСервере();
			
			НазваниеОрганизации = СтрЗаменить(Отчет.Организация,"""","");
			ИмяФайла = КаталогВременныхФайлов() + "Прайс-лист от " + Формат(Отчет.Дата,"ДЛФ=Д") + " компании " + НазваниеОрганизации + ".xls";
			Результат.Записать(ИмяФайла,ТипФайлаТабличногоДокумента.XLS);
			ИмяБезРасширения = КаталогВременныхФайлов() + "Прайс-лист от " + Формат(Отчет.Дата,"ДЛФ=Д") + " компании " + НазваниеОрганизации; 
			Расширение = ".xls";
			
			ВложитьФайлНаСервере(НовоеПисьмо,ИмяБезРасширения,Расширение, ОбщийМодуль.Сериализовать(Новый ДвоичныеДанные(ИмяФайла)));
			
			ПараметрыНовойФормы = Новый Структура("Ключ", НовоеПисьмо);
			ОткрытьФорму("Документ.ЭлектронноеПисьмо.ФормаОбъекта",ПараметрыНовойФормы);
			
		//КонецЕсли;
	КонецЕсли;   	
КонецПроцедуры

