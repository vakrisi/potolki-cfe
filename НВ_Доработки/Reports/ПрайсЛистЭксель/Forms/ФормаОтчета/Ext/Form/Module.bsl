КонецФункции

&НаСервере
Процедура ВывестиТаблицуУслугРаскроя(ТаблицаДанных, Таб, Макет, ГруппаУслуг, ЗаголовокУслуг)
	
	//Если ТаблицаДанных[ГруппаУслуг].Количество() > 1 Тогда 
		//несколько услуг
		ОбластьМакета = Макет.ПолучитьОбласть("ГруппаУслуг");
		ОбластьМакета.Параметры.Услуга = ЗаголовокУслуг;
		Таб.Вывести(ОбластьМакета, 2, ГруппаУслуг, Истина);
		
		ТаблицаДанных[ГруппаУслуг].Сортировать("КоличествоДо Возр");
		Для Каждого ТекУслуга Из ТаблицаДанных[ГруппаУслуг] Цикл
			ОбластьМакета = Макет.ПолучитьОбласть("Услуга");
			ОбластьМакета.Параметры.Заполнить(ТекУслуга);
			//ОбластьМакета.Параметры.Услуга = ЗаголовокУслуг + " с " + ТекУслуга.КоличествоОт + " по " + ТекУслуга.КоличествоДо;
			//ОбластьМакета.Параметры.Цена = ТекУслуга.Цена;
			Таб.Вывести(ОбластьМакета, 3, ГруппаУслуг+1, Истина);
		КонецЦикла;
		
	//Иначе
	//	//одна услуга
