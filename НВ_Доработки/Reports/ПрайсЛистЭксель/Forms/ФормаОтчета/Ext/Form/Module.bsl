&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	СохраняемыеВНастройкахДанныеМодифицированы = Истина;
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ИнициализироватьКомпоновщикНастроек(МакетСКД, КомпоновщикНастроек)
	
	АдресВХ = ПоместитьВоВременноеХранилище(МакетСКД, УникальныйИдентификатор);
	ИсточникНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресВХ);
	КомпоновщикНастроек.Инициализировать(ИсточникНастроек);
	КомпоновщикНастроек.ЗагрузитьНастройки(МакетСКД.НастройкиПоУмолчанию);
	
КонецПроцедуры
	
&НаКлиенте
Процедура ОбновитьЭлементыФормы()
	
	Элементы.ГруппаОтборНоменклатуры.Видимость = Ложь;
	Элементы.ГруппаОтборФактуры.Видимость = Ложь;
	Элементы.ВыводитьКартинки.Видимость = Ложь;
	//Элементы.ДобавлятьФактуруВНазваниеЦвета.Видимость = Ложь;
	Элементы.ПоказыватьНулевыеЦены.Видимость = Истина;
	Элементы.ВидНоменклатурыПотолки.Видимость = Ложь;
	
	Если Отчет.ВидПрайсЛиста = 0 Тогда
		Элементы.ГруппаОтборНоменклатуры.Видимость = Истина;
		Элементы.ВыводитьКартинки.Видимость = Истина;
		
	ИначеЕсли Отчет.ВидПрайсЛиста = 1 Тогда
		Элементы.ГруппаОтборФактуры.Видимость = Истина;
		Элементы.ВидНоменклатурыПотолки.Видимость = Истина;
		//Элементы.ДобавлятьФактуруВНазваниеЦвета.Видимость = Истина;
	ИначеЕсли Отчет.ВидПрайсЛиста = 2 Тогда
		Элементы.ПоказыватьНулевыеЦены.Видимость = Ложь;
	ИначеЕсли Отчет.ВидПрайсЛиста = 3 Тогда
		Элементы.ГруппаОтборНоменклатуры.Видимость = Истина;
		Элементы.ГруппаОтборФактуры.Видимость = Истина;
		Элементы.ВыводитьКартинки.Видимость = Истина;
		//Элементы.ВидНоменклатурыПотолки.Видимость = Истина;
		//Элементы.ДобавлятьФактуруВНазваниеЦвета.Видимость = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере 
Функция НайтиЦену(Выборка, СписокВидовЦен, НомерЦеныВСписке, ТаблицаСЦенами)
	
	ОтборЦены = Новый Структура;
	ОтборЦены.Вставить("Номенклатура", 	Выборка.Номенклатура);
	ОтборЦены.Вставить("ЕдИзм",			Выборка.ЕдИзм);
	ОтборЦены.Вставить("ВидЦены",		СписокВидовЦен.Получить(НомерЦеныВСписке).Значение);
	ОтборЦены.Вставить("ХарактеристикаНоменклатуры",Выборка.ХарактеристикаНоменклатуры);
	НайденныеСтроки = ТаблицаСЦенами.НайтиСтроки(ОтборЦены);
	Если НайденныеСтроки.Количество() > 0 Тогда
		Возврат НайденныеСтроки[0].Цена;
	КонецЕсли;
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Процедура СформироватьНаСервереУслугиПроизводства()
	
	СписокВидовЦен = Новый СписокЗначений;
	СтруктураПараметров = Новый Структура;	
	ИнициализацияПараметровОтчета(СписокВидовЦен, СтруктураПараметров);
	
	ТекОбъект = РеквизитФормыВЗначение("Отчет");
	Макет = ТекОбъект.ПолучитьМакет("МакетУслугиРаскроя");	
	МакетОсновной = ТекОбъект.ПолучитьМакет("Макет");
	
	Таб = Новый ТабличныйДокумент;
	Таб.КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ОтчетПрайсЛист_УслугиРаскроя";
	Таб.НачатьАвтогруппировкуСтрок();
	
	ОбластьМакета = МакетОсновной.ПолучитьОбласть("ШапкаПрайса");
	ОбластьМакета.Параметры.Организация = Отчет.Организация;
	ОбластьМакета.Параметры.Дата = Формат(Отчет.Дата,"ДЛФ=ДД");
	Таб.Вывести(ОбластьМакета);
	
	ВывестиУслугиПроизводства(Отчет.Дата, СписокВидовЦен, Макет, Таб);
	
	Результат = Таб;
	
КонецПроцедуры

