Процедура НесколькоВидовЦенПриИзменении(Элемент)
	
	УправлениеВидимостьюПоВидуЦен();
	//Элементы.ГруппаОтборВидыЦен.Видимость = Отчет.НесколькоВидовЦен;
	//Элементы.ВидЦен.Видимость = НЕ Отчет.НесколькоВидовЦен;
	Если Отчет.НесколькоВидовЦен Тогда
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаОтборВидыЦен;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УправлениеВидимостьюПоВидуЦен()
	
	Элементы.ГруппаОтборВидыЦен.Видимость = Отчет.НесколькоВидовЦен;
	Элементы.ВидЦен.Видимость = НЕ Отчет.НесколькоВидовЦен;
	
КонецПроцедуры

&НаСервере
Процедура УправлениеВидимостьюПоИндивидуальнымЦенам()
	
	Элементы.ГруппаИндивидуальныеЦеныКонтрагент.Видимость = Отчет.ИндивидуальныеЦены;
	Элементы.НесколькоВидовЦен.Видимость = НЕ Отчет.ИндивидуальныеЦены;
	Если Отчет.ИндивидуальныеЦены Тогда
		Отчет.НесколькоВидовЦен = Ложь;
		УправлениеВидимостьюПоВидуЦен();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаВидыЦенВыбратьВсе(Команда)
	Для Каждого ТекЦена Из Отчет.ОтборВидыЦен Цикл
		ТекЦена.Выбрать = Истина;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура КомандаВидыЦенОтменитьВыборВсех(Команда)
	Для Каждого ТекЦена Из Отчет.ОтборВидыЦен Цикл
		ТекЦена.Выбрать = Ложь;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция ПолучитьМассивСсылокПоОтбору(МакетСКД, КомпоновщикНастроек, НаименованиеКолонки)
	
	НастройкиКомпоновки = КомпоновщикНастроек.ПолучитьНастройки();
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(МакетСКД, НастройкиКомпоновки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ТЗ = новый ТаблицаЗначений;
	ПроцессорВывода.УстановитьОбъект(ТЗ);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	Возврат ТЗ.ВыгрузитьКолонку(НаименованиеКолонки);
	 	
КонецФункции
	
&НаСервере
Процедура ИнициализацияПараметровОтчета(СписокВидовЦен, СтруктураПараметров)
	
	Если Отчет.Дата = Дата(1,1,1) Тогда
		Отчет.Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Если НЕ Отчет.НесколькоВидовЦен Тогда
		СписокВидовЦен.Добавить(Отчет.ВидЦен);
	Иначе
		Для Каждого ТекущаяСтрока Из Отчет.ОтборВидыЦен Цикл
			Если ТекущаяСтрока.Выбрать Тогда
				СписокВидовЦен.Добавить(ТекущаяСтрока.ВидЦены);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ТекОбъект = РеквизитФормыВЗначение("Отчет");
	СКДНоменклатура = ТекОбъект.ПолучитьМакет("СКДНоменклатура");
	СКДФактура 		= ТекОбъект.ПолучитьМакет("СКДФактура");
	СписокДляОтбораНоменклатуры = ПолучитьМассивСсылокПоОтбору(СКДНоменклатура, КомпоновщикНастроекНоменклатура, "Номенклатура");
	СписокДляОтбораФактур 		= ПолучитьМассивСсылокПоОтбору(СКДФактура, КомпоновщикНастроекФактура, "Фактура");
	
	//СписокДляОтбораНоменклатуры = Новый СписокЗначений;
	//Для Каждого ТекущаяСтрока Из Отчет.ОтборГруппНоменклатуры Цикл
	//	СписокДляОтбораНоменклатуры.Добавить(ТекущаяСтрока.Номенклатура);
	//КонецЦикла;
	Если СписокДляОтбораНоменклатуры.Количество() = 0 Тогда
		СписокДляОтбораНоменклатуры.Добавить(Справочники.Номенклатура.ПустаяСсылка());
	КонецЕсли;
	
	//СписокДляОтбораФактур = Новый СписокЗначений;
	//Для Каждого ТекущаяСтрока Из Отчет.ОтборГруппФактуры Цикл
	//	СписокДляОтбораФактур.Добавить(ТекущаяСтрока.Фактура);
	//КонецЦикла;
	//Если СписокДляОтбораФактур.Количество() = 0 Тогда
	//	СписокДляОтбораФактур.Добавить(Справочники.Фактура.ПустаяСсылка());
	//КонецЕсли;	
	
	Если НЕ СтруктураПараметров = Неопределено Тогда
		СтруктураПараметров.Вставить("ДатаОтчета", 					Отчет.Дата);
		СтруктураПараметров.Вставить("СписокВидовЦен", 				СписокВидовЦен);
		СтруктураПараметров.Вставить("СписокДляОтбораНоменклатуры", СписокДляОтбораНоменклатуры);
		СтруктураПараметров.Вставить("СписокДляОтбораФактур", 		СписокДляОтбораФактур);
		СтруктураПараметров.Вставить("Валюта", 						Отчет.Валюта);
		СтруктураПараметров.Вставить("ПоказыватьНулевыеЦены", 		Отчет.ПоказыватьНулевыеЦены);
		СтруктураПараметров.Вставить("ВидНоменклатурыПотолки",		Отчет.ВидНоменклатурыПотолки);
	КонецЕсли;

КонецПроцедуры

#Область ЦеныУслугПроизводства

&НаСервере
Функция ТекстЗапросаЦенУслугРаскроя()
	Возврат
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СправочникВидыЦен.Ссылка КАК ВидЦены,
	|	ВЫБОР
	|		КОГДА СправочникВидыЦен.СсылочныйВидЦены = ИСТИНА
	|			ТОГДА СправочникВидыЦен.ВидЦеныНаУслугиПроизводства
	|		ИНАЧЕ СправочникВидыЦен.Ссылка
	|	КОНЕЦ КАК ВидЦеныРасчетный
	|ПОМЕСТИТЬ ВТ_ВидыЦен
	|ИЗ
	|	Справочник.ВидыЦен КАК СправочникВидыЦен
	|ГДЕ
	|	СправочникВидыЦен.Ссылка В(&ВидЦены)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СоответствиеВидовЦенЦенамУслугРаскрояСрезПоследних.Валюта КАК Валюта,
	//|	СоответствиеВидовЦенЦенамУслугРаскрояСрезПоследних.ЦеныУслугРаскроя.ВидЦен КАК ВидЦен,
	|	ВТ_ВидыЦен.ВидЦены КАК ВидЦены,
	|	СоответствиеВидовЦенЦенамУслугРаскрояСрезПоследних.ЦеныУслугРаскроя.Углы.(
	|		Ссылка КАК Ссылка,
	|		НомерСтроки КАК НомерСтроки,
	|		КоличествоОт КАК КоличествоОт,
	|		КоличествоДо КАК КоличествоДо,
	|		Цена КАК Цена,
	|		Номенклатура КАК Номенклатура
	|	) КАК Углы,
	|	СоответствиеВидовЦенЦенамУслугРаскрояСрезПоследних.ЦеныУслугРаскроя.ВырезыApply.(
	|		Ссылка КАК Ссылка,
	|		НомерСтроки КАК НомерСтроки,
	|		КоличествоОт КАК КоличествоОт,
	|		КоличествоДо КАК КоличествоДо,
	|		Цена КАК Цена,
	|		Номенклатура КАК Номенклатура
	|	) КАК ВырезыApply,
	|	СоответствиеВидовЦенЦенамУслугРаскрояСрезПоследних.ЦеныУслугРаскроя.Фотопечать.(
	|		Ссылка КАК Ссылка,
	|		НомерСтроки КАК НомерСтроки,
	|		КоличествоОт КАК КоличествоОт,
	|		КоличествоДо КАК КоличествоДо,
	|		Цена КАК Цена,
	|		Номенклатура КАК Номенклатура
	|	) КАК Фотопечать,
	|	СоответствиеВидовЦенЦенамУслугРаскрояСрезПоследних.ЦеныУслугРаскроя.ДлинаШвов.(
	|		Ссылка КАК Ссылка,
	|		НомерСтроки КАК НомерСтроки,
	|		КоличествоОт КАК КоличествоОт,
	|		КоличествоДо КАК КоличествоДо,
	|		Цена КАК Цена,
	|		Номенклатура КАК Номенклатура
	|	) КАК ДлинаШвов,
	|	СоответствиеВидовЦенЦенамУслугРаскрояСрезПоследних.ЦеныУслугРаскроя.ДлинаПользовательскихШвов.(
	|		Ссылка КАК Ссылка,
	|		НомерСтроки КАК НомерСтроки,
	|		КоличествоОт КАК КоличествоОт,
	|		КоличествоДо КАК КоличествоДо,
	|		Цена КАК Цена,
	|		Номенклатура КАК Номенклатура
	|	) КАК ДлинаПользовательскихШвов,
	|	СоответствиеВидовЦенЦенамУслугРаскрояСрезПоследних.ЦеныУслугРаскроя.ВнутренниеВырезы.(
	|		Ссылка КАК Ссылка,
	|		НомерСтроки КАК НомерСтроки,
	|		КоличествоОт КАК КоличествоОт,
	|		КоличествоДо КАК КоличествоДо,
	|		Цена КАК Цена,
	|		Номенклатура КАК Номенклатура
	|	) КАК ВнутренниеВырезы,
	|	СоответствиеВидовЦенЦенамУслугРаскрояСрезПоследних.ЦеныУслугРаскроя.Кривые.(
	|		Ссылка КАК Ссылка,
	|		НомерСтроки КАК НомерСтроки,
	|		КоличествоОт КАК КоличествоОт,
	|		КоличествоДо КАК КоличествоДо,
	|		Цена КАК Цена,
	|		Номенклатура КАК Номенклатура
	|	) КАК Кривые,
	|	СоответствиеВидовЦенЦенамУслугРаскрояСрезПоследних.ЦеныУслугРаскроя.ДлинаШвовМногофактурный.(
	|		Ссылка КАК Ссылка,
	|		НомерСтроки КАК НомерСтроки,
	|		КоличествоОт КАК КоличествоОт,
	|		КоличествоДо КАК КоличествоДо,
	|		Цена КАК Цена,
	|		Номенклатура КАК Номенклатура
	|	) КАК ДлинаШвовМногофактурный,
	|	СоответствиеВидовЦенЦенамУслугРаскрояСрезПоследних.ЦеныУслугРаскроя.СтоимостьУслугиЦентровкиШва КАК СтоимостьУслугиЦентровкиШва
	|ИЗ
	|	РегистрСведений.СоответствиеВидовЦенЦенамУслугРаскроя.СрезПоследних(
	|			&Период,
	//|			ВидЦен В (&ВидЦены) И
	|			ВЫБОР
	|				КОГДА &ОтборПоВалюте
	|					ТОГДА Валюта = &Валюта
	|				ИНАЧЕ ИСТИНА
	|			КОНЕЦ) КАК СоответствиеВидовЦенЦенамУслугРаскрояСрезПоследних
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ВидыЦен КАК ВТ_ВидыЦен
	|		ПО (ВТ_ВидыЦен.ВидЦеныРасчетный = СоответствиеВидовЦенЦенамУслугРаскрояСрезПоследних.ВидЦен)";
	
КонецФункции

