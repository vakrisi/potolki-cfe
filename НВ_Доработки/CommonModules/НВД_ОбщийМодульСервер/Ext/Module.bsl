#Область СБП

// Проверяет, может ли текущий пользователь создать ссылку СБП на указанную сумму по заказу.
//
// Ограничение задаётся константой "Максимальная сумма в ссылке СБП" и действует на заказ в целом:
// из лимита вычитается сумма ранее созданных по заказу ссылок, кроме отклонённых банком.
// Пользователю с правом "Разрешено создавать ссылки СБП сверх максимальной суммы" ограничение
// не выставляется. Незаполненная константа означает, что ограничение не задано.
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказПокупателя - заказ, по которому создаётся ссылка.
//  Сумма - Число - сумма создаваемой ссылки.
//
// Возвращаемое значение:
//  Структура:
//   * Разрешено   - Булево - можно ли создать ссылку на указанную сумму;
//   * ТекстОтказа - Строка - причина отказа, заполнена при Разрешено = Ложь;
//   * Лимит       - Число  - максимальная сумма из константы, 0 если ограничение не задано;
//   * СуммаСсылок - Число  - сумма действующих ссылок по заказу;
//   * Доступно    - Число  - сумма, на которую по заказу ещё можно создать ссылку.
//
Функция ПроверитьЛимитСуммыСсылкиСБП(Заказ, Сумма) Экспорт
	
	Результат = Новый Структура("Разрешено, ТекстОтказа, Лимит, СуммаСсылок, Доступно", Истина, "", 0, 0, 0);
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ОбщийМодульСервер.НастройкаПользователя("РазрешеноПревышатьМаксимальнуюСуммуСсылкиСБП") = Истина Тогда
		Возврат Результат;
	КонецЕсли;
	
	Лимит = Константы.НВД_МаксимальнаяСуммаВСсылкеСБП.Получить();
	
	Если НЕ ЗначениеЗаполнено(Лимит) Тогда //ограничение не настроено
		Возврат Результат;
	КонецЕсли;
	
	Результат.Лимит = Лимит;
	Результат.СуммаСсылок = СуммаДействующихСсылокСБППоЗаказу(Заказ);
	
	Доступно = Лимит - Результат.СуммаСсылок;
	Если Доступно < 0 Тогда
		Доступно = 0;
	КонецЕсли;
	Результат.Доступно = Доступно;
	
	Если Сумма <= Доступно Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат.Разрешено = Ложь;
	
	Если Результат.СуммаСсылок = 0 Тогда
		Результат.ТекстОтказа = "Максимальная сумма в ссылке СБП - " + ФорматСуммыСсылкиСБП(Лимит) + " руб.
			|Создать ссылку на большую сумму можно только с правом ""Разрешено создавать ссылки СБП сверх максимальной суммы"".";
	Иначе
		Результат.ТекстОтказа = "По заказу уже созданы ссылки СБП на сумму " + ФорматСуммыСсылкиСБП(Результат.СуммаСсылок) + " руб.
			|при максимальной сумме " + ФорматСуммыСсылкиСБП(Лимит) + " руб.
			|Доступно к созданию: " + ФорматСуммыСсылкиСБП(Доступно) + " руб.";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Сумма ссылок СБП, созданных по заказу и не отклонённых банком, - ожидающих оплаты и оплаченных.
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказПокупателя - заказ, по которому отбираются ссылки.
//
// Возвращаемое значение:
//  Число - сумма действующих ссылок.
//
Функция СуммаДействующихСсылокСБППоЗаказу(Заказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СБП_QRКоды.status КАК status,
	|	СБП_QRКоды.amount КАК amount
	|ИЗ
	|	РегистрСведений.СБП_QRКоды КАК СБП_QRКоды
	|ГДЕ
	|	СБП_QRКоды.Заказ = &Заказ";
	Запрос.УстановитьПараметр("Заказ", Заказ);
	
	СуммаСсылок = 0;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если СсылкаСБПОтклонена(Выборка.status) Тогда
			Продолжить;
		КонецЕсли;
		СуммаСсылок = СуммаСсылок + Выборка.amount;
	КонецЦикла;
	
	Возврат СуммаСсылок;
	
КонецФункции

// Признак того, что ссылка СБП оплачена не будет: отклонена, отозвана, просрочена или отменена.
//
// Статусы приходят от банка строками и записываются в регистр как есть, поэтому у разных банков
// различаются регистром и разделителями ("NOT_STARTED" у ГПБ, "NotStarted" у Точки). Сравнение
// нормализованное, всё, что не является явным отказом, считается ожидающим оплаты.
//
// Параметры:
//  Статус - Строка - статус ссылки из регистра сведений СБП_QRКоды.
//
// Возвращаемое значение:
//  Булево - Истина, если ссылка отклонена.
//
Функция СсылкаСБПОтклонена(Статус)
	
	НормализованныйСтатус = ВРег(СтрЗаменить(СокрЛП(Статус), "_", ""));
	
	Возврат СтрНайти(НормализованныйСтатус, "REJECT") > 0
		ИЛИ СтрНайти(НормализованныйСтатус, "REVOK") > 0
		ИЛИ СтрНайти(НормализованныйСтатус, "EXPIR") > 0
		ИЛИ СтрНайти(НормализованныйСтатус, "CANCEL") > 0;
	
КонецФункции

// Сумма для вывода в сообщении пользователю.
//
// Параметры:
//  Сумма - Число - форматируемая сумма.
//
// Возвращаемое значение:
//  Строка - сумма без незначащих нулей.
//
Функция ФорматСуммыСсылкиСБП(Сумма)
	
	Возврат Формат(Сумма, "ЧЦ=15; ЧДЦ=2; ЧРД=,; ЧН=0");
	
КонецФункции

#КонецОбласти
