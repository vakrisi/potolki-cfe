			ОстатокФонда = Выборка.ОстатокФонда;
			//Сальдо = Выборка.ОстатокПоЗаказу;
			//Гасим = Мин(Сальдо, ДенегОсталось);
			
			СальдоВал = ?(ПересчитыватьВВалюту,  ИА_ФП.ПересчитатьИзВалютыВВалюту1(Выборка.ОстатокПоЗаказу, ВалютаУПР, ВалютаДокумента, СтрокаКурсыВалют.КурсУпрУчета, СтрокаКурсыВалют.КурсДокумента, СтрокаКурсыВалют.КратностьУпрУчета, СтрокаКурсыВалют.КратностьДокумента), Выборка.ОстатокПоЗаказу);
			ГасимВал = Мин(СальдоВал, ДенегОсталосьПогаситьВал);
			
			Гасим = ?(ПересчитыватьВВалюту,  ИА_ФП.ПересчитатьИзВалютыВВалюту1(ГасимВал, ВалютаДокумента, ВалютаУПР, СтрокаКурсыВалют.КурсДокумента, СтрокаКурсыВалют.КурсУпрУчета, СтрокаКурсыВалют.КратностьДокумента, СтрокаКурсыВалют.КратностьУпрУчета), ГасимВал);
			Гасим = мин(Гасим, Выборка.ОстатокПоЗаказу);
			
			Фонд = Выборка.Фонд;
			Подразделение = Выборка.Подразделение;
			
			
			Проводка = ЭтотОбъект.Движения.ИА_СредстваВРезервеНаФондах.ДобавитьРасход();
			Проводка.Период     = ДатаОплаты;
			Если ФППоОрганизациям Тогда
				Проводка.Организация = ОрганизацияФП;
			КонецЕсли;
			Проводка.Фонд 	= Фонд;
			Проводка.Подразделение 	= Подразделение;
			Проводка.ЗП = ЗП;
			Если ПроводкаНал Тогда
				Проводка.СуммаНал = Гасим;
			Иначе
				Проводка.СуммаБезНал = Гасим;
			КонецЕсли;
			
			
			Проводка = ЭтотОбъект.Движения.ИА_СредстваНаФондах.ДобавитьРасход();
			Проводка.Период     = ДатаОплаты;
			Если ФППоОрганизациям Тогда
				Проводка.Организация = ОрганизацияФП;
			КонецЕсли;
			Проводка.Фонд 	= Фонд;       
