			Движение.Подразделение = стр.ПодразделениеДохода;
			Если ПроводкаНал тогда
				Движение.Сумманал = ?(ПересчитыватьВВалюту,  ИА_ФП.ПересчитатьИзВалютыВВалюту1(стр.Сумма, ВалютаДокумента, ВалютаУПР, СтрокаКурсыВалют.КурсДокумента, СтрокаКурсыВалют.КурсУпрУчета, СтрокаКурсыВалют.КратностьДокумента, СтрокаКурсыВалют.КратностьУпрУчета), стр.Сумма);
			Иначе
				Движение.СуммаБезнал = ?(ПересчитыватьВВалюту,  ИА_ФП.ПересчитатьИзВалютыВВалюту1(стр.Сумма, ВалютаДокумента, ВалютаУПР, СтрокаКурсыВалют.КурсДокумента, СтрокаКурсыВалют.КурсУпрУчета, СтрокаКурсыВалют.КратностьДокумента, СтрокаКурсыВалют.КратностьУпрУчета), стр.Сумма);	
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

