	Константы.НВД_sbp_client_secret.Установить(НаборКлючей.sbp_client_secret);
	Константы.НВД_sbp_account_code.Установить(НаборКлючей.sbp_account_code);
	Константы.НВД_sbp_merchant_id.Установить(НаборКлючей.sbp_merchant_id);
	Константы.НВД_sbp_legalId.Установить(НаборКлючей.sbp_legalId);
	Константы.НВД_sbp_customerCode.Установить(НаборКлючей.sbp_customerCode);
	
КонецПроцедуры

Функция ОбновитьТокенAPIБанкТочка(НаборКлючей) Экспорт
	
	СтрокаЗапроса = "/connect/token";
	
	СтрокаBodyParametrs = "client_id=" + НаборКлючей.client_id + "&client_secret=" + НаборКлючей.client_secret + "&grant_type=refresh_token&refresh_token=" + НаборКлючей.refreshtoken_hybrid;
	ЗаголовокHTTP = Новый Соответствие();
	ЗаголовокHTTP.Вставить("Content-Type", "application/x-www-form-urlencoded");
	ЗаголовокHTTP.Вставить("accept", "application/json");
	ЗаголовокHTTP.Вставить("type", "POST");
	ЗаголовокHTTP.Вставить("dataType", "json");
	
	Попытка
		Соединение = Новый HTTPСоединение("enter.tochka.com", 443,,,,,Новый ЗащищенноеСоединениеOpenSSL);
		HTTPЗапрос = Новый HTTPЗапрос(СтрокаЗапроса, ЗаголовокHTTP);
		HTTPЗапрос.УстановитьТелоИзСтроки(СтрокаBodyParametrs, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
		ОтветСервера = Соединение.ОтправитьДляОбработки(HTTPЗапрос); 
		ОтветСтрокой = ОтветСервера.ПолучитьТелоКакСтроку("UTF-8");
	
		Текст = НаборКлючей.account_code + "Запрос Точка банк. Обновить Токены. Код состояния: " + ОтветСервера.КодСостояния + ". Входящая информация: " + ОтветСтрокой + "";	
		Ответ = ОпределитьОтвет(ОтветСервера, Текст, ОтветСтрокой);
		НаборКлючей.refreshtoken_hybrid = Ответ.refresh_token;
		НаборКлючей.accesstoken_hybrid = Ответ.access_token;
	Исключение
		ТекстОшибки = "Связь с сервером не установлена " + ОписаниеОшибки() + "";
		Сообщить(ТекстОшибки, СтатусСообщения.Важное);
		ЗаписьЖурналаРегистрации(ТекстОшибки, УровеньЖурналаРегистрации.Ошибка);
	КонецПопытки;
	

	
	Возврат НаборКлючей;
	
	
КонецФункции	

Функция ПолучитьТокенБанкТочка(НаборКлючей) Экспорт
	
	Токен = НаборКлючей.accesstoken_hybrid; //время жизни токена может уже истекло, поэтому проверяем на работоспособность
	
	СтрокаЗапроса = "/connect/introspect";	
	//СтрокаBodyParametrs = "client_id=" + client_id + "&client_secret=" + client_secret + "&grant_type=refresh_token&refresh_token=" + refresh_token;
	СтрокаBodyParametrs = "access_token=" + НаборКлючей.accesstoken_hybrid;
	ЗаголовокHTTP = Новый Соответствие();
	ЗаголовокHTTP.Вставить("Content-Type", "application/x-www-form-urlencoded");
	ЗаголовокHTTP.Вставить("accept", "application/json");
	ЗаголовокHTTP.Вставить("type", "POST");
	ЗаголовокHTTP.Вставить("dataType", "json");
	ЗаголовокHTTP.Вставить("Authorization", "Bearer " + НаборКлючей.accesstoken_client);
	
	Попытка
		Соединение = Новый HTTPСоединение("enter.tochka.com", 443,,,,,Новый ЗащищенноеСоединениеOpenSSL);
		HTTPЗапрос = Новый HTTPЗапрос(СтрокаЗапроса, ЗаголовокHTTP);
		HTTPЗапрос.УстановитьТелоИзСтроки(СтрокаBodyParametrs, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
		ОтветСервера = Соединение.ОтправитьДляОбработки(HTTPЗапрос); 
	Исключение
		ТекстОшибки = "Связь с сервером не установлена " + ОписаниеОшибки() + "";
		Сообщить(ТекстОшибки, СтатусСообщения.Важное);
		ЗаписьЖурналаРегистрации(ТекстОшибки, УровеньЖурналаРегистрации.Ошибка);
	КонецПопытки;
	
	ОтветСтрокой = ОтветСервера.ПолучитьТелоКакСтроку("UTF-8");
	
	Текст = "Запрос Точка банк. Получение выписки. Код состояния: " + ОтветСервера.КодСостояния + ". Входящая информация: " + ОтветСтрокой + "";
	
	//JWT_DecodeAtServer(СтрЗаменить(ОтветСтрокой, """",""), Токен);
	
	Если СтрНайти(ОтветСтрокой,"Token not found") > 0 Тогда //токен не рабочий, обновляем его
		НаборКлючей = ОбновитьТокенAPIБанкТочка(НаборКлючей);
	КонецЕсли;	
	Возврат НаборКлючей;
	
КонецФункции	

#КонецОбласти

