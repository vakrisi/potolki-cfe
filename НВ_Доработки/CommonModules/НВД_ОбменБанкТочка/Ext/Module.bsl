Функция ПолучитьТипПлатежногоДокумента(TypeCode="") Экспорт
	
	ТипПлатежногоДокумента = Перечисления.ТипыПлатежныхДокументов.ПлатежноеПоручение; //значение по умолчанию
	Если TypeCode = "" Тогда
		ТипПлатежногоДокумента = Перечисления.ТипыПлатежныхДокументов.ПлатежноеПоручение;
	ИначеЕсли TypeCode = "Неопределенное значение" Тогда
		ТипПлатежногоДокумента = Перечисления.ТипыПлатежныхДокументов.ПлатежноеПоручение;
	ИначеЕсли TypeCode = "Платежное поручение" Тогда
		ТипПлатежногоДокумента = Перечисления.ТипыПлатежныхДокументов.ПлатежноеПоручение;	
	ИначеЕсли TypeCode = "Платежное требование" Тогда
		ТипПлатежногоДокумента = Перечисления.ТипыПлатежныхДокументов.ПлатежноеТребование;	
	ИначеЕсли TypeCode = "Денежный чек, РКО" Тогда
		ТипПлатежногоДокумента = Перечисления.ТипыПлатежныхДокументов.ПлатежныйОрдер;
	ИначеЕсли TypeCode = "Объявление на взнос наличными, ПКО" Тогда
		ТипПлатежногоДокумента = Перечисления.ТипыПлатежныхДокументов.ПлатежныйОрдер;
	ИначеЕсли TypeCode = "Требование-поручение" Тогда
		ТипПлатежногоДокумента = Перечисления.ТипыПлатежныхДокументов.ПлатежноеТребование;
	ИначеЕсли TypeCode = "Инкассовое поручение" Тогда
		ТипПлатежногоДокумента = Перечисления.ТипыПлатежныхДокументов.ИнкассовоеПоручение;
	ИначеЕсли TypeCode = "Расчетный чеке" Тогда
		ТипПлатежногоДокумента = Перечисления.ТипыПлатежныхДокументов.ПлатежныйОрдер;
	ИначеЕсли TypeCode = "Аккредитив" Тогда
		ТипПлатежногоДокумента = Перечисления.ТипыПлатежныхДокументов.Аккредитив;
	ИначеЕсли TypeCode = "Мемориальный ордер" Тогда
		ТипПлатежногоДокумента = Перечисления.ТипыПлатежныхДокументов.ПлатежныйОрдер;
	ИначеЕсли TypeCode = "Погашение кредита" Тогда
		ТипПлатежногоДокумента = Перечисления.ТипыПлатежныхДокументов.БанковскийОрдер;
	ИначеЕсли TypeCode = "Выдача кредита" Тогда
		ТипПлатежногоДокумента = Перечисления.ТипыПлатежныхДокументов.БанковскийОрдер;
	ИначеЕсли TypeCode = "Авизо" Тогда
		ТипПлатежногоДокумента = Перечисления.ТипыПлатежныхДокументов.БанковскийОрдер;
	ИначеЕсли TypeCode = "Банковские карты" Тогда
		ТипПлатежногоДокумента = Перечисления.ТипыПлатежныхДокументов.БанковскийОрдер;
	ИначеЕсли TypeCode = "Платежный ордер" Тогда
		ТипПлатежногоДокумента = Перечисления.ТипыПлатежныхДокументов.ПлатежныйОрдер;
	ИначеЕсли TypeCode = "Банковский ордер" Тогда
		ТипПлатежногоДокумента = Перечисления.ТипыПлатежныхДокументов.БанковскийОрдер;	
	ИначеЕсли TypeCode = "Ордер по передаче ценностей" Тогда
		ТипПлатежногоДокумента = Перечисления.ТипыПлатежныхДокументов.БанковскийОрдер;
	ИначеЕсли TypeCode = "Программный ордер" Тогда
		ТипПлатежногоДокумента = Перечисления.ТипыПлатежныхДокументов.БанковскийОрдер;
	ИначеЕсли TypeCode = "Импортированная запись" Тогда
		ТипПлатежногоДокумента = Перечисления.ТипыПлатежныхДокументов.БанковскийОрдер;
	Иначе
		ТипПлатежногоДокумента = Перечисления.ТипыПлатежныхДокументов.ПлатежноеПоручение;
	КонецЕсли;
	
	Возврат ТипПлатежногоДокумента;
КонецФункции	

Функция ПолучитьХозяйственнуюОперацию(КредитДебитИндикатор, НазначениеПлатежа) Экспорт
	НазначениеПлатежа = ВРег(НазначениеПлатежа);
	Если КредитДебитИндикатор = "Debit" Тогда
		Если (СтрНайти(НазначениеПлатежа, ВРег("Возврат ДС покупателю")) > 0) Тогда
			ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратОплатыКлиенту;
		ИначеЕсли (СтрНайти(НазначениеПлатежа, ВРег("Заработная плата по трудовому договору")) > 0) И (СтрНайти(НазначениеПлатежа, ВРег("согласно реестру зачислений"))) Тогда
			ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВыплатаЗаработнойПлатыПоВедомостям;
		ИначеЕсли СтрНайти(НазначениеПлатежа, ВРег("Заработная плата по трудовому договору")) > 0 Тогда
			ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВыплатаЗарплатыНаЛицевыеСчета;
		ИначеЕсли СтрНайти(НазначениеПлатежа, ВРег("другой счет")) > 0 Тогда
			ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПеречислениеДенежныхСредствНаДругойСчет;
		ИначеЕсли (СтрНайти(НазначениеПлатежа, ВРег("Налог")) > 0) ИЛИ (СтрНайти(НазначениеПлатежа, ВРег("Страховые взносы")) > 0) 
			ИЛИ (СтрНайти(НазначениеПлатежа, ВРег("Взносы в ФСС")) > 0) 
			ИЛИ (СтрНайти(НазначениеПлатежа, ВРег("НДФЛ")) > 0) Тогда
			ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПеречислениеВБюджет;
		ИначеЕсли СтрНайти(НазначениеПлатежа, ВРег("Подотчет")) > 0 Тогда
			ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВыдачаДенежныхСредствПодотчетнику;
		ИначеЕсли СтрНайти(НазначениеПлатежа, ВРег("")) > 0 Тогда
			ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ОплатаПоставщику;
		Иначе 
			ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПрочаяВыдачаДенежныхСредств;
		КонецЕсли;	
	ИначеЕсли КредитДебитИндикатор = "Credit" Тогда
		Если (СтрНайти(НазначениеПлатежа, ВРег("Возврат")) > 0) ИЛИ (СтрНайти(НазначениеПлатежа, ВРег("Возврат ДС покупателю")) > 0) Тогда
			ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратДенежныхСредствОтПоставщика;
		ИначеЕсли (СтрНайти(НазначениеПлатежа, ВРег("Подотчет")) > 0) Тогда
			ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратДенежныхСредствОтПодотчетника;
		ИначеЕсли (СтрНайти(НазначениеПлатежа, ВРег("Оплата по счету")) > 0)
			или (СтрНайти(НазначениеПлатежа, ВРег("Счет на оплату")) > 0) 
			или (СтрНайти(НазначениеПлатежа, ВРег("согласно сч.")) > 0) 
			или (СтрНайти(НазначениеПлатежа, ВРег("Оплата Заказа")) > 0)
			или (СтрНайти(НазначениеПлатежа, ВРег("Предоплата")) > 0)
			или (СтрНайти(НазначениеПлатежа, ВРег("Предоплата")) > 0) 
			или (СтрНайти(НазначениеПлатежа, ВРег("по счету")) > 0)
			или (СтрНайти(НазначениеПлатежа, ВРег("заказ")) > 0)
			или (СтрНайти(НазначениеПлатежа, ВРег("ОПЛАТА ПО СЧ")) > 0)
			или (СтрНайти(НазначениеПлатежа, ВРег("ПО QR КОДУ ID")) > 0)
			Тогда
			ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПоступлениеОплатыОтКлиента;
		Иначе 
			ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПрочееПоступлениеДенежныхСредств;
		Конецесли;
	КонецЕсли;
	Возврат ХозяйственнаяОперация; 
КонецФункции

Функция ПолучитьКонтрагента(Заказ="", ИНН="", КППКонтрагента="", НаименованиеКонтрагента="") Экспорт
	
	Если Не ЗначениеЗаполнено(Заказ) Тогда  //ищем контрагента по инн
		Контрагент = Справочники.Контрагенты.НайтиПоРеквизиту("ИНН", СОКРЛП(ИНН));
		Если Контрагент = Справочники.Контрагенты.ПустаяСсылка() Тогда //Создаем контрагента
			НовыйКонтрагент = Справочники.Контрагенты.СоздатьЭлемент();
			НовыйКонтрагент.ИНН = ИНН;
			НовыйКонтрагент.КПП = КППКонтрагента;
			НовыйКонтрагент.НаименованиеПолное = НаименованиеКонтрагента;
			Если СтрДлина(НовыйКонтрагент.ИНН) > 10 Тогда
				НовыйКонтрагент.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо;
				Если (СтрНайти(ВРег(НовыйКонтрагент.НаименованиеПолное), "ИП") > 0) ИЛИ (СтрНайти(ВРег(НовыйКонтрагент.НаименованиеПолное), "ИНДИВИДУАЛЬНЫЙ ПРЕДПРИНИМАТЕЛЬ") > 0) Тогда
					НовыйКонтрагент.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ИндивидуальныйПредприниматель;
				Иначе
					НовыйКонтрагент.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ФизЛицо;
				КонецЕсли;	
			Иначе
				НовыйКонтрагент.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо;
				НовыйКонтрагент.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо;
			Конецесли;
			Попытка
				НовыйКонтрагент.Записать(); 
				Контрагент = НовыйКонтрагент.Ссылка;
			Исключение
				ТекстОшибки = "Ошибка при записи нового контрагента " + ОписаниеОшибки() + "";
				Сообщить(ТекстОшибки, СтатусСообщения.Важное);
				ЗаписьЖурналаРегистрации(ТекстОшибки, УровеньЖурналаРегистрации.Ошибка);
				Контрагент = Справочники.Контрагенты.ПустаяСсылка();
			КонецПопытки;
		КонецЕсли;
		

	Иначе // ищем контрагента по заказу
		Контрагент = ПолучитьКонтрагентаВладельца(Заказ.Партнер);
	КонецЕсли;
	
	Возврат Контрагент;
КонецФункции

Функция ПолучитьСтатьюДДС(Документ) Экспорт
	
	СтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.ПустаяСсылка();
	
	Если Документ.КредитДебитИндикатор = "Debit" Тогда
		//Списание
		Если Документ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПеречислениеВБюджет Тогда
			НайденнаяСтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоНаименованию("Налог");
			Если НЕ НайденнаяСтатьяДДС = Неопределено Тогда
				СтатьяДДС = НайденнаяСтатьяДДС;
			Конецесли;
		ИначеЕсли Документ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратОплатыКлиенту Тогда
			СтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.ВозвратОплатыКлиенту;
		ИначеЕсли Документ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ОплатаПоставщику Тогда
			Если СтрНайти(ВРег(Документ.НазначениеПлатежа),"КОМИССИЯ ЗА ЗАЧИСЛЕНИЕ ПЕРЕВОДА ПО СБП") > 0 Тогда 
				НайденнаяСтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоНаименованию("Услуги банка");
				Если НЕ НайденнаяСтатьяДДС = Неопределено Тогда
					СтатьяДДС = НайденнаяСтатьяДДС;
				Конецесли;
			Иначе
				СтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.ОплатаПоставщику;	
			КонецЕсли;	
		ИначеЕсли Документ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВыдачаДенежныхСредствПодотчетнику Тогда
			НайденнаяСтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоНаименованию("Выдача ДС подотчетнику");
			Если НЕ НайденнаяСтатьяДДС = Неопределено Тогда
				СтатьяДДС = НайденнаяСтатьяДДС;
			Конецесли;
		ИначеЕсли Документ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПеречислениеДенежныхСредствНаДругойСчет Тогда
			СтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.ПеречислениеДенежныхСредствНаДругойСчет;
		ИначеЕсли Документ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВыплатаЗаработнойПлатыПоВедомостям Тогда
			СтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.ВыплатаЗаработнойПлаты;
		ИначеЕсли Документ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВыплатаЗаработнойПлатыРаботнику Тогда
			СтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.ВыплатаЗаработнойПлаты;
		Иначе
			СтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.ПустаяСсылка();
		КонецЕсли;	
	Иначе
		//приход
		Если Документ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратДенежныхСредствОтПодотчетника Тогда
			НайденнаяСтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоНаименованию("Оплата товаров");
			Если НЕ НайденнаяСтатьяДДС = Неопределено Тогда
				СтатьяДДС = НайденнаяСтатьяДДС;
			Конецесли;
		ИначеЕсли Документ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПоступлениеОплатыОтКлиента Тогда
			СтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.ПоступлениеОплатыОтКлиента;
		ИначеЕсли Документ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратДенежныхСредствОтПоставщика Тогда
			СтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.ВозвратДенежныхСредствОтПоставщика;
		Иначе
			Если СтрНайти(ВРег(Документ.НазначениеПлатежа), "ПЛАТЕЖНЫХ КАРТ ПО ТЕРМИНАЛУ") > 0 Тогда
				НайденнаяСтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоНаименованию("Эквайринг");
				Если НЕ НайденнаяСтатьяДДС = Неопределено Тогда
					СтатьяДДС = НайденнаяСтатьяДДС;
				КонецЕсли;
			ИначеЕсли СтрНайти(ВРег(Документ.НазначениеПлатежа), "ПО QR КОДУ ID") > 0 Тогда
				СтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.ПоступлениеОплатыОтКлиента;
			Конецесли;	
		КонецЕсли;	
	КонецЕсли;	
	Возврат СтатьяДДС;
КонецФункции

Функция ПолучитьВыпискуПоСчетуV3(Данные)
	
	ДатаНач = НачалоДня(ТекущаяДата()-60*60*24*3); //берем 10 дней, на тот случай если были выходные и если какая то из транзакций долго находится в статусе "в процессе"	 
	
	ДатаКон = КонецДня(ТекущаяДата());
	
	//ДатаНач = НачалоДня(Дата(2021,09,20));	 
	//
	//ДатаКон = КонецДня(Дата(2021,09,20));
	
	ТекстС = "Запуск API Точка банк. Запрос выписки по " + Данные.НаборКлючей.account_code;
	Сообщить(ТекстС);
	ЗаписьЖурналаРегистрации(ТекстС, УровеньЖурналаРегистрации.Информация);
	СтрокаЗапроса = "uapi/open-banking/v1.0/statements";	 //https://enter.tochka.com/uapi/open-banking/{apiVersion}/statements
	
	
	СтруктураСтр = Новый Структура; 
	СтруктураСтр.Вставить("accountId", Данные.НаборКлючей.account_code); //Номер счета	
	СтруктураСтр.Вставить("startDateTime", Формат(ДатаНач, "ДФ=yyyy-MM-dd"));         //"Дата окончания срока выписки, формат даты ГГГГ-ММ-ДД"
	СтруктураСтр.Вставить("endDateTime", Формат(КонецДня(ДатаКон), "ДФ=yyyy-MM-dd")); //"Дата начала срока выписки, формат даты ГГГГ-ММ-ДД"
	
	СтруктураStatement = Новый Структура;
	СтруктураStatement.Вставить("Statement", СтруктураСтр);
	
	СтруктураData = Новый Структура;
	СтруктураData.Вставить("Data", СтруктураStatement);
	
	СтрокаJSON = СформироватьСтрокуJSONИзСтруктуры(СтруктураData);
	
	HTTPОтвет = ПолучитьЗапрошенныйФайлPOST(СтрокаЗапроса,СтрокаJSON, , Данные.НаборКлючей.accesstoken_hybrid, Данные.НаборКлючей.account_code);
	
	ОтветСтрокой = HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8");
	Текст = "Запрос Точка банк. Получение выписки. Для организации " + Данные.Организация + ". Код состояния: " + HTTPОтвет.КодСостояния + ". Входящая информация: " + ОтветСтрокой + "";
	
	Ответ = ОпределитьОтвет(HTTPОтвет, Текст, ОтветСтрокой);
	
	Если СтрНайти(ОтветСтрокой,"token is missing") > 0 Тогда //токен не рабочий, обновляем его
		
		Данные.НаборКлючей = ЗначениеИзСтрокиВнутр(ЗначениеВСтрокуВнутр(ОбновитьТокенAPIБанкТочка(Данные.НаборКлючей)));
		HTTPОтвет = ПолучитьЗапрошенныйФайлPOST(СтрокаЗапроса,СтрокаJSON, , Данные.НаборКлючей.accesstoken_hybrid, Данные.НаборКлючей.account_code);
		
		ОтветСтрокой = HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8");
		Текст = "Запрос Точка банк. Получение выписки. Для организации " + Данные.Организация + ". Код состояния: " + HTTPОтвет.КодСостояния + ". Входящая информация: " + ОтветСтрокой + "";
		
		Ответ = ОпределитьОтвет(HTTPОтвет, Текст, ОтветСтрокой);
		
	КонецЕсли;
	
	Попытка
		request_id = Ответ.Data.Statement.statementId;
	Исключение
		Возврат ложь;
	КонецПопытки;	
	//Сообщить(request_id);          
	
	ОтветГотов = Ложь;
	ТекДата = ТекущаяДата();
	Инд = 2;
	Пока Истина Цикл
		
		Если ТекущаяДата() > (ТекДата + 20) ИЛИ ОтветГотов Тогда 
			
			Прервать;
			
		ИначеЕсли ТекущаяДата() = ТекДата+Инд Тогда 
			
			ТекстС = "Запуск API Точка банк. Статус запроса выписки";
			Сообщить(ТекстС);
			ЗаписьЖурналаРегистрации(ТекстС, УровеньЖурналаРегистрации.Информация);
			СтрокаЗапроса = "uapi/open-banking/v1.0/accounts/" + Данные.НаборКлючей.account_code + "/statements/"+request_id+"";	//https://enter.tochka.com/uapi/open-banking/{apiVersion}/accounts/{accountId}/statements/{statementId}
			
			СтруктураСтр = Новый Структура;
			СтрокаJSON = СформироватьСтрокуJSONИзСтруктуры(СтруктураСтр);
			
			HTTPОтвет = ПолучитьЗапрошенныйФайлPOST(СтрокаЗапроса,СтрокаJSON, "GET", Данные.НаборКлючей.accesstoken_hybrid, Данные.НаборКлючей.account_code);
			
			ОтветСтрокой = HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8");
			Текст = "Запрос Точка банк. Получение статуса выписки. Для организации " + Данные.Организация + ". Код состояния: " + HTTPОтвет.КодСостояния + ". Входящая информация: " + ОтветСтрокой + "";
			
			Если HTTPОтвет.КодСостояния = 200 Тогда
				
				Ответ = ОпределитьОтвет(HTTPОтвет, Текст, ОтветСтрокой);
				СтатусВыписки = Ответ.Data.Statement[0].status;
			
				ОтветГотов = СтатусВыписки = "Ready";
			Иначе
				ОтветГотов = Ложь;
				ЗаписьЖурналаРегистрации(Текст, УровеньЖурналаРегистрации.Информация);
			КонецЕсли;
			
			Инд = Инд + 2;
			
		КонецЕсли;	
		
	КонецЦикла;
	
	Чеки = Новый Массив;
	Если ОтветГотов Тогда
		
		Чеки = Ответ.Data.Statement[0].Transaction;
		
	КонецЕсли;	
	
	Для Каждого Документ Из Чеки Цикл
		
		ТекЗаказ = ПолучитьЗаказПоНомеру(ВРег(Документ.description));
		Если Не ЗначениеЗаполнено(ТекЗаказ) Тогда
			ТекЗаказ = Документы.CRM_Событие.ПустаяСсылка();
			Сообщить(Документ.description);
		КонецЕсли;
		
		
		Если Документ.status = "Pending" Тогда //платежка не подписана
			Продолжить;
		КонецЕсли;	
		НазначениеПлатежаДокумента=НРег(Документ.description);
		КредитДебитИндикатор = Документ.creditDebitIndicator;
		ТипПлатежногоДокумента = ПолучитьТипПлатежногоДокумента(Документ.transactionTypeCode);
		
		Если КредитДебитИндикатор = "Debit" Тогда
			
			ИмяДокумента = "Списание безналичных денежных средств";
			
			Если Документ.CreditorParty.Свойство("inn") Тогда 
				ИННКонтрагента = Документ.CreditorParty.inn;
				Если Документ.CreditorParty.Свойство("kpp") Тогда
					КППКонтрагента = Документ.CreditorParty.kpp;
				Иначе
