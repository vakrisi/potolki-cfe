Функция ПолучитьВыпискуДляЗагрузкиПП() Экспорт
	
	ТаблицаПлатежей = ИнициализацияТаблицыПлатежей();
	ТаблицаРасшифровкаПлатежа = ИнициализацияТаблицыРасшифровкаПлатежа();
	ТаблицаВедомостиНаВыплатуЗарплаты = ИнициализацияТаблицыВедомостиНаВыплатуЗарплаты();
	
	УстановитьПривилегированныйРежим(Истина);
	НаборКлючей = ПолучитьНаборКлючейДляСБП();
	УстановитьПривилегированныйРежим(Ложь);
	
	
	ТаблицыПлатежей = Новый Структура("ТаблицаПлатежей, ТаблицаРасшифровкаПлатежа, ТаблицаВедомостиНаВыплатуЗарплаты", ТаблицаПлатежей, ТаблицаРасшифровкаПлатежа, ТаблицаВедомостиНаВыплатуЗарплаты);
	
	Данные = новый Структура("НаборКлючей, ТаблицыПлатежей, Организация", НаборКлючей, ТаблицыПлатежей, Константы.НВД_ОсновнаяОрганизацияДляСБП.Получить());
	
	СтарыйНаборКлючей = ЗначениеИзСтрокиВнутр(ЗначениеВСтрокуВнутр(НаборКлючей)); //запомним набор ключей, чтобы потом проверить на изменения
	
	Выписка = ПолучитьВыпискуПоСчетуV3(Данные);
	Если Выписка = Ложь Тогда
		Возврат Новый Структура("ТаблицаПлатежей,ТаблицаРасшифровкаПлатежа,ТаблицаВедомостиНаВыплатуЗарплаты");//из-за косяка на стороне банка, данные могут быть не получены
	КонецЕсли;	
	
	Данные = ЗначениеИзСтрокиВнутр(ЗначениеВСтрокуВнутр(ЗначениеИзСтрокиВнутр(ЗначениеВСтрокуВнутр(Выписка))));	
	
	//проверим набор ключей на изменение
	КлючиИзменены = Ложь;
	Если СтарыйНаборКлючей.accesstoken_hybrid <> Данные.НаборКлючей.accesstoken_hybrid Тогда
		КлючиИзменены = Истина;
	ИначеЕсли СтарыйНаборКлючей.accesstoken_client <> Данные.НаборКлючей.accesstoken_client Тогда
		КлючиИзменены = Истина;
	ИначеЕсли СтарыйНаборКлючей.refreshtoken_hybrid <> Данные.НаборКлючей.refreshtoken_hybrid Тогда
		КлючиИзменены = Истина;
	ИначеЕсли СтарыйНаборКлючей.client_id <> Данные.НаборКлючей.client_id Тогда
		КлючиИзменены = Истина;	
	ИначеЕсли СтарыйНаборКлючей.client_secret <> Данные.НаборКлючей.client_secret Тогда
		КлючиИзменены = Истина;	
	ИначеЕсли СтарыйНаборКлючей.account_code <> Данные.НаборКлючей.account_code Тогда
		КлючиИзменены = Истина;
	КонецЕсли;
	
	Если КлючиИзменены Тогда
		УстановитьПривилегированныйРежим(Истина);
		ЗаписатьНовыйНаборКлючейСБП(Данные.НаборКлючей);
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	Возврат Новый Структура("ТаблицаПлатежей,ТаблицаРасшифровкаПлатежа,ТаблицаВедомостиНаВыплатуЗарплаты",Данные.ТаблицыПлатежей.ТаблицаПлатежей, Данные.ТаблицыПлатежей.ТаблицаРасшифровкаПлатежа, Данные.ТаблицыПлатежей.ТаблицаВедомостиНаВыплатуЗарплаты);
КонецФункции	

Процедура СоздатьПлатежныеДокументыПоБанку(Данные) Экспорт
	
	ТаблицаПП = Данные.ТаблицаПлатежей;
	ТаблицаРасшифровкаПлатежа = Данные.ТаблицаРасшифровкаПлатежа;
	ТаблицаВедомостиНаВыплатуЗарплаты = Данные.ТаблицаВедомостиНаВыплатуЗарплаты;
	
	ТаблицаПП.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("ДокументСсылка.СписаниеБезналичныхДенежныхСредств, ДокументСсылка.ПоступлениеБезналичныхДенежныхСредств"));
	
	ДатаНач = НачалоДня(ТекущаяДата()-60*60*24*5);	 
	
	ДатаКон = КонецДня(ТекущаяДата());
	
	//ДатаНач = НачалоДня(Дата(2021,10,06));	 
	//
	//ДатаКон = КонецДня(Дата(2021,10,06));
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаПлатежей.КредитДебитИндикатор КАК ТП_КредитДебитИндикатор,
