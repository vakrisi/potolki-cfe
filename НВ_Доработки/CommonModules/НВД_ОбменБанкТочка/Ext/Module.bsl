	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	Запрос.УстановитьПараметр("ТаблицаПлатежей", ТаблицаПП);
	Запрос.УстановитьПараметр("ДатаНач", ДатаНач);
	Запрос.УстановитьПараметр("ДатаКон", ДатаКон);
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ТипЗнч(ВыборкаДетальныеЗаписи.Ссылка) = Тип("ДокументСсылка.ПоступлениеБезналичныхДенежныхСредств") ИЛИ ТипЗнч(ВыборкаДетальныеЗаписи.Ссылка) = Тип("ДокументСсылка.СписаниеБезналичныхДенежныхСредств") Тогда
			Продолжить;
		КонецЕсли;
		//создаем платежки, которых нет
		Если ВыборкаДетальныеЗаписи.ТП_КредитДебитИндикатор = "Credit" Тогда  //поступление денег
			Платежка = Документы.ПоступлениеБезналичныхДенежныхСредств.СоздатьДокумент(); 
			Платежка.СписаниеБезналичныхДенежныхСредств = ВыборкаДетальныеЗаписи.ТП_СписаниеБезналичныхДенежныхСредств;
			Если ВыборкаДетальныеЗаписи.ТП_ТипПлатежногоДокумента = Перечисления.ТипыПлатежныхДокументов.БанковскийОрдер тогда //косяк в банковской выписке, должен быть платежный ордер
				Платежка.ТипПлатежногоДокумента = Перечисления.ТипыПлатежныхДокументов.ПлатежныйОрдер;
			Иначе
				Платежка.ТипПлатежногоДокумента = ВыборкаДетальныеЗаписи.ТП_ТипПлатежногоДокумента;
			КонецЕсли;	
		Иначе //расход
			Платежка = Документы.СписаниеБезналичныхДенежныхСредств.СоздатьДокумент();
			Платежка.АвансовыйОтчет                           = ВыборкаДетальныеЗаписи.ТП_АвансовыйОтчет;  
			Платежка.БанковскийСчетПолучатель                 = ВыборкаДетальныеЗаписи.ТП_БанковскийСчетПолучатель;
			Платежка.ЗаявкаНаРасходованиеДенежныхСредств      = ВыборкаДетальныеЗаписи.ТП_ЗаявкаНаРасходованиеДенежныхСредств;     
			Платежка.РаспоряжениеНаПеремещениеДенежныхСредств = ВыборкаДетальныеЗаписи.ТП_РаспоряжениеНаПеремещениеДенежныхСредств;    
			Платежка.ВидПлатежа                               = ВыборкаДетальныеЗаписи.ТП_ВидПлатежа;  
			Платежка.ТипПлатежногоДокумента                   = ВыборкаДетальныеЗаписи.ТП_ТипПлатежногоДокумента;
			Платежка.ОчередностьПлатежа                       = ВыборкаДетальныеЗаписи.ТП_ОчередностьПлатежа;             
			Платежка.ПеречислениеВБюджет                      = ВыборкаДетальныеЗаписи.ТП_ПеречислениеВБюджет;           
			Платежка.ВидПеречисленияВБюджет                   = ВыборкаДетальныеЗаписи.ТП_ВидПеречисленияВБюджет;       
			Платежка.СтатусСоставителя                        = ВыборкаДетальныеЗаписи.ТП_СтатусСоставителя;           
			Платежка.КодБК                                    = ВыборкаДетальныеЗаписи.ТП_КодБК;                
			Платежка.КодОКАТО                                 = ВыборкаДетальныеЗаписи.ТП_КодОКАТО;               
			Платежка.ПоказательОснования                      = ВыборкаДетальныеЗаписи.ТП_ПоказательОснования;     
			Платежка.ПоказательПериода                        = ВыборкаДетальныеЗаписи.ТП_ПоказательПериода;           
			Платежка.ПоказательНомера                         = ВыборкаДетальныеЗаписи.ТП_ПоказательНомера;         
			Платежка.ПоказательДаты                           = ВыборкаДетальныеЗаписи.ТП_ПоказательДаты;          
			Платежка.ПоказательТипа                           = ВыборкаДетальныеЗаписи.ТП_ПоказательТипа;   
			Платежка.НеКонтролироватьЗаполнениеЗаявки         = Истина;   
			Платежка.НомерВедомостиНаВыплатуЗарплаты          = ВыборкаДетальныеЗаписи.ТП_НомерВедомостиНаВыплатуЗарплаты;    
			Платежка.ДатаВедомостиНаВыплатуЗарплаты           = ВыборкаДетальныеЗаписи.ТП_ДатаВедомостиНаВыплатуЗарплаты;  
			Платежка.СуммаПослеКонвертации                    = ВыборкаДетальныеЗаписи.ТП_СуммаПослеКонвертации;
		КонецЕсли;
		Платежка.Дата                          = КонецДня(ВыборкаДетальныеЗаписи.ТП_ДатаВходящегоДокумента);
		Платежка.Организация                   = ВыборкаДетальныеЗаписи.ТП_Организация;
		Платежка.БанковскийСчет                = ВыборкаДетальныеЗаписи.ТП_БанковскийСчет; 
		Платежка.ХозяйственнаяОперация         = ВыборкаДетальныеЗаписи.ТП_ХозяйственнаяОперация;
		Платежка.СуммаДокумента                = ВыборкаДетальныеЗаписи.ТП_СуммаДокумента;
		Платежка.Контрагент                    = ВыборкаДетальныеЗаписи.ТП_Контрагент;
		Платежка.БанковскийСчетКонтрагента     = ВыборкаДетальныеЗаписи.ТП_БанковскийСчетКонтрагента;
		Платежка.ДатаВходящегоДокумента        = ВыборкаДетальныеЗаписи.ТП_ДатаВходящегоДокумента;
		Платежка.НомерВходящегоДокумента       = ВыборкаДетальныеЗаписи.ТП_НомерВходящегоДокумента;
		Платежка.НазначениеПлатежа             = ВыборкаДетальныеЗаписи.ТП_НазначениеПлатежа; 
		Платежка.Валюта                        = ВыборкаДетальныеЗаписи.ТП_Валюта;
		Платежка.Комментарий                   = ВыборкаДетальныеЗаписи.ТП_Комментарий;	
		Платежка.СтатьяДвиженияДенежныхСредств = ВыборкаДетальныеЗаписи.ТП_СтатьяДвиженияДенежныхСредств; 
		Платежка.ВалютаКонвертации             = ВыборкаДетальныеЗаписи.ТП_ВалютаКонвертации;
		Платежка.КурсКонвертации               = ВыборкаДетальныеЗаписи.ТП_КурсКонвертации; 		
		Платежка.ПодотчетноеЛицо               = ВыборкаДетальныеЗаписи.ТП_ПодотчетноеЛицо;
		Платежка.Подразделение                 = ВыборкаДетальныеЗаписи.ТП_Подразделение;
		Платежка.СтатьяАктивовПассивов         = ВыборкаДетальныеЗаписи.ТП_СтатьяАктивовПассивов;
		Платежка.АналитикаАктивовПассивов      = ВыборкаДетальныеЗаписи.ТП_АналитикаАктивовПассивов;
		Платежка.ДокументОснование             = ВыборкаДетальныеЗаписи.ТП_ДокументОснование;
		
		//заполнение табличных частей 
		Если ВыборкаДетальныеЗаписи.ТП_КредитДебитИндикатор = "Credit" Тогда  //поступление денег
			Отбор = Новый Структура("IDРасшифровкаПлатежа", ВыборкаДетальныеЗаписи.ТП_IDРасшифровкаПлатежа);
			СтрокиРасшифровкиПлатежа = ТаблицаРасшифровкаПлатежа.НайтиСтроки(Отбор);
			Если СтрокиРасшифровкиПлатежа.Количество() > 0 Тогда
				Для Каждого СтрокаРасшифровкиПлатежа Из СтрокиРасшифровкиПлатежа Цикл
					ПлатежкаСтрокаРасшифровкиПлатежа = Платежка.РасшифровкаПлатежа.Добавить();
					ПлатежкаСтрокаРасшифровкиПлатежа.Партнер = СтрокаРасшифровкиПлатежа.Партнер; 
					ПлатежкаСтрокаРасшифровкиПлатежа.СтатьяДвиженияДенежныхСредств = СтрокаРасшифровкиПлатежа.СтатьяДвиженияДенежныхСредств;
					ПлатежкаСтрокаРасшифровкиПлатежа.ОснованиеПлатежа              = СтрокаРасшифровкиПлатежа.ОснованиеПлатежа;
					ПлатежкаСтрокаРасшифровкиПлатежа.Заказ                         = СтрокаРасшифровкиПлатежа.Заказ;
					ПлатежкаСтрокаРасшифровкиПлатежа.Сумма                         = СтрокаРасшифровкиПлатежа.Сумма;
					ПлатежкаСтрокаРасшифровкиПлатежа.ВалютаВзаиморасчетов          = СтрокаРасшифровкиПлатежа.ВалютаВзаиморасчетов;
					ПлатежкаСтрокаРасшифровкиПлатежа.СуммаВзаиморасчетов           = СтрокаРасшифровкиПлатежа.СуммаВзаиморасчетов;
