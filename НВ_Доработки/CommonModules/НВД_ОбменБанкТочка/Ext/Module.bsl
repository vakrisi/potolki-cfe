Функция ПолучитьМассивДатДляФормированияВыписки(Банковскийсчет)

	ТаблицаДата = Новый ТаблицаЗначений;
	ТаблицаДата.Колонки.Добавить("Дата");
	ТаблицаДата.Колонки.Добавить("СоздаватьВыписку");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВыпискаПоРасчетномуСчету.Дата КАК Дата
		|ИЗ
		|	Документ.ВыпискаПоРасчетномуСчету КАК ВыпискаПоРасчетномуСчету
		|ГДЕ
		|	ВыпискаПоРасчетномуСчету.БанковскийСчет = &БанковскийСчет
		|	И ВыпискаПоРасчетномуСчету.Дата МЕЖДУ &ДатаНач И &ДатаКон";
	
	Запрос.УстановитьПараметр("БанковскийСчет", БанковскийСчет);
	Запрос.УстановитьПараметр("ДатаКон", КонецДня(ТекущаяДата() - 2*86400));
	Запрос.УстановитьПараметр("ДатаНач", НачалоДня(ТекущаяДата() - 14*86400));
	
	ТаблицаВыписок = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаТаблицыВыписок ИЗ ТаблицаВыписок Цикл
		СтрокаТаблицыВыписок.Дата = НачалоДня(СтрокаТаблицыВыписок.Дата);
	КонецЦикла;	
		
	//Таблица может содержать только 12 строк
    ПроверяемаяДата = НачалоДня(ТекущаяДата() - 14*86400);
	Пока ПроверяемаяДата <= КонецДня((ТекущаяДата() - 2*86400)) Цикл   
		Если ТаблицаВыписок.Найти(ПроверяемаяДата, "Дата") = Неопределено Тогда
			СтрокаТаблицыДат = ТаблицаДата.Добавить();
			СтрокаТаблицыДат.Дата = ПроверяемаяДата;
		КонецЕсли;	
		ПроверяемаяДата = ПроверяемаяДата + 24*60*60; //прибавляем день
	КонецЦикла;
	
	//Теперь проверяем даты по которым надо создавать выписки на наличие платежных поручений, если их нет, то и выписку не создаем
	Для Каждого СтрокаТаблицыДат Из ТаблицаДата Цикл
		ПроверяемаяДата = СтрокаТаблицыДат.Дата;
		ВыборкаДокументовСписания = Документы.СписаниеБезналичныхДенежныхСредств.Выбрать(НачалоДня(ПроверяемаяДата), КонецДня(ПроверяемаяДата));
		Если ВыборкаДокументовСписания.Следующий() Тогда
			ЕстьДокументыСписания = Истина;
		Иначе
			ЕстьДокументыСписания = Ложь;
		КонецЕсли;
		
		ВыборкаДокументовПоступления = Документы.ПоступлениеБезналичныхДенежныхСредств.Выбрать(НачалоДня(ПроверяемаяДата), КонецДня(ПроверяемаяДата));
		Если ВыборкаДокументовСписания.Следующий() Тогда
			ЕстьДокументыПоступления = Истина;
		Иначе
			ЕстьДокументыПоступления = Ложь;
		КонецЕсли;
		
		Если ЕстьДокументыСписания ИЛИ ЕстьДокументыПоступления Тогда
			СтрокаТаблицыДат.СоздаватьВыписку = Истина;
		Иначе
			СтрокаТаблицыДат.СоздаватьВыписку = Ложь;
		КонецЕсли;
	КонецЦикла;	
	
	// теперь надо удалить строки по которым не надо формировать выписки
	Отбор = Новый Структура("СоздаватьВыписку", Истина);
	МассивСтрокСДатами = ТаблицаДата.НайтиСтроки(Отбор);
	
	//проверим по каждой дате, по которой надо сделать выписку, есть ли не проведенные документы
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СписаниеБезналичныхДенежныхСредств.Дата КАК Дата,
		|	СписаниеБезналичныхДенежныхСредств.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.СписаниеБезналичныхДенежныхСредств КАК СписаниеБезналичныхДенежныхСредств
		|ГДЕ
		|	СписаниеБезналичныхДенежныхСредств.ПометкаУдаления = ЛОЖЬ
		|	И СписаниеБезналичныхДенежныхСредств.Проведен = ЛОЖЬ
		|	И СписаниеБезналичныхДенежныхСредств.Дата В(&МассивДат)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПоступлениеБезналичныхДенежныхСредств.Дата,
		|	ПоступлениеБезналичныхДенежныхСредств.Ссылка
		|ИЗ
		|	Документ.ПоступлениеБезналичныхДенежныхСредств КАК ПоступлениеБезналичныхДенежныхСредств
		|ГДЕ
		|	ПоступлениеБезналичныхДенежныхСредств.ПометкаУдаления = ЛОЖЬ
		|	И ПоступлениеБезналичныхДенежныхСредств.Проведен = ЛОЖЬ
		|	И ПоступлениеБезналичныхДенежныхСредств.Дата В(&МассивДат)";
	
	Запрос.УстановитьПараметр("МассивДат", МассивСтрокСДатами);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Индекс = МассивСтрокСДатами.Найти(ВыборкаДетальныеЗаписи.Дата);
		Если Индекс <> Неопределено Тогда
			//удаляем дату, так как сначала надо либо провести документ, либо пометить на удаление
			Сообщить("За дату: " + ВыборкаДетальныеЗаписи.Дата + " есть не проведенные банковские документы, их надо либо провести, либо пометить на удаление!");
			МассивСтрокСДатами.Удалить(Индекс);
		КонецЕсли;	
	КонецЦикла;
	
	Возврат МассивСтрокСДатами;
КонецФункции	

Процедура СоздатьБанковскуюВыписку(ДатаДокумента, БанковскийСчет)
	
	Если НЕ ЗначениеЗаполнено(ДатаДокумента) Тогда
		Возврат;
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(БанковскийСчет) Тогда
		Возврат;
	КонецЕсли;
	
	НоваяБанковскаяВыписка = Документы.ВыпискаПоРасчетномуСчету.СоздатьДокумент();
	НоваяБанковскаяВыписка.БанковскийСчет = БанковскийСчет;
	НоваяБанковскаяВыписка.Дата = ДатаДокумента;
	НоваяБанковскаяВыписка.Организация = БанковскийСчет.Владелец;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПоступлениеБезналичныхДенежныхСредств.Ссылка КАК Ссылка,
		|	ПоступлениеБезналичныхДенежныхСредств.СуммаДокумента КАК СуммаДокумента
		|ИЗ
		|	Документ.ПоступлениеБезналичныхДенежныхСредств КАК ПоступлениеБезналичныхДенежныхСредств
		|ГДЕ
		|	ПоступлениеБезналичныхДенежныхСредств.Дата МЕЖДУ &НачалоДняДатаДокумента И &КонецДняДатаДокумента
		|	И ПоступлениеБезналичныхДенежныхСредств.БанковскийСчет = &БанковскийСчет";
	
	Запрос.УстановитьПараметр("БанковскийСчет", БанковскийСчет);
	Запрос.УстановитьПараметр("НачалоДняДатаДокумента", НачалоДня(ДатаДокумента));
	Запрос.УстановитьПараметр("КонецДняДатаДокумента", КонецДня(ДатаДокумента));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	СуммаПоступленияВсего = 0;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СтрокаБВПриход = НоваяБанковскаяВыписка.ВходящиеПлатежи.Добавить();
		СтрокаБВПриход.ПлатежныйДокумент = ВыборкаДетальныеЗаписи.Ссылка;
		СтрокаБВПриход.Сумма = ВыборкаДетальныеЗаписи.СуммаДокумента;
		СуммаПоступленияВсего = СуммаПоступленияВсего + ВыборкаДетальныеЗаписи.СуммаДокумента;
	КонецЦикла;
	НоваяБанковскаяВыписка.СуммаПоступленияВсего = СуммаПоступленияВсего;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СписаниеБезналичныхДенежныхСредств.Ссылка КАК Ссылка,
		|	СписаниеБезналичныхДенежныхСредств.СуммаДокумента КАК СуммаДокумента
		|ИЗ
		|	Документ.СписаниеБезналичныхДенежныхСредств КАК СписаниеБезналичныхДенежныхСредств
		|ГДЕ
		|	СписаниеБезналичныхДенежныхСредств.Дата МЕЖДУ &НачалоДняДатаДокумента И &КонецДняДатаДокумента
		|	И СписаниеБезналичныхДенежныхСредств.БанковскийСчет = &БанковскийСчет";
	
	Запрос.УстановитьПараметр("БанковскийСчет", БанковскийСчет);
	Запрос.УстановитьПараметр("НачалоДняДатаДокумента", НачалоДня(ДатаДокумента));
	Запрос.УстановитьПараметр("КонецДняДатаДокумента", КонецДня(ДатаДокумента));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	СуммаСписанияВсего = 0;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СтрокаБВРасход = НоваяБанковскаяВыписка.ИсходящиеПлатежи.Добавить();
		СтрокаБВРасход.ПлатежныйДокумент = ВыборкаДетальныеЗаписи.Ссылка;
		СтрокаБВРасход.Сумма = ВыборкаДетальныеЗаписи.СуммаДокумента;
		СуммаСписанияВсего = СуммаСписанияВсего + ВыборкаДетальныеЗаписи.СуммаДокумента;
	КонецЦикла;
	НоваяБанковскаяВыписка.СуммаСписанияВсего = СуммаСписанияВсего;
	
	Если НоваяБанковскаяВыписка.ИсходящиеПлатежи.Количество() > 0 ИЛИ НоваяБанковскаяВыписка.ВходящиеПлатежи.Количество() > 0 Тогда
		Попытка
			НоваяБанковскаяВыписка.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			НоваяБанковскаяВыписка.Записать(РежимЗаписиДокумента.Запись);
			ТекстОшибки = "Ошибка при проведении Банковской выписки " + ОписаниеОшибки() + "";
			Сообщить(ТекстОшибки, СтатусСообщения.Важное);
			ЗаписьЖурналаРегистрации(ТекстОшибки, УровеньЖурналаРегистрации.Ошибка);
		КонецПопытки;	
	КонецЕсли;
КонецПроцедуры	

Процедура СоздатьВыписки() Экспорт
	
	//Получаем список банковских счетов
	
	ТаблицаБанковскихСчетов = ПолучитьСписокБанковскихСчетов();
	
	Если ТаблицаБанковскихСчетов.Количество() = 0 Тогда
		Возврат; //нет счетов - нет выписок
	КонецЕсли;	
	
	//По каждому счету будет отдельная выписка, за каждый день
	
	Для каждого СтрокаТаблицыБС Из ТаблицаБанковскихСчетов Цикл
		
		//получим даты по которым выписки еще не созданы, 
		//смотрим за последние 2 недели, и до текущей дату минус 2 дня
		//на случай, если банк какие то платежки провел с запозданием
		//формируем массив дат по контретому счету
		МассивДат = ПолучитьМассивДатДляФормированияВыписки(СтрокаТаблицыБС.БанковскийСчет);
		
		Для Каждого лДата из МассивДат Цикл
			СоздатьБанковскуюВыписку(лДата.Дата, СтрокаТаблицыБС.БанковскийСчет);
		КонецЦикла;	
		
	КонецЦикла;	
		
	
КонецПроцедуры

#КонецОбласти
