Функция ПолучитьЗаказПоНомеру(лТекстПлатежа) Экспорт
	
	
	ТекстПлатежа = лТекстПлатежа;
	
	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, "№", " ");
	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, "СЧ.", " ");
	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, "#", " ");      
	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, "НОМЕР", " ");
	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, "No", " ");
	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, "NО", " ");
	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, "NO", " ");      
	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, "NO", " ");
	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, ",", " ");
	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, ";", " ");
	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, "ОТ", " ");
	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, "N", " ");
	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, "P300-",  "Р300-");
	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, "РЗ00-",  "Р300-");
	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, "Р-300-", "Р300-");     
	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, "Р 300-", "Р300-");
	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, "P 300-", "Р300-");
	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, " 300-",  " Р300-");
	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, "Р600-",  "Р600-");
	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, "P600-",  "Р600-");
	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, "Р-600-", "Р600-");     
	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, "Р 600-", "Р600-");
	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, "P 600-", "Р600-");
	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, " 600-",  " Р600-"); 
	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, "P600-",  "Р600-");
	
	//Если СтрНайти(ТекстПлатежа, "300-") > 0 И СтрНайти(ТекстПлатежа, "Р") = 0 Тогда 
	//	ТекстПлатежа = СтрЗаменить(ТекстПлатежа, "300-",  " Р300-");	
	//КонецЕсли;	
	
	НомерЗаказа = "";
	
	Если СтрЧислоВхождений(ТекстПлатежа, "@") = 2 Тогда  //Сначала ищем заказ между собачками
		
		МасСлов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекстПлатежа, "@");  		
		
		Если МасСлов.Количество() = 3 Тогда
			НомерЗаказа = СтроковыеФункцииКлиентСервер.ДополнитьСтроку(МасСлов[1], 11, "0");	
		КонецЕсли;
		
	КонецЕсли;  
	
	СсылкаНаСчет = "";
	лСчет = "";
	Если Не ЗначениеЗаполнено(НомерЗаказа) Тогда //ищем счет
		
		МасСлов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекстПлатежа, " ", Истина);
		
		Для Каждого Эл Из МасСлов Цикл
			
			ЭлОбр = СтрЗаменить(Эл, "@", "");
			Если СтрЧислоВхождений(ЭлОбр, ".") = 1 Тогда //даты становятся номерами документов
				ЭлОбр = СтрЗаменить(ЭлОбр, ".", "");  		
			КонецЕсли;
			Если СтрДлина(ЭлОбр) = 11 Тогда
				лСчет = Документы.СчетНаОплатуКлиенту.НайтиПоНомеру(ЭлОбр, ТекущаяДата());
			КонецЕсли;
			
			Если ЗначениеЗаполнено(лСчет) Тогда
				СсылкаНаСчет = лСчет;	
			КонецЕсли;	
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НомерЗаказа)
		И Не ЗначениеЗаполнено(СсылкаНаСчет) Тогда //  Потом ищем по первому номеру в тексте, который подходит под условия
		
		МасСлов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекстПлатежа, " ", Истина); 
		Для Каждого Эл Из МасСлов Цикл
			
			//ЭлОбр = СтрЗаменить(Эл, "@", "");
			//Если СтрЧислоВхождений(ЭлОбр, ".") = 1 Тогда //даты становятся номерами документов
			//	ЭлОбр = СтрЗаменить(ЭлОбр, ".", "");  		
			//КонецЕсли;
			Если СтрДлина(Эл) >= 5 И СтрДлина(Эл) <= 6 И СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Эл, Истина, Ложь) Тогда
				НомерЗаказа = СтроковыеФункцииКлиентСервер.ДополнитьСтроку(Эл, 11, "0");
				Если ЗначениеЗаполнено(НомерЗаказа) Тогда
					Прервать;
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	СсылкаНаЗаказ = Неопределено;
	
	Если Не ЗначениеЗаполнено(НомерЗаказа)
		И Не ЗначениеЗаполнено(СсылкаНаСчет) Тогда //возможно это платеж через СБП, ищем его
		НомерВхождения = СтрНайти(ВРег(СокрЛП(лТекстПлатежа)),"QR КОДУ ID");
		IDQR = "";
		Если НомерВхождения > 0 Тогда
			
			//находим ID QR кода
			IDQR = Сред(лТекстПлатежа,НомерВхождения + 11, 32);
			
		КонецЕсли;
		Если IDQR <> "" И СтрДлина(IDQR) = 32 Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	СБП_QRКоды.qrcId КАК qrcId,
			|	СБП_QRКоды.Заказ КАК Заказ
			|ИЗ
			|	РегистрСведений.СБП_QRКоды КАК СБП_QRКоды
			|ГДЕ
			|	СБП_QRКоды.qrcId = &qrcId";
			
			Запрос.УстановитьПараметр("qrcId", IDQR);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Если ВыборкаДетальныеЗаписи.Следующий() Тогда
				
				 СсылкаНаЗаказ = ВыборкаДетальныеЗаписи.Заказ;
				
			КонецЕсли;
			
		КонецЕсли;	
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(НомерЗаказа) Тогда
		СсылкаНаЗаказ = Документы.CRM_Событие.НайтиПоНомеру(НомерЗаказа);
	ИначеЕсли ЗначениеЗаполнено(СсылкаНаСчет) Тогда
		СсылкаНаЗаказ = СсылкаНаСчет.ДокументОснование;		
	ИначеЕсли ЗначениеЗаполнено(СсылкаНаЗаказ) Тогда
		// уже нашли заказ, ничего не делаем
	Иначе	
		СсылкаНаЗаказ = Документы.CRM_Событие.ПустаяСсылка();	
	КонецЕсли;
	
	Возврат СсылкаНаЗаказ;
	
КонецФункции

