	Возврат СтрокаJSON + "]";
	
КонецФункции

Функция СформироватьСтрокуJSON(Объект) Экспорт
	
	СтрокаJSON = "";
	
	Если ТипЗнч(Объект) = Тип("Массив") Тогда
		СтрокаJSON = СформироватьСтрокуJSONИзМассива(Объект);
		
	ИначеЕсли ТипЗнч(Объект) = Тип("Структура") Тогда
		СтрокаJSON = СформироватьСтрокуJSONИзСтруктуры(Объект);
		
	ИначеЕсли ТипЗнч(Объект) = Тип("ТаблицаЗначений") Тогда
		// преобразуем таблицу значений в массив структур - работает дольше, но кода меньше
		// если нужна скорость, то нужно отдельно обработать таблицу значений
		
		СоставСтруктуры = "";
		Для каждого Колонка Из Объект.Колонки Цикл
			СоставСтруктуры = СоставСтруктуры + ?(ЗначениеЗаполнено(СоставСтруктуры), ",", "") + Колонка.Имя;
		КонецЦикла;
		
		МассивСтрок = Новый Массив;
		Для каждого Строка Из Объект Цикл
			СтруктураКолонок = Новый Структура(СоставСтруктуры);
			ЗаполнитьЗначенияСвойств(СтруктураКолонок, Строка);
			МассивСтрок.Добавить(СтруктураКолонок);
		КонецЦикла;
		
		СтрокаJSON = СформироватьСтрокуJSONИзМассива(МассивСтрок);
		
	КонецЕсли;
	
	Возврат СтрокаJSON;
	
КонецФункции  

Функция УдалениеНечитаемыхСимволов( Знач Стр, ОграничитьДлину = 100)
	
	Стр = СокрЛП( Стр);
	
	Стр = СтрЗаменить( Стр, Символ(34), "");
	Стр = СтрЗаменить( Стр, "'", "");
	Стр = СтрЗаменить( Стр, ",", ".");
	
	СоответствиеНайден = Новый Соответствие;
	
	Для НомерСимвола = 1 по СтрДлина( Стр) Цикл
		
		ТекСимвол = Сред( Стр, НомерСимвола, 1);
		
		Если КодСимвола( ТекСимвол) < 32 И КодСимвола( ТекСимвол) <> 10 Тогда
			СоответствиеНайден.Вставить( ТекСимвол, "");
		КонецЕсли;
		
	КонецЦикла; // НомерСимвола = 1 по СтрДлина( Стр)
	
	Если СоответствиеНайден.Количество() > 0 Тогда
		Для Каждого ТекСимвол из СоответствиеНайден Цикл
			Стр = СтрЗаменить( Стр, ТекСимвол.Ключ, "");
		КонецЦикла;
	КонецЕсли; // ФлагНайден > 0
	
	Если СтрДлина( Стр) > ОграничитьДлину Тогда
		Стр = Лев( Стр, ОграничитьДлину);
	КонецЕсли;
	
	Возврат Стр;
	
КонецФункции

Функция ПолучитьЗапрошенныйФайлPOST(СтрокаЗапроса, СтрокаJSON, ТипЗапроса = "POST", access_token, account_code)
	
	ЗаголовокHTTP = Новый Соответствие();
	ЗаголовокHTTP.Вставить("Content-Type", "application/json; charset=utf-8");
	ЗаголовокHTTP.Вставить("accept", "application/json");
	ЗаголовокHTTP.Вставить("type", ТипЗапроса);
	ЗаголовокHTTP.Вставить("dataType", "json");
	ЗаголовокHTTP.Вставить("Authorization", "Bearer " + access_token);
	
	SSL = Новый ЗащищенноеСоединениеOpenSSL(
                Новый СертификатКлиентаWindows(),
                Новый СертификатыУдостоверяющихЦентровWindows());
	
	Попытка
		
		Если ТипЗапроса = "POST" Тогда
			Соединение = Новый HTTPСоединение("enter.tochka.com", 443,,,,,SSL);
			HTTPЗапрос = Новый HTTPЗапрос(СтрокаЗапроса, ЗаголовокHTTP);
			HTTPЗапрос.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
			ОтветСервера = Соединение.ОтправитьДляОбработки(HTTPЗапрос); 
		Иначе
			Соединение = Новый HTTPСоединение("enter.tochka.com", 443,,,,,SSL);
			HTTPЗапрос = Новый HTTPЗапрос(СтрокаЗапроса, ЗаголовокHTTP);
//			HTTPЗапрос.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
			ОтветСервера = Соединение.Получить(HTTPЗапрос);
		КонецЕсли;
		
	Исключение
		
		ТекстОшибки = "Связь с сервером не установлена " + ОписаниеОшибки() + "";
		Сообщить(ТекстОшибки, СтатусСообщения.Важное);
		ЗаписьЖурналаРегистрации(ТекстОшибки, УровеньЖурналаРегистрации.Ошибка);
		
	КонецПопытки;
	
	Возврат ОтветСервера;
	
КонецФункции

