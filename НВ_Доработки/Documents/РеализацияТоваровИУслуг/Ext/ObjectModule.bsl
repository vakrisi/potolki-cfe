	СписокТоваров.Колонки.Добавить("Склад", Новый ОписаниеТипов("СправочникСсылка.Склады"));
	СписокТоваров.ЗаполнитьЗначения(Склад, "Склад");
	
	СписокТоваров.Свернуть("Склад, ВидТабличнойЧасти, Номенклатура, ХарактеристикаНоменклатуры, СерияНоменклатуры, Заказ", "Количество");
	
	МоментВремени = Новый Граница(Ссылка.МоментВремени(), ВидГраницы.Исключая);
	
	ТЗСписанныеРезервы = РегистрыНакопления.ТоварыВРезервеНаСкладах.НВД_ПолучитьОстаткиПоРезервамНамоментВремени(МоментВремени, СписокТоваров, ОрганизацияТоваров);  
	
	ТЗСписанныеРезервы.Колонки.Добавить("Количество");
	
	ТЗСписанныеРезервы.ЗагрузитьКолонку(ТЗСписанныеРезервы.ВыгрузитьКолонку("КоличествоВДокументе"), "Количество");
	
	Если ТЗСписанныеРезервы.Количество() > 0 Тогда 
		
		//ТЗЗаказовПокупателейСписанныхРезервов = ТЗСписанныеРезервы.Скопировать();
		//ТЗЗаказовПокупателейСписанныхРезервов.Свернуть("ДокументРезерва");
		//ДокументыРезерва = ТЗЗаказовПокупателейСписанныхРезервов.ВыгрузитьКолонку("ДокументРезерва");                                                
		
		ВТСписываемыеРезервы = Новый ТаблицаЗначений;
		ВТСписываемыеРезервы.Колонки.Добавить("ДокументРезерва", Новый ОписаниеТипов("ДокументСсылка.ЗаказПокупателя"));
		ВТСписываемыеРезервы.Колонки.Добавить("Склад", Новый ОписаниеТипов("СправочникСсылка.Склады"));
		ВТСписываемыеРезервы.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
		ВТСписываемыеРезервы.Колонки.Добавить("ВидТабличнойЧасти", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыТабличнойЧасти"));
		ВТСписываемыеРезервы.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		ВТСписываемыеРезервы.Колонки.Добавить("ХарактеристикаНоменклатуры", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
		ВТСписываемыеРезервы.Колонки.Добавить("СерияНоменклатуры", Новый ОписаниеТипов("СправочникСсылка.СерииНоменклатуры"));
