КонецПроцедуры	

Процедура ИзменитьСтатусДокументовРезервированиеПриОтменеПроведения()
	
	ОрганизацияТоваров = Организация;
	Если Константы.ОбщиеСклады.Получить() Тогда
		ОрганизацияТоваров = Справочники.Организации.ПустаяСсылка();
	КонецЕсли;
	
	СписокТоваров = Товары.Выгрузить();
	СписокТоваров.Очистить();
	
	Для Каждого ТекущаяСтрока Из Товары Цикл
		
		Если Не ТипЗнч(ТекущаяСтрока.Заказ) = Тип("ДокументСсылка.ЗаказПокупателя") И Не ЗначениеЗаполнено(ТекущаяСтрока.Заказ) Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = СписокТоваров.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);			
		НоваяСтрока.Количество = НоваяСтрока.Количество * НоваяСтрока.Коэффициент;
		
	КонецЦикла;
	
	СписокТоваров.Колонки.Добавить("ВидТабличнойЧасти", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыТабличнойЧасти"));
	СписокТоваров.ЗаполнитьЗначения(Перечисления.ВидыТабличнойЧасти.Товары, "ВидТабличнойЧасти");
	
	СписокТоваров.Колонки.Добавить("Склад", Новый ОписаниеТипов("СправочникСсылка.Склады"));
	СписокТоваров.ЗаполнитьЗначения(Склад, "Склад");
	
	СписокТоваров.Свернуть("Склад, ВидТабличнойЧасти, Номенклатура, ХарактеристикаНоменклатуры, СерияНоменклатуры, Заказ", "Количество");
	
	МоментВремени = Новый Граница(Ссылка.МоментВремени(), ВидГраницы.Исключая);
	
	ТЗСписанныеРезервы = РегистрыНакопления.ТоварыВРезервеНаСкладах.НВД_ПолучитьОстаткиПоРезервамНамоментВремени(МоментВремени, СписокТоваров, ОрганизацияТоваров);  
	
	ТЗСписанныеРезервы.Колонки.Добавить("Количество");
	
	ТЗСписанныеРезервы.ЗагрузитьКолонку(ТЗСписанныеРезервы.ВыгрузитьКолонку("КоличествоВДокументе"), "Количество");
	
	Если ТЗСписанныеРезервы.Количество() > 0 Тогда 
		
		//ТЗЗаказовПокупателейСписанныхРезервов = ТЗСписанныеРезервы.Скопировать();
		//ТЗЗаказовПокупателейСписанныхРезервов.Свернуть("ДокументРезерва");
		//ДокументыРезерва = ТЗЗаказовПокупателейСписанныхРезервов.ВыгрузитьКолонку("ДокументРезерва");                                                
		
		ВТСписываемыеРезервы = Новый ТаблицаЗначений;
		ВТСписываемыеРезервы.Колонки.Добавить("ДокументРезерва", Новый ОписаниеТипов("ДокументСсылка.ЗаказПокупателя"));
		ВТСписываемыеРезервы.Колонки.Добавить("Склад", Новый ОписаниеТипов("СправочникСсылка.Склады"));
		ВТСписываемыеРезервы.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
		ВТСписываемыеРезервы.Колонки.Добавить("ВидТабличнойЧасти", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыТабличнойЧасти"));
		ВТСписываемыеРезервы.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		ВТСписываемыеРезервы.Колонки.Добавить("ХарактеристикаНоменклатуры", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
		ВТСписываемыеРезервы.Колонки.Добавить("СерияНоменклатуры", Новый ОписаниеТипов("СправочникСсылка.СерииНоменклатуры"));
		ВТСписываемыеРезервы.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Любой)));
		
		Для Каждого СтрокаТЗСписанныерезервы Из ТЗСписанныеРезервы Цикл
			
			СтрокаТаблицы = ВТСписываемыеРезервы.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтрокаТЗСписанныерезервы);
			
		КонецЦикла;
		
		Запрос = Новый Запрос;
		ТекстЗапроса = "ВЫБРАТЬ
		|	ВТСписываемыеРезервы.Количество КАК СписываемоеКоличество,
		|	ВТСписываемыеРезервы.ДокументРезерва КАК ДокументРезерва,
		|	ВТСписываемыеРезервы.Склад КАК Склад,
		|	ВТСписываемыеРезервы.Организация КАК Организация,
		|	ВТСписываемыеРезервы.ВидТабличнойЧасти КАК ВидТабличнойЧасти,
		|	ВТСписываемыеРезервы.Номенклатура КАК Номенклатура,
		|	ВТСписываемыеРезервы.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	ВТСписываемыеРезервы.СерияНоменклатуры КАК СерияНоменклатуры
		|ПОМЕСТИТЬ ВТЗакрытиеРезервов
		|ИЗ
		|	&ВТСписываемыеРезервы КАК ВТСписываемыеРезервы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва КАК ДокументРезерва,
		|	ТоварыВРезервеНаСкладахОстатки.Организация КАК Организация,
		|	ТоварыВРезервеНаСкладахОстатки.Склад КАК Склад,
		|	ТоварыВРезервеНаСкладахОстатки.ВидТабличнойЧасти КАК ВидТабличнойЧасти,
		|	ТоварыВРезервеНаСкладахОстатки.Номенклатура КАК Номенклатура,
		|	ТоварыВРезервеНаСкладахОстатки.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	ТоварыВРезервеНаСкладахОстатки.СерияНоменклатуры КАК СерияНоменклатуры,
		|	ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток КАК КоличествоОстаток,
		|	ВТЗакрытиеРезервов.СписываемоеКоличество КАК СписываемоеКоличество,
