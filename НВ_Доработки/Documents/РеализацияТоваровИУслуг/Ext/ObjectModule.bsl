		               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВРезервеНаСкладах КАК ТоварыВРезервеНаСкладах
		               |		ПО (ТоварыВРезервеНаСкладах.ДокументРезерва = ВТЗакрытиеРезервов.ДокументРезерва)
		               |			И ВТЗакрытиеРезервов.Склад = ТоварыВРезервеНаСкладах.Склад
		               |			И ВТЗакрытиеРезервов.Организация = ТоварыВРезервеНаСкладах.Организация
		               |			И ВТЗакрытиеРезервов.ВидТабличнойЧасти = ТоварыВРезервеНаСкладах.ВидТабличнойЧасти
		               |			И ВТЗакрытиеРезервов.Номенклатура = ТоварыВРезервеНаСкладах.Номенклатура
		               |			И ВТЗакрытиеРезервов.ХарактеристикаНоменклатуры = ТоварыВРезервеНаСкладах.ХарактеристикаНоменклатуры
		               |			И ВТЗакрытиеРезервов.СерияНоменклатуры = ТоварыВРезервеНаСкладах.СерияНоменклатуры
		               |ГДЕ
		               |	ТИПЗНАЧЕНИЯ(ТоварыВРезервеНаСкладах.Регистратор) = ТИП(Документ.Резервирование)";
		
		Запрос.Текст = ТекстЗапроса;
		//Запрос.УстановитьПараметр("ДокументыРезерва", ДокументыРезерва);
		
		Запрос.УстановитьПараметр("МоментВремени", МоментВремени);
		Запрос.УстановитьПараметр("ВТСписываемыеРезервы", ВТСписываемыеРезервы);
		
		РезультатЗапроса = Запрос.Выполнить().Выгрузить();
		
		МассивРезервированийДляИзмененияСтатуса =  РезультатЗапроса.ВыгрузитьКолонку("Регистратор");
		
		Для Каждого Резервирование Из МассивРезервированийДляИзмененияСтатуса Цикл
			Если МассивИсключаемыхРезервирований.Найти(Резервирование) <> Неопределено Тогда
				ОбщийМодульВызовСервера.НВД_ИзменитьСтатусДокументаРезервирование(Резервирование, Справочники.СтатусыРезервирований.ВРаботе);
			Иначе
				ОбщийМодульВызовСервера.НВД_ИзменитьСтатусДокументаРезервирование(Резервирование, Справочники.СтатусыРезервирований.ВРаботе);
			КонецЕсли;		
		КонецЦикла;	
		
	КонецЕсли;
