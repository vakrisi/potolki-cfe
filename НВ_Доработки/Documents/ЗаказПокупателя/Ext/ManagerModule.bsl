Функция ПолучитьЗаявкуНаДоставку(ЗаказПокупателя)
	
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ЗаявкаНаДоставкуОснования.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаявкаНаДоставку.Основания КАК ЗаявкаНаДоставкуОснования
	|ГДЕ
	|	ЗаявкаНаДоставкуОснования.Основание = &Основание
	|	И НЕ ЗаявкаНаДоставкуОснования.Ссылка.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЗаявкаНаДоставкуОснования.Ссылка.Дата";
	Запрос.УстановитьПараметр("Основание", ЗаказПокупателя);
	
	ТЗЗаявокНаДоставку = Запрос.Выполнить().Выгрузить();
	Если ТЗЗаявокНаДоставку.Количество() > 0 Тогда
		Возврат ТЗЗаявокНаДоставку[0].Ссылка.ПолучитьОбъект();	
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ПолучитьСоответствияПотолокГарпун(ТаблицаМатериалов = Неопределено)
	 
	СоответствиеПотолокГарпун = Новый Соответствие;
	
	Если ТаблицаМатериалов = Неопределено Тогда
		Возврат СоответствиеПотолокГарпун;
	КонецЕсли; 
	
	ТЗПотолки = ТаблицаМатериалов.Скопировать(,"Потолок");
	ТЗПотолки.Свернуть("Потолок");
	
	ТЗМатериалы = ТаблицаМатериалов.Скопировать(,"Номенклатура, Потолок");
	
	Для Каждого СтрокаПотолок Из ТЗПотолки Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаПотолок.Потолок) Тогда
			Продолжить;
		КонецЕсли;
		
		НайденныеСтроки = ТЗМатериалы.НайтиСтроки(Новый Структура("Потолок", СтрокаПотолок.Потолок));
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			Если НЕ ЗначениеЗаполнено(НайденнаяСтрока.Номенклатура) Тогда
				Продолжить;
			КонецЕсли;
			
			Если ПринадлежитГруппеГарпун(НайденнаяСтрока.Номенклатура) Тогда
				СоответствиеПотолокГарпун.Вставить(СтрокаПотолок.Потолок, НайденнаяСтрока.Номенклатура);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат СоответствиеПотолокГарпун;
	
КонецФункции 

Функция ПринадлежитГруппеГарпун(Номенклатура)
	
	 Возврат Номенклатура.ПринадлежитЭлементу(Справочники.Номенклатура.НайтиПоКоду("000000009"));
		
КонецФункции
