	|	ДанныеДокумента.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ДанныеДокумента.СерияНоменклатуры КАК СерияНоменклатуры,
	|	ДанныеДокумента.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ДанныеДокумента.Коэффициент КАК Коэффициент,
	|	ДанныеДокумента.Количество КАК Количество,
	|	ДанныеДокумента.Цена КАК Цена,
	|	ДанныеДокумента.ЦенаВал КАК ЦенаВал,
	|	ДанныеДокумента.Сумма КАК Сумма,
	|	ДанныеДокумента.ПроцентРучнойСкидки КАК ПроцентРучнойСкидки,
	|	ДанныеДокумента.СуммаРучнойСкидки КАК СуммаРучнойСкидки,
	|	ДанныеДокумента.СуммаРучнойСкидки + ДанныеДокумента.СкидкаБонусами КАК Скидка,
	|	ДанныеДокумента.СкидкаБонусами КАК СкидкаБонусами,
	|	ДанныеДокумента.Сумма + ДанныеДокумента.СуммаРучнойСкидки + ДанныеДокумента.СкидкаБонусами КАК СуммаБезСкидки,
	|	ДанныеДокумента.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
	|	ДанныеДокумента.НомерУпаковки КАК НомерУпаковки,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ДанныеДокумента.ЕдиницаИзмерения) = ТИП(Справочник.ЕдиницыИзмерений)
	|			ТОГДА ДанныеДокумента.ЕдиницаИзмерения.Вес * ДанныеДокумента.Количество
	|		ИНАЧЕ ДанныеДокумента.Номенклатура.Вес * ДанныеДокумента.Количество
	|	КОНЕЦ КАК Вес,
	|	ДанныеДокумента.Потолок КАК Потолок,
	|	ДанныеДокумента.СтавкаНДС КАК СтавкаНДС,
	|	ДанныеДокумента.СуммаНДС КАК СуммаНДС,
	|	НоменклатураСкладскиеЯчейки.Ячейка КАК Ячейка
	|ИЗ
	|	Документ.ЗаказПокупателя.Товары КАК ДанныеДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура.СкладскиеЯчейки КАК НоменклатураСкладскиеЯчейки
	|		ПО ДанныеДокумента.Номенклатура = НоменклатураСкладскиеЯчейки.Ссылка
	|			И ДанныеДокумента.Ссылка.Склад = НоменклатураСкладскиеЯчейки.Склад
	|ГДЕ
	|	ДанныеДокумента.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДанныеДокумента.Ссылка,
//	|	Ячейка,
	|	ДанныеДокумента.НомерСтроки
	|ИТОГИ
	|	КОЛИЧЕСТВО(НомерСтроки),
	|	СУММА(Сумма),
	|	СУММА(СуммаРучнойСкидки),
	|	СУММА(Скидка),
	|	СУММА(Вес),
	|	СУММА(СуммаНДС)
	|ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ДанныеДокумента.Ссылка КАК Ссылка,
	|	ДанныеДокумента.НомерУпаковки КАК НомерУпаковки
	|ИЗ
	|	Документ.ЗаказПокупателя.Товары КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДанныеДокумента.Ссылка
	|ИТОГИ ПО
	|	Ссылка";
	
	МассивРезультатов         = Запрос.ВыполнитьПакет();
	РезультатПоШапке          = МассивРезультатов[2];
	РезультатПоТабличнойЧастиТовары = МассивРезультатов[3];
	РезультатПоНомерамУпаковки      = МассивРезультатов[4];
	
	ЗапросСуммаНеоплаченныхЗаказовКонтрагента = Новый Запрос;
	ЗапросСуммаНеоплаченныхЗаказовКонтрагента.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	ЗапросСуммаНеоплаченныхЗаказовКонтрагента.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказПокупателя.Ссылка КАК Ссылка,
	|	ЗаказПокупателя.Контрагент КАК Контрагент,
	|	ЗаказПокупателя.СуммаДокумента КАК СуммаДокумента,
	|	РасчетыПоЗаказам.СуммаНеоплаченныхЗаказов КАК СуммаНеоплаченныхЗаказов
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ЗаказПокупателя.Контрагент КАК Контрагент,
	|			СУММА(ЕСТЬNULL(РасчетыПоЗаказамОстатки.СуммаОстаток, 0)) КАК СуммаНеоплаченныхЗаказов
	|		ИЗ
	|			РегистрНакопления.РасчетыПоЗаказам.Остатки КАК РасчетыПоЗаказамОстатки
	|				ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|				ПО РасчетыПоЗаказамОстатки.Заказ = ЗаказПокупателя.Ссылка
	|		ГДЕ
	|			ЗаказПокупателя.Проведен
	|			И ЗаказПокупателя.ТекущийСтатус = ЗНАЧЕНИЕ(Справочник.СтатусыЗаказовПокупателей.ВРаботе)
	|			И НЕ ЗаказПокупателя.Ссылка В (&МассивОбъектов)
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ЗаказПокупателя.Контрагент) КАК РасчетыПоЗаказам
	|		ПО (ЗаказПокупателя.Контрагент = РасчетыПоЗаказам.Контрагент)
	|ГДЕ
	|	ЗаказПокупателя.Ссылка В (&МассивОбъектов)";
	
	РезультатПоНеоплаченнымЗаказам = ЗапросСуммаНеоплаченныхЗаказовКонтрагента.Выполнить();
	
	ЗапросСписокЗаказовКонтрагента = Новый Запрос;
	ЗапросСписокЗаказовКонтрагента.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	ЗапросСписокЗаказовКонтрагента.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(РасчетыПоЗаказамОстатки.СуммаОстаток, 0) КАК СуммаНеоплаченногоЗаказа,
	|	РасчетыПоЗаказамОстатки.Заказ.Ссылка КАК Заказ,
	|	РасчетыПоЗаказамОстатки.Заказ.Контрагент КАК Контрагент,
	|	РасчетыПоЗаказамОстатки.Заказ.Номер КАК НомерЗаказа,
	|	РасчетыПоЗаказамОстатки.Заказ.Дата КАК ДатаЗаказа
	|ИЗ
	|	(ВЫБРАТЬ
	|		ЗаказПокупателя.Контрагент КАК Контрагент
	|	ИЗ
	|		Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|	ГДЕ
	|		ЗаказПокупателя.Ссылка В(&МассивОбъектов)
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ЗаказПокупателя.Контрагент) КАК Контрагенты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасчетыПоЗаказам.Остатки КАК РасчетыПоЗаказамОстатки
	|		ПО (Контрагенты.Контрагент = РасчетыПоЗаказамОстатки.Контрагент)
	|ГДЕ
	|	РасчетыПоЗаказамОстатки.Заказ.Проведен
	|	И РасчетыПоЗаказамОстатки.Заказ.ТекущийСтатус = ЗНАЧЕНИЕ(Справочник.СтатусыЗаказовПокупателей.ВРаботе)
	|   И НЕ РасчетыПоЗаказамОстатки.Заказ В (&МассивОбъектов)";
	
	РезультатПоСпискуНеоплаченныхЗаказов = ЗапросСписокЗаказовКонтрагента.Выполнить();
	
	ЗапросСписокПеремещенийНаОснованииЗаказа = Новый Запрос;
	ЗапросСписокПеремещенийНаОснованииЗаказа.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	ЗапросСписокПеремещенийНаОснованииЗаказа.Текст = 
	"ВЫБРАТЬ
	|	ПеремещениеТоваров.Ссылка КАК Перемещение,
	|	ПеремещениеТоваров.Номер КАК Номер,
	|	ПеремещениеТоваров.Дата КАК Дата,
	|	ПеремещениеТоваров.Основание КАК Заказ,
	|	ПеремещениеТоваров.ТекущийСтатус КАК ТекущийСтатус
	|ИЗ
	|	Документ.ПеремещениеТоваров КАК ПеремещениеТоваров
	|ГДЕ
	|	ПеремещениеТоваров.Основание В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата";
	
	РезультатПоСпискуПеремещенийНаОснованииЗаказа = ЗапросСписокПеремещенийНаОснованииЗаказа.Выполнить();
	
	ЗапросПоТабличнойЧастиМатериалы = Новый Запрос;
	ЗапросПоТабличнойЧастиМатериалы.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	ЗапросПоТабличнойЧастиМатериалы.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказПокупателяМатериалы.Ссылка КАК Ссылка,
	|	ЗаказПокупателяМатериалы.НомерСтроки КАК НомерСтроки,
	|	ЗаказПокупателяМатериалы.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ЗаказПокупателяМатериалы.ЗагруженоИзПостроителя КАК ЗагруженоИзПостроителя,
	|	ЗаказПокупателяМатериалы.Количество КАК Количество,
	|	ЗаказПокупателяМатериалы.КоличествоКВыработке КАК КоличествоКВыработке,
	|	ЗаказПокупателяМатериалы.Коэффициент КАК Коэффициент,
	|	ЗаказПокупателяМатериалы.Номенклатура КАК Номенклатура,
	|	ЗаказПокупателяМатериалы.Потолок КАК Потолок,
	|	ЗаказПокупателяМатериалы.СерияНоменклатуры КАК СерияНоменклатуры,
	|	ЗаказПокупателяМатериалы.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ЗаказПокупателяМатериалы.УИСтроки КАК УИСтроки
	|ИЗ
	|	Документ.ЗаказПокупателя.Материалы КАК ЗаказПокупателяМатериалы
	|ГДЕ
	|	ЗаказПокупателяМатериалы.Ссылка В (&МассивОбъектов)";
	
	ТаблицаМатериалов = ЗапросПоТабличнойЧастиМатериалы.Выполнить().Выгрузить();
	
	СоответствияПотолокГарпун = ПолучитьСоответствияПотолокГарпун(ТаблицаМатериалов); 
	
	ЗапросПоQRКодамДляОплаты = Новый Запрос;
	ЗапросПоQRКодамДляОплаты.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	ЗапросПоQRКодамДляОплаты.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СБП_QRКоды.qrcId КАК qrcId,
	|	СБП_QRКоды.status КАК status,
	|	СБП_QRКоды.ДатаГенерации КАК ДатаГенерации,
	|	СБП_QRКоды.imageParams_mediaType КАК imageParams_mediaType,
	|	СБП_QRКоды.imageParams_content КАК imageParams_content,
	|	СБП_QRКоды.amount КАК amount,
	|	СБП_QRКоды.payload КАК payload,
	|	СБП_QRКоды.qrcType КАК qrcType,
	|	СБП_QRКоды.imageParams_height КАК imageParams_height,
	|	СБП_QRКоды.imageParams_width КАК imageParams_width,
	|	СБП_QRКоды.Заказ КАК Заказ
	|ИЗ
	|	РегистрСведений.СБП_QRКоды КАК СБП_QRКоды
	|ГДЕ
	|	СБП_QRКоды.Заказ В(&МассивОбъектов)";
	
	ТаблицаQRКодовДляОплаты = ЗапросПоQRКодамДляОплаты.Выполнить().Выгрузить();
	
	СтруктураДанныхДляПечати 	= Новый Структура("РезультатПоШапке, РезультатПоТабличнойЧастиТовары, РезультатПоНомерамУпаковки, РезультатПоНеоплаченнымЗаказам, РезультатПоСпискуНеоплаченныхЗаказов, СоответствияПотолокГарпун, ТаблицаQRКодовДляОплаты, РезультатПоСпискуПеремещенийНаОснованииЗаказа",
	РезультатПоШапке, РезультатПоТабличнойЧастиТовары, РезультатПоНомерамУпаковки, РезультатПоНеоплаченнымЗаказам, РезультатПоСпискуНеоплаченныхЗаказов, СоответствияПотолокГарпун, ТаблицаQRКодовДляОплаты, РезультатПоСпискуПеремещенийНаОснованииЗаказа);
	Возврат СтруктураДанныхДляПечати;
	
КонецФункции

Функция ПолучитьДанныеДляПечатныхФорм3(МассивОбъектов)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказПокупателя.Ссылка КАК Ссылка,
	|	ЗаказПокупателя.Организация КАК Организация,
	|	ЗаказПокупателя.Контрагент КАК Контрагент,
	|	ЗаказПокупателя.СуммаДокумента КАК СуммаДокумента,
	|	ЗаказПокупателя.НастройкаИнтеркампани КАК НастройкаИнтеркампани
	|ПОМЕСТИТЬ ВТ_Заказы
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|ГДЕ
	|	ЗаказПокупателя.Ссылка В(&МассивОбъектов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеРегистра.Заказ КАК Ссылка,
	|	ЕСТЬNULL(ДанныеРегистра.СуммаРасход, 0) КАК Оплачено,
	|	ЕСТЬNULL(ДанныеРегистра.СуммаПриход, 0) - ЕСТЬNULL(ДанныеРегистра.СуммаРасход, 0) КАК КОплате,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВТ_Заказы.СуммаДокумента, 0) = 0
	|				ИЛИ ЕСТЬNULL(ДанныеРегистра.СуммаРасход, 0) = 0
	|			ТОГДА ""НЕ ОПЛАЧЕН""
	|		КОГДА ЕСТЬNULL(ВТ_Заказы.СуммаДокумента, 0) = ЕСТЬNULL(ДанныеРегистра.СуммаРасход, 0)
	|				И ЕСТЬNULL(ДанныеРегистра.СуммаРасход, 0) > 0
	|			ТОГДА ""ОПЛАЧЕН""
	|		КОГДА ЕСТЬNULL(ВТ_Заказы.СуммаДокумента, 0) < ЕСТЬNULL(ДанныеРегистра.СуммаРасход, 0)
	|				И ЕСТЬNULL(ДанныеРегистра.СуммаРасход, 0) > 0
	|			ТОГДА ""ЧАСТ. ОПЛАЧЕН""
	|		ИНАЧЕ ""НЕ ОПЛАЧЕН""
	|	КОНЕЦ КАК СостояниеОплаты
	|ПОМЕСТИТЬ ВТ_СостоянияОплатыЗаказов
	|ИЗ
	|	ВТ_Заказы КАК ВТ_Заказы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.РасчетыПоЗаказам.Обороты(, , , Заказ В (&МассивОбъектов)) КАК ДанныеРегистра
	|		ПО ВТ_Заказы.Ссылка = ДанныеРегистра.Заказ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеДокумента.Ссылка КАК Ссылка,
	|	ДанныеДокумента.Номер КАК Номер,
	|	ДанныеДокумента.Дата КАК ДатаДокумента,
	|	""01.01.0001"" КАК Дата,
	|	ДанныеДокумента.АдресМонтажа КАК АдресМонтажа,
	|	ДанныеДокумента.Валюта КАК Валюта,
	|	ДанныеДокумента.ВидЦен КАК ВидЦен,
	|	ДанныеДокумента.Организация КАК Организация,
	|	ВЫБОР
	|		КОГДА НЕ ДанныеДокумента.Организация.ПолноеНаименование = """"
	|			ТОГДА ДанныеДокумента.Организация.ПолноеНаименование
	|		ИНАЧЕ ДанныеДокумента.Организация.Наименование
	|	КОНЕЦ КАК ПредставлениеОрганизации,
	|	ДанныеДокумента.Склад КАК Склад,
	|	ДанныеДокумента.БанковскийСчет КАК БанковскийСчет,
	|	ДанныеДокумента.БанковскийСчет.НомерСчета КАК БанковскийСчетНомерСчета,
	|	ДанныеДокумента.БанковскийСчет.БИК КАК БанковскийСчетБИК,
	|	ДанныеДокумента.БанковскийСчет.КоррСчет КАК БанковскийСчетКоррСчет,
	|	ДанныеДокумента.БанковскийСчет.НаименованиеБанка КАК БанковскийСчетНаименованиеБанка,
	|	ДанныеДокумента.ИнтернетОплатаСсылка КАК ИнтернетОплатаСсылка,
	|	ДанныеДокумента.ИнтернетОплатаНомерТелефонаПлательщика КАК ИнтернетОплатаНомерТелефонаПлательщика,
	|	ДанныеДокумента.ИнтернетОплатаЭлектроннаяПочтаПлательщика КАК ИнтернетОплатаЭлектроннаяПочтаПлательщика,
	|	ДанныеДокумента.Организация.ИНН КАК ИНН,
	|	ДанныеДокумента.Организация.КПП КАК КПП,
	|	ДанныеДокумента.Организация.Руководитель КАК ОрганизацияРуководитель,
	|	ДанныеДокумента.Организация.ГлавныйБухгалтер КАК ОрганизацияГлавныйБухгалтер,
	|	ДанныеДокумента.Организация.ПолноеНаименование КАК ОрганизацияПолноеНаименование,
	|	ДанныеДокумента.Организация.ЯвляетсяПлательщикомНДС КАК ОрганизацияЯвляетсяПлательщикомНДС,
	|	ДанныеДокумента.Контрагент КАК Контрагент,
	|	ДанныеДокумента.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ВЫБОР
	|		КОГДА НЕ ДанныеДокумента.Контрагент.НаименованиеПолное = """"
