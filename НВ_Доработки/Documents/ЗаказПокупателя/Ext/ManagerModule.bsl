					ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаблицыНеоплаченныхЗаказов|Артикул");
					ТабличныйДокумент.Присоединить(ОбластьМакета);
				КонецЕсли;	
				
				ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаблицыНеоплаченныхЗаказов|Данные");
				ТабличныйДокумент.Присоединить(ОбластьМакета);
			Исключение
			КонецПопытки;
			
			Попытка 
				
				ИтогоСуммаНеоплаченныхЗаказов = 0;
				Для Каждого НеоплаченныйЗаказ Из НайденныеСтрокиТаблицыНеоплаченныхЗаказов Цикл
						
					СуммаНеоплаченныхЗаказов = НеоплаченныйЗаказ.СуммаНеоплаченногоЗаказа;
					
					ОбластьМакета = Макет.ПолучитьОбласть("СтрокаТаблицыНеоплаченныхЗаказов|НомерСтроки");
					ТабличныйДокумент.Вывести(ОбластьМакета);
					
					Если ВыводитьАртикул Тогда
						ОбластьМакета = Макет.ПолучитьОбласть("СтрокаТаблицыНеоплаченныхЗаказов|Артикул");
						ТабличныйДокумент.Присоединить(ОбластьМакета);
					КонецЕсли;	
					
					ОбластьМакета = Макет.ПолучитьОбласть("СтрокаТаблицыНеоплаченныхЗаказов|Данные");
					ОбластьМакета.Параметры.ДатаЗаказа = Формат(НеоплаченныйЗаказ.ДатаЗаказа, "ДФ=dd.MM.yyyy");
					ОбластьМакета.Параметры.НомерЗаказа = Формат(НеоплаченныйЗаказ.НомерЗаказа, "ЧФ=Ч"); 
					ОбластьМакета.Параметры.СуммаНеоплаченныхЗаказов = НеоплаченныйЗаказ.СуммаНеоплаченногоЗаказа;
					ТабличныйДокумент.Присоединить(ОбластьМакета);
					ИтогоСуммаНеоплаченныхЗаказов = ИтогоСуммаНеоплаченныхЗаказов + НеоплаченныйЗаказ.СуммаНеоплаченногоЗаказа
					
				КонецЦикла;

			
			
				ОбластьМакета = Макет.ПолучитьОбласть("ИтогоТаблицыНеоплаченныхЗаказов|НомерСтроки");
				ТабличныйДокумент.Вывести(ОбластьМакета);
				
				Если ВыводитьАртикул Тогда
					ОбластьМакета = Макет.ПолучитьОбласть("ИтогоТаблицыНеоплаченныхЗаказов|Артикул");
					ТабличныйДокумент.Присоединить(ОбластьМакета);
				КонецЕсли;	
				
				ОбластьМакета = Макет.ПолучитьОбласть("ИтогоТаблицыНеоплаченныхЗаказов|Данные");
				ОбластьМакета.Параметры.ИтогоСуммаНеоплаченныхЗаказов = ИтогоСуммаНеоплаченныхЗаказов;
				ТабличныйДокумент.Присоединить(ОбластьМакета);

			Исключение
				
			КонецПопытки;
		КонецЕсли;
		
		// В табличном документе необходимо задать имя области, в которую был 
		// выведен объект. Нужно для возможности печати комплектов документов.
		Если НЕ ОбъектыПечати = Неопределено Тогда
			УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, 
			НомерСтрокиНачало, ОбъектыПечати, ДанныеПечати.Ссылка);
		КонецЕсли;	
	КонецЦикла;
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция НВД_ПечатьЗаказПокупателя3(МассивОбъектов, ОбъектыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб         = Истина; //#14053
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_ТоварнаяНакладнаяСВесом3";
	//#Вставка
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ЗаказПокупателя.НВД_ПФ_MXL_ЗаказПокупателя3");
	//#КонецВставки
	//#Удаление
	//Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ЗаказПокупателя.ПФ_MXL_ЗаказПокупателя");
	//#КонецУдаления
	ВыводитьАртикул = Константы.ВыводитьАртикулНоменклатурыВПечатныхФормах.Получить();
	
	СтруктураДанныхДляПечати = ПолучитьДанныеДляПечатныхФорм3(МассивОбъектов);
	ТаблицаДанныеПечати = СтруктураДанныхДляПечати.РезультатПоШапке.Выгрузить();
	ТаблицаНеоплаченныеЗаказы = СтруктураДанныхДляПечати.РезультатПоНеоплаченнымЗаказам.Выгрузить();
	ТаблицаНеоплаченныхЗаказов = СтруктураДанныхДляПечати.РезультатПоСпискуНеоплаченныхЗаказов.Выгрузить();
	ВыборкаПоТоварам = СтруктураДанныхДляПечати.РезультатПоТабличнойЧастиТовары.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ДополнитьДанныеДляПечатныхФорм(ТаблицаДанныеПечати, ВыборкаПоТоварам);
	СоответствияПотолокГарпун = СтруктураДанныхДляПечати.СоответствияПотолокГарпун;
	ТаблицаQRКодовДляОплаты = СтруктураДанныхДляПечати.ТаблицаQRКодовДляОплаты;
	//ДополнитьДаннымиПоМатериалам(ТаблицаДанныеПечати, ТаблицаМатериалы);
	// Изменения размера колоноки, в зависимости от вывода Артикула
	Если Не ВыводитьАртикул Тогда
		Попытка
			Макет.Область("ПерваяКолонкаТовара").ШиринаКолонки = Макет.Область("ПерваяКолонкаТовара").ШиринаКолонки + Макет.Область("Артикул").ШиринаКолонки;
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	ПервыйДокумент = Истина;
	Для Каждого ДанныеПечати Из ТаблицаДанныеПечати Цикл
		
		Если Не ПервыйДокумент Тогда
			// Все документы нужно выводить на разных страницах.
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент = Ложь;
		// Запомним номер строки, с которой начали выводить текущий документ.
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		ЕстьСкидка = ДанныеПечати.СуммаРучнойСкидки > 0;		
		ЕстьБонусы = ДанныеПечати.СуммаБонусовКСписанию > 0;		
		
		ВставкаСкидок = ?(ЕстьСкидка, "Скидка","");
		ВставкаСкидок = ?(ЕстьБонусы, ВставкаСкидок+"Бонус", ВставкаСкидок);
		
		//ТекстЗаголовка = "Заказ покупателя №" + ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ДанныеПечати.Номер) + " от " + Формат(ДанныеПечати.ДатаДокумента, "ДЛФ=DD");
		НомерЗаказа = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ДанныеПечати.Номер);
		ДатаЗаказа = Формат(ДанныеПечати.ДатаДокумента, "ДЛФ=DD");
		
		Попытка
			//ОбластьМакета = Макет.ПолучитьОбласть("Заголовок"); 
			ОбластьМакета = Макет.ПолучитьОбласть("ЗаголовокКрупный");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			Попытка				
				//ОбластьМакета.Параметры.ТекстЗаголовка = ТекстЗаголовка; 
				ОбластьМакета.Параметры.НомерЗаказа = НомерЗаказа;
				ОбластьМакета.Параметры.ДатаЗаказа = ДатаЗаказа;
			Исключение
			КонецПопытки;
			
			ШтрихкодированиеПечатныхФорм.ВывестиШтрихкодВТабличныйДокумент(
			ТабличныйДокумент,
			Макет,
			ОбластьМакета,
			ДанныеПечати.Ссылка);
			
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение
		КонецПопытки;
		
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("Организация");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение
		КонецПопытки;
		
		//#13343 
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("Склад");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение
		КонецПопытки;
		
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("Покупатель");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение
		КонецПопытки;
		
		//#Вставка 
		МассивСсылокНаДоставки = НВД_ОбщийМодульСервер.ПолучитьМассивСсылокНаДоставки(ДанныеПечати.Ссылка);
		//берем данные только из первого документв Доставки, так как предполагается, что к одному заказу клиента может быть привязана 1 доставка
		Если МассивСсылокНаДоставки.Количество() > 0 И МассивСсылокНаДоставки[0].Результат <> Справочники.СтатусыЗаявокНаДоставку.Отказ И МассивСсылокНаДоставки[0].Проведен Тогда
			ЗаявкаНаДоставку = МассивСсылокНаДоставки[0];
			Попытка 
				Если ЗначениеЗаполнено(ЗаявкаНаДоставку.ТелефонКонтактногоЛица) Тогда
					ОбластьМакета = Макет.ПолучитьОбласть("КонтактноеЛицо");					
					ОбластьМакета.Параметры.КонтактноеЛицо = "" + ЗаявкаНаДоставку.ТелефонКонтактногоЛица;
					ТабличныйДокумент.Вывести(ОбластьМакета);
				ИначеЕсли ЗначениеЗаполнено(ЗаявкаНаДоставку.НВД_КонтактноеЛицо) Тогда
					ОбластьМакета = Макет.ПолучитьОбласть("КонтактноеЛицо");					
					ОбластьМакета.Параметры.КонтактноеЛицо = "" + ЗаявкаНаДоставку.НВД_КонтактноеЛицо.Наименование + "" + НВД_ОбщийМодульСервер.ПолучитьТелефонКонтактногоЛица(ЗаявкаНаДоставку.НВД_КонтактноеЛицо);
					ТабличныйДокумент.Вывести(ОбластьМакета);
				КонецЕсли;	
			Исключение
			КонецПопытки;					
			Попытка
				Если ЗначениеЗаполнено(ЗаявкаНаДоставку.ОжидаемаяДатаОтправки) ИЛИ ЗначениеЗаполнено(ЗаявкаНаДоставку.ОжидаемаяДатаДоставки) Тогда
					ОбластьМакета = Макет.ПолучитьОбласть("ДатаДоставки");
				    
					//ОбластьМакета.Параметры.ОжидаемаяДатаОтгрузки = Формат(ЗаявкаНаДоставку.ОжидаемаяДатаОтправки, "ДФ=dd.MM.yy; ДЛФ=D");
					//ОбластьМакета.Параметры.ОжидаемоеВремяОтгрузки = Формат(ЗаявкаНаДоставку.ОжидаемаяДатаОтправки, "ДФ=HH.mm; ДЛФ=T");
					ОбластьМакета.Параметры.КрайняяДатаОтгрузки = "" + Формат(ЗаявкаНаДоставку.ОжидаемаяДатаДоставки, "ДФ='dd.MM.yy HH:00'") + " - " + Формат(ЗаявкаНаДоставку.ОжидаемаяДатаДоставки + 3600, "ДФ='HH:00'");
					//ОбластьМакета.Параметры.КрайнееВремяОтгрузки = Формат(ЗаявкаНаДоставку.ОжидаемаяДатаДоставки, "ДФ=HH.mm; ДЛФ=T");
					
					ТабличныйДокумент.Вывести(ОбластьМакета);
				КонецЕсли;
			Исключение
			КонецПопытки;

			Попытка
				Если ЗначениеЗаполнено(ЗаявкаНаДоставку.АдресДоставки) Тогда
					ОбластьМакета = Макет.ПолучитьОбласть("АдресДоставки"); 
					ОбластьМакета.Параметры.АдресДоставки = "" + ЗаявкаНаДоставку.Город + " " + ЗаявкаНаДоставку.АдресДоставки;
					ТабличныйДокумент.Вывести(ОбластьМакета);
				КонецЕсли;	
			Исключение
			КонецПопытки;
		КонецЕсли;	
		//#КонецВставки
		
		//#13343
		//#Удаление
		Если ЗначениеЗаполнено(ДанныеПечати.АдресМонтажа) Тогда
			Попытка
				ОбластьМакета = Макет.ПолучитьОбласть("АдресМонтажа");
				ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
				ТабличныйДокумент.Вывести(ОбластьМакета);
			Исключение
			КонецПопытки;
		КонецЕсли;
		//#КонецУдаления
		//// Изменения размера колоноки, в зависимости от вывода Артикула
		//Если Не ВыводитьАртикул Тогда
		//	Попытка
		//		Макет.Область("ПерваяКолонкаТовара").ШиринаКолонки = Макет.Область("ПерваяКолонкаТовара").ШиринаКолонки + Макет.Область("Артикул").ШиринаКолонки;
		//	Исключение
		//	КонецПопытки;
		//КонецЕсли;
		
		Попытка
			Если ЗначениеЗаполнено(ДанныеПечати.Комментарий) Тогда
				ОбластьМакета = Макет.ПолучитьОбласть("Комментарий"); 
				ОбластьМакета.Параметры.Комментарий = ДанныеПечати.Комментарий;
				ТабличныйДокумент.Вывести(ОбластьМакета);
			КонецЕсли;	
		Исключение
		КонецПопытки;
		
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("Внимание1");
			//ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Вывести(ОбластьМакета);
		Исключение
		КонецПопытки; 
		
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаблицы"+ВставкаСкидок+"|НомерСтроки");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Вывести(ОбластьМакета);
			
			Если ВыводитьАртикул Тогда
				ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаблицы"+ВставкаСкидок+"|Артикул");
				ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
				ТабличныйДокумент.Присоединить(ОбластьМакета);
			КонецЕсли;	
			
			ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаблицы"+ВставкаСкидок+"|Данные");
			ОбластьМакета.Параметры.Заполнить(ДанныеПечати);
			ТабличныйДокумент.Присоединить(ОбластьМакета);
			
		Исключение
		КонецПопытки;
		
		// подготовим табличную часть в зависимости от варианта формирования ПФ счета на оплату
		ВариантФормированияПФЗаказаПокупателя = Константы.ВариантФормированияПФЗаказаПокупателя.Получить();
		
		МассивДопРеквизитов = Новый Массив;
		МассивДопРеквизитов.Добавить(Новый Структура("Имя, Тип", "Артикул", 			Новый ОписаниеТипов("Строка")));
		МассивДопРеквизитов.Добавить(Новый Структура("Имя, Тип", "Вес", 				Новый ОписаниеТипов("Число")));
		МассивДопРеквизитов.Добавить(Новый Структура("Имя, Тип", "Скидка", 				Новый ОписаниеТипов("Число")));
		МассивДопРеквизитов.Добавить(Новый Структура("Имя, Тип", "СуммаБезСкидки", 		Новый ОписаниеТипов("Число")));
		
		МассивДопРеквизитов.Добавить(Новый Структура("Имя, Тип", "ВидНоменклатуры", 	Новый ОписаниеТипов("Число")));
		МассивДопРеквизитов.Добавить(Новый Структура("Имя, Тип", "ЕстьПотолок", 		Новый ОписаниеТипов("Число")));
		МассивДопРеквизитов.Добавить(Новый Структура("Имя, Тип", "ЭтоПотолок", 			Новый ОписаниеТипов("Булево")));
		МассивДопРеквизитов.Добавить(Новый Структура("Имя, Тип", "НомерСтрокиПотолка", 	Новый ОписаниеТипов("Число")));
		
		//МассивДопРеквизитов.Добавить(Новый Структура("Имя, Тип", "Ячейка", 	            Новый ОписаниеТипов("Строка")));
		
		ТаблицаТоварыИУслуги = ОбщийМодульСервер.ТаблицаЗначенийПоТабличнойЧастиОбъекта("ЗаказПокупателя", "Товары", МассивДопРеквизитов);
		СтруктураПоиска = Новый Структура("Ссылка", ДанныеПечати.Ссылка);		
		ВыборкаПоТоварам.Сбросить();
		
		СоответствиеНомеровСтрокПотолков = Новый Соответствие;
		Если ВыборкаПоТоварам.НайтиСледующий(СтруктураПоиска) Тогда			
			Выборка = ВыборкаПоТоварам.Выбрать();			
			Пока Выборка.Следующий() Цикл
				ТекущаяСтрока = ТаблицаТоварыИУслуги.Добавить();
				ЗаполнитьЗначенияСвойств(ТекущаяСтрока, Выборка);
				
