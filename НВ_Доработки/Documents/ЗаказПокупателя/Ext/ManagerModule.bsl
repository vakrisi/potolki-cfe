	|	ПОДСТРОКА(""0123456789"", ЧАС(ДанныеДокумента.НВД_ВремяСамовывоза) / 10 + 1, 1) + ПОДСТРОКА(""0123456789"", СЕКУНДА(ДОБАВИТЬКДАТЕ(ДАТАВРЕМЯ(1, 1, 1), СЕКУНДА, 6 * ЧАС(ДанныеДокумента.НВД_ВремяСамовывоза))) / 6 + 1, 1) + "":"" + ПОДСТРОКА(""0123456789"", МИНУТА(ДанныеДокумента.НВД_ВремяСамовывоза) / 10 + 1, 1) + ПОДСТРОКА(""0123456789"", СЕКУНДА(ДОБАВИТЬКДАТЕ(ДАТАВРЕМЯ(1, 1, 1), СЕКУНДА, 6 * МИНУТА(ДанныеДокумента.НВД_ВремяСамовывоза))) / 6 + 1, 1) КАК ВремяСамовывоза,
