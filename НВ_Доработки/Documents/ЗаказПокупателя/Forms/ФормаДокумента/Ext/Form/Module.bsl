&НаКлиенте
Процедура УстановитьДоступностьЭлементовФормы(ВыбранноеЗначение, ПараметрыОповещения) Экспорт
	
	ЗаполнитьДанныеКОтгрузкеИОстаткиПоТоварам();
	
	//Если есть резерв по данному заказу, то ТЧ товары только просмотр
	ЕстьРезерв = Ложь;
	Для Каждого СтрТовар Из Объект.Товары Цикл
		ЕстьРезерв = СтрТовар.ВРезервеПодДанныйЗаказ > 0;
		Если ЕстьРезерв Тогда
			Прервать;
		КонецЕсли;	
	КонецЦикла;
	
	Элементы.Товары.ТолькоПросмотр = ЕстьРезерв;
	Элементы.ТоварыДобавитьСтрокуПрограммно.Доступность = НЕ ЕстьРезерв И НЕ ЭтаФорма.ТолькоПросмотр;
	Элементы.Доставка.Доступность = НЕ ЕстьРезерв И НЕ ЭтаФорма.ТолькоПросмотр;
	Элементы.ТоварыГруппаДобавитьПотолок.Доступность = НЕ ЕстьРезерв И НЕ ЭтаФорма.ТолькоПросмотр;	
	Элементы.ТоварыДобавить.Доступность = НЕ ЕстьРезерв И НЕ ЭтаФорма.ТолькоПросмотр;
	
	Элементы.ТоварыДерево.ТолькоПросмотр = ЕстьРезерв; 
	Элементы.ТоварыДеревоДобавитьСтрокуТоварыДерево.Доступность = НЕ ЕстьРезерв И НЕ ЭтаФорма.ТолькоПросмотр;
	Элементы.ТоварыДеревоДобавитьСтрокуДоставкаДерево.Доступность = НЕ ЕстьРезерв И НЕ ЭтаФорма.ТолькоПросмотр;
	Элементы.ТоварыДеревоГруппаДобавитьПотолок.Доступность = НЕ ЕстьРезерв И НЕ ЭтаФорма.ТолькоПросмотр;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьЭлементовФормыНаСервере(ВыбранноеЗначение, ПараметрыОповещения) Экспорт
	
	ЗаполнитьДанныеКОтгрузкеИОстаткиПоТоварам();
	
	//Если есть резерв по данному заказу, то ТЧ товары только просмотр
	ЕстьРезерв = Ложь;
	Для Каждого СтрТовар Из Объект.Товары Цикл
		ЕстьРезерв = СтрТовар.ВРезервеПодДанныйЗаказ > 0;
		Если ЕстьРезерв Тогда
			Прервать;
		КонецЕсли;	
	КонецЦикла;
	
	Элементы.Товары.ТолькоПросмотр = ЕстьРезерв;
	Элементы.ТоварыДобавитьСтрокуПрограммно.Доступность = НЕ ЕстьРезерв И НЕ ЭтаФорма.ТолькоПросмотр;
	Элементы.Доставка.Доступность = НЕ ЕстьРезерв И НЕ ЭтаФорма.ТолькоПросмотр;
	Элементы.ТоварыГруппаДобавитьПотолок.Доступность = НЕ ЕстьРезерв И НЕ ЭтаФорма.ТолькоПросмотр;	
	Элементы.ТоварыДобавить.Доступность = НЕ ЕстьРезерв И НЕ ЭтаФорма.ТолькоПросмотр;
	
	Элементы.ТоварыДерево.ТолькоПросмотр = ЕстьРезерв; 
	Элементы.ТоварыДеревоДобавитьСтрокуТоварыДерево.Доступность = НЕ ЕстьРезерв И НЕ ЭтаФорма.ТолькоПросмотр;
	Элементы.ТоварыДеревоДобавитьСтрокуДоставкаДерево.Доступность = НЕ ЕстьРезерв И НЕ ЭтаФорма.ТолькоПросмотр;
	Элементы.ТоварыДеревоГруппаДобавитьПотолок.Доступность = НЕ ЕстьРезерв И НЕ ЭтаФорма.ТолькоПросмотр;
	
КонецПроцедуры

