&НаКлиенте
Процедура НВД_ТоварыПриИзмененииПосле(Элемент)
	Соответствия = НВД_ПолучитьСоответствияПотолокГарпун();
	Для Каждого СтрокаТовары Из Объект.Товары Цикл
		Если Соответствия.Получить(СтрокаТовары.УИСтроки) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СтрокаТовары.Гарпун = Соответствия.Получить(СтрокаТовары.УИСтроки);
	КонецЦикла;	
КонецПроцедуры 

&НаСервере
Функция НВД_ПолучитьСоответствияПотолокГарпун()
	
	СоответствиеПотолокГарпун = Новый Соответствие;
	
	ТЗПотолки = Объект.Материалы.Выгрузить(,"Потолок, УИСтроки");
	ТЗПотолки.Свернуть("Потолок, УИСтроки");
	
	ТЗМатериалы = Объект.Материалы.Выгрузить(,"Номенклатура, Потолок, УИСтроки");
	
	Для Каждого СтрокаПотолок Из ТЗПотолки Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаПотолок.Потолок) Тогда
			Продолжить;
		КонецЕсли;
		
		НайденныеСтроки = ТЗМатериалы.НайтиСтроки(Новый Структура("Потолок", СтрокаПотолок.Потолок));
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			Если НЕ ЗначениеЗаполнено(НайденнаяСтрока.Номенклатура) Тогда
				Продолжить;
			КонецЕсли;
			
			Если ПринадлежитГруппеГарпун(НайденнаяСтрока.Номенклатура) Тогда
				СоответствиеПотолокГарпун.Вставить(НайденнаяСтрока.УИСтроки, НайденнаяСтрока.Номенклатура);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат СоответствиеПотолокГарпун;
		
КонецФункции

&НаСервере
Функция ПринадлежитГруппеГарпун(Номенклатура)
	
	 Возврат Номенклатура.ПринадлежитЭлементу(Справочники.Номенклатура.НайтиПоКоду("000000009"));
		
КонецФункции	

