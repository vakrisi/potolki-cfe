&НаКлиенте
Процедура ТекущийСтатусОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	//Доработка Ярославцев 12.01.23
	Если ПроверитьРоль() Тогда 
		
		Если Объект.ТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЗаказовПокупателей.Новый") Тогда 
			
			Если ВыбранноеЗначение = ПредопределенноеЗначение("Справочник.СтатусыЗаказовПокупателей.Выполнен")
				ИЛИ ВыбранноеЗначение = ПредопределенноеЗначение("Справочник.СтатусыЗаказовПокупателей.Закрыт")
				Тогда 
				ПоказатьПредупреждение(,"Изменение статуса ""Новый"" возможно только на ""В работе"" и ""Отменен""");
				ВыбранноеЗначение = Объект.ТекущийСтатус; 
			КонецЕсли;
			
		ИначеЕсли Объект.ТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЗаказовПокупателей.ВРаботе") ИЛИ
			
			Объект.ТекущийСтатус = ПредопределенноеЗначение("Справочник.СтатусыЗаказовПокупателей.Отменен") Тогда
			
			Если  ВыбранноеЗначение = ПредопределенноеЗначение("Справочник.СтатусыЗаказовПокупателей.Новый") Тогда
				ПоказатьПредупреждение(,"Изменение статуса ""Новый"" не возможно на статус "+ВыбранноеЗначение);
				ВыбранноеЗначение = Объект.ТекущийСтатус;
			КонецЕсли;
			
			Если  ВыбранноеЗначение = ПредопределенноеЗначение("Справочник.СтатусыЗаказовПокупателей.Отменен") Тогда
				ПоказатьПредупреждение(,"Изменение статуса ""Отменен"" не возможно на статус "+ВыбранноеЗначение);
				ВыбранноеЗначение = Объект.ТекущийСтатус;
			КонецЕсли;

			
		КонецЕсли;
		
	КонецЕсли;
	//Доработка Ярославцев 12.01.23
	
	//nva+++
	Если Объект.ТекущийСтатус <> ПредопределенноеЗначение("Справочник.СтатусыЗаказовПокупателей.Новый") 
		И ВыбранноеЗначение = ПредопределенноеЗначение("Справочник.СтатусыЗаказовПокупателей.Новый") 
		И ЕстьЗаявкиНаДоставкиВСтатусеОтправленИлиДоставлен() Тогда
		ПоказатьПредупреждение(,"Изменение статуса не возможно на статус ""Новый"", так как есть Заявка на достаку в статусе ""Отправлен"" или ""Доставлен""");
		ВыбранноеЗначение = Объект.ТекущийСтатус;
	КонецЕсли;	
	//nva---

КонецПроцедуры

