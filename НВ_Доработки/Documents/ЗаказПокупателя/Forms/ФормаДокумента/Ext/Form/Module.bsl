&НаКлиенте
Процедура НВД_СкопироватьСсылкуТекущейНоменклатурыВБуферПосле(Команда)
	
	МассивСтрок = Новый Массив;
	Для Каждого Строка Из Элементы.Товары.ВыделенныеСтроки Цикл
    	НСтроки = объект.Товары.НайтиПоИдентификатору(Строка).НомерСтроки;    
    	МассивСтрок.Добавить(объект.Товары[НСтроки-1]);
	КонецЦикла;
	
	СписокURL = "";
	А = 1;
	Для Каждого ВыделеннаяСтрока Из МассивСтрок Цикл 
		
		URL = ПолучитьURLНоменклатуры(ВыделеннаяСтрока.Номенклатура);
		
		Если НЕ ЗначениеЗаполнено(URL) ИЛИ НЕ ЗначениеЗаполнено(СписокURL) Тогда
			ВК = "";
		Иначе
			ВК = Символы.ВК;
		КонецЕсли;
		
		СписокURL = СписокURL + ВК;
		
		Если ЗначениеЗаполнено(URL) Тогда
			СписокURL = СписокURL + URL;
		КонецЕсли;
		А = А + 1;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(СписокURL) Тогда
		ПутьВременногоФайла = КаталогВременныхФайлов() + "buf.txt";
		Тд = Новый ТекстовыйДокумент;
    	Тд.УстановитьТекст(СписокURL); // Текст = что_копируем_в_буфер
    	Тд.Записать(ПутьВременногоФайла,КодировкаТекста.OEM,Символы.ВК);
    	КомОбъект = Новый COMОбъект("WScript.Shell"); 
		КомОбъект.Run("%comspec% /c type """+ПутьВременногоФайла+""" | clip", 0,0); 
		КомОбъект = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьURLНоменклатуры(Номенклатура)
	СвойствоURL = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя", "Url");
	URL = УправлениеСвойствами.ЗначениеСвойства(Номенклатура, СвойствоURL);
	Возврат URL;
КонецФункции	

