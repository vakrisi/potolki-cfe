&НаСервере
Функция ЕстьЗаявкиНаДоставкиВСтатусеОтправленИлиДоставлен()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаявкаНаДоставкуОснования.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЗаявкаНаДоставку.Основания КАК ЗаявкаНаДоставкуОснования
		|ГДЕ
		|	ЗаявкаНаДоставкуОснования.Основание = &Основание
		|	И (ЗаявкаНаДоставкуОснования.Ссылка.Результат = ЗНАЧЕНИЕ(Справочник.СтатусыЗаявокНаДоставку.Отправлено) ИЛИ 
		|   ЗаявкаНаДоставкуОснования.Ссылка.Результат = ЗНАЧЕНИЕ(Справочник.СтатусыЗаявокНаДоставку.Доставлено))";
	
	Запрос.УстановитьПараметр("Основание", Объект.Ссылка);
	
	Если Запрос.Выполнить().Пустой() Тогда
		Возврат Ложь;
	Иначе 
		Возврат Истина;
	КонецЕсли;
КонецФункции	       
