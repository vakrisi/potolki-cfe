&НаКлиенте
Процедура НВД_СоздатьQRКодПосле(Команда)
	
	Если НЕ Объект.Проведен Тогда
		Сообщение = Новый СообщениеПользователю();
    	Сообщение.Текст = "Создание QR кодов возможно только в проведённом заказе";
    	//Сообщение.Поле = "Контрагент";

    	// Привязка объекта к реквизиту формы "вручную"
    	Сообщение.КлючДанных = Объект.Ссылка;
    	Сообщение.ПутьКДанным = "Объект";

    	// Сообщение выводится пользователю
    	Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	//Проверяем Телефон и Емайл контрагента, что то должно быть обязательно заполнено
	EmailКонтрагента   = ПолучитьEmailКонтрагентаСервер(Объект.Контрагент);
	ТелефонКонтрагента = ПолучитьТелефонКонтрагентаСервер(Объект.Контрагент);
	
	Если НЕ ЗначениеЗаполнено(EmailКонтрагента) И НЕ ЗначениеЗаполнено(ТелефонКонтрагента) Тогда
		Сообщение = Новый СообщениеПользователю();
    	Сообщение.Текст = "У контрагента не заполнен ни телефон, ни email";
    	Сообщение.Поле = "Контрагент";

    	// Привязка объекта к реквизиту формы "вручную"
    	Сообщение.КлючДанных = Объект.Ссылка;
    	Сообщение.ПутьКДанным = "Объект";

    	// Сообщение выводится пользователю
    	Сообщение.Сообщить();
		Возврат;
	КонецЕсли;	
	//Помещаем обработку во временном хранилище
	//АдресХранилища = "";
	//Результат = ПоместитьФайл(АдресХранилища, "C:\Users\nva\Desktop\СБПБанкТочка.epf", , Ложь);
	//ИмяОбработки = ПодключитьВнешнююОбработку(АдресХранилища);
	ПараметрыФормы = Новый Структура("Заказ", Объект);
    // Откроем форму подключенной внешней обработки     
    //ОткрытьФормуМодально("ВнешняяОбработка."+ ИмяОбработки +".Форма.ФормаСозданияНового", ПараметрыФормы,ЭтаФорма);
	//Определяем какую обработку подключать ГПБ или БанкТочка
	
    ИмяОбработки = ПолучитьИмяОбработкиДляФормированияQRКода();
	
	Если ЗначениеЗаполнено(ИмяОбработки) Тогда 
		ОткрытьФормуМодально("Обработка." + ИмяОбработки + ".Форма.ФормаСозданияНового", ПараметрыФормы,ЭтаФорма);
	КонецЕсли;
	
	// ОБНОВИМ динамический список файлы
    Элементы.QRКоды.Обновить();

	// для обновления Реквизитов
	ЭтаФорма.Прочитать();

	// Обновление данных
	ЭтаФорма.ОбновитьОтображениеДанных();
КонецПроцедуры

&НаСервере
Функция ПолучитьИмяОбработкиДляФормированияQRКода()
	
	ИмяОбработки = "";
	
	ОсновнойБанковскийСчетДляСБП = Константы.НВД_ОсновнойБанковскийСчетДляСБП.Получить();
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ЗначениеЗаполнено(ОсновнойБанковскийСчетДляСБП) Тогда
		
		Если ОсновнойБанковскийСчетДляСБП.Банк = Справочники.КлассификаторБанков.НайтиПоКоду("044525104") Тогда
			
			ИмяОбработки = "СБПБанкТочка"; 
			
		ИначеЕсли ОсновнойБанковскийСчетДляСБП.Банк = Справочники.КлассификаторБанков.НайтиПоКоду("044525823") Тогда	
		
			ИмяОбработки = "СБПБанкГПБ"; 
			
		КонецЕсли;	
	
	КонецЕсли;                               
	
	УстановитьПривилегированныйРежим(Истина);
	
	Возврат ИмяОбработки;
	
КонецФункции	

