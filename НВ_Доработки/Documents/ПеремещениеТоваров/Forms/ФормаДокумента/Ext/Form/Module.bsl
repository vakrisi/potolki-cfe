//++ НВД: колонки «Остаток (получатель)» и «Доступно (получатель)» в ТЧ Товары —
// остатки и доступность по складу-получателю (типовые колонки считаются по складу-отправителю).

&НаСервере
&После("ЗаполнитьОстаткиПоТоварам")
Процедура НВД_ЗаполнитьОстаткиПоТоварамПосле()

	НВД_ЗаполнитьОстаткиПоПолучателю();

КонецПроцедуры

&НаКлиенте
&После("СкладПолучательПриИзменении")
Процедура НВД_СкладПолучательПриИзмененииПосле(Элемент)

	НВД_ЗаполнитьОстаткиПоПолучателю();

КонецПроцедуры

&НаСервере
Процедура НВД_ЗаполнитьОстаткиПоПолучателю()

	Если НЕ ЗначениеЗаполнено(Объект.СкладПолучатель) Тогда
		Для Каждого СтрокаТоваров Из Объект.Товары Цикл
			СтрокаТоваров.НВД_ОстатокПолучателя = 0;
			СтрокаТоваров.НВД_ДоступноПолучателя = 0;
		КонецЦикла;
		Возврат;
	КонецЕсли;

	ДатаОстатков = ?(НЕ Объект.Ссылка.Пустая(), Объект.Дата, ТекущаяДатаСеанса());

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаДокумента",			Объект.Товары.Выгрузить());
	Запрос.УстановитьПараметр("Организация",				Объект.Организация);
	Запрос.УстановитьПараметр("Склад",						Объект.СкладПолучатель);
	Запрос.УстановитьПараметр("ИспользуютсяОбщиеСклады",	Константы.ОбщиеСклады.Получить());
	Запрос.УстановитьПараметр("ИспользоватьРезервирование",	ПолучитьФункциональнуюОпцию("ИспользоватьРезервирование"));
	Запрос.УстановитьПараметр("ДатаГраница",				Новый Граница(ДатаОстатков, ВидГраницы.Исключая));

	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЗ_ТаблицаДокумента.Номенклатура КАК Номенклатура,
	|	ТЗ_ТаблицаДокумента.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ТЗ_ТаблицаДокумента.СерияНоменклатуры КАК СерияНоменклатуры,
	|	ТЗ_ТаблицаДокумента.Коэффициент КАК Коэффициент
	|ПОМЕСТИТЬ ВремТаблицаДокумента
	|ИЗ
	|	&ТаблицаДокумента КАК ТЗ_ТаблицаДокумента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВремТаблицаДокумента.Номенклатура КАК Номенклатура,
	|	ВремТаблицаДокумента.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ВремТаблицаДокумента.СерияНоменклатуры КАК СерияНоменклатуры,
	|	ВЫБОР
	|		КОГДА ВремТаблицаДокумента.Коэффициент <> 0
	|			ТОГДА ЕСТЬNULL(ТоварыНаСкладахОстатки.КоличествоОстаток, 0) / ВремТаблицаДокумента.Коэффициент
	|		ИНАЧЕ ЕСТЬNULL(ТоварыНаСкладахОстатки.КоличествоОстаток, 0)
	|	КОНЕЦ КАК ОстатокНаСкладе,
	|	ВЫБОР
	|		КОГДА &ИспользоватьРезервирование
	|			ТОГДА ВЫБОР
	|					КОГДА ВремТаблицаДокумента.Коэффициент <> 0
	|						ТОГДА ЕСТЬNULL(ВРезервеОстатки.КоличествоОстаток, 0) / ВремТаблицаДокумента.Коэффициент
	|					ИНАЧЕ ЕСТЬNULL(ВРезервеОстатки.КоличествоОстаток, 0)
	|				КОНЕЦ
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ВРезерве
	|ИЗ
	|	ВремТаблицаДокумента КАК ВремТаблицаДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаСкладах.Остатки(
	|				&ДатаГраница,
	|				ВЫБОР
	|						КОГДА &ИспользуютсяОбщиеСклады
	|							ТОГДА ИСТИНА
	|						ИНАЧЕ Организация = &Организация
	|					КОНЕЦ
	|					И Склад = &Склад) КАК ТоварыНаСкладахОстатки
	|		ПО ВремТаблицаДокумента.Номенклатура = ТоварыНаСкладахОстатки.Номенклатура
	|			И ВремТаблицаДокумента.ХарактеристикаНоменклатуры = ТоварыНаСкладахОстатки.ХарактеристикаНоменклатуры
	|			И ВремТаблицаДокумента.СерияНоменклатуры = ТоварыНаСкладахОстатки.СерияНоменклатуры
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(
	|				&ДатаГраница,
	|				Склад = &Склад
	|					И ВЫБОР
	|						КОГДА &ИспользуютсяОбщиеСклады
	|							ТОГДА ИСТИНА
	|						ИНАЧЕ Организация = &Организация
	|					КОНЕЦ) КАК ВРезервеОстатки
	|		ПО ВремТаблицаДокумента.Номенклатура = ВРезервеОстатки.Номенклатура
	|			И ВремТаблицаДокумента.ХарактеристикаНоменклатуры = ВРезервеОстатки.ХарактеристикаНоменклатуры
	|			И ВремТаблицаДокумента.СерияНоменклатуры = ВРезервеОстатки.СерияНоменклатуры";

	РезультатЗапроса = Запрос.Выполнить().Выгрузить();

	Для Каждого ТекущаяСтрока Из Объект.Товары Цикл

		Отбор = Новый Структура("Номенклатура, ХарактеристикаНоменклатуры, СерияНоменклатуры");
		ЗаполнитьЗначенияСвойств(Отбор, ТекущаяСтрока);

		НайденныеСтроки = РезультатЗапроса.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество() > 0 Тогда
			ОстатокПолучателя = НайденныеСтроки[0].ОстатокНаСкладе;
			РезервПолучателя = НайденныеСтроки[0].ВРезерве;
		Иначе
			ОстатокПолучателя = 0;
			РезервПолучателя = 0;
		КонецЕсли;

		ТекущаяСтрока.НВД_ОстатокПолучателя = ОстатокПолучателя;
		ТекущаяСтрока.НВД_ДоступноПолучателя = ОстатокПолучателя - РезервПолучателя;

	КонецЦикла;

КонецПроцедуры
