&НаСервере
Функция ПолучитьКонтактноеЛицо(Телефон, Наименование)
	
	КонтактноеЛицоСсылка = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	КонтактныеЛицаКонтактнаяИнформация.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КонтактныеЛица.КонтактнаяИнформация КАК КонтактныеЛицаКонтактнаяИнформация
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтактныеЛица КАК КонтактныеЛица
		|		ПО (КонтактныеЛицаКонтактнаяИнформация.Ссылка = КонтактныеЛица.Ссылка)
		|ГДЕ
		|	(СТРНАЙТИ(СТРЗАМЕНИТЬ(СТРЗАМЕНИТЬ(СТРЗАМЕНИТЬ(СТРЗАМЕНИТЬ(СТРЗАМЕНИТЬ(КонтактныеЛицаКонтактнаяИнформация.НомерТелефона, ""+7"", """"), "" "", """"), ""-"", """"), ""("", """"), "")"", """"), &НомерТелефона) > 0
		|			ИЛИ СТРНАЙТИ(СТРЗАМЕНИТЬ(СТРЗАМЕНИТЬ(СТРЗАМЕНИТЬ(СТРЗАМЕНИТЬ(СТРЗАМЕНИТЬ(КонтактныеЛицаКонтактнаяИнформация.Представление, ""+7"", """"), "" "", """"), ""-"", """"), ""("", """"), "")"", """"), &НомерТелефона) > 0
		|			ИЛИ СТРНАЙТИ(СТРЗАМЕНИТЬ(СТРЗАМЕНИТЬ(СТРЗАМЕНИТЬ(СТРЗАМЕНИТЬ(СТРЗАМЕНИТЬ(КонтактныеЛицаКонтактнаяИнформация.Значение, ""+7"", """"), "" "", """"), ""-"", """"), ""("", """"), "")"", """"), &НомерТелефона) > 0)
		|	И КонтактныеЛица.ОбъектВладелец = &Владелец";
	
	Запрос.УстановитьПараметр("Владелец", Объект.Получатель);
	Запрос.УстановитьПараметр("НомерТелефона", Телефон);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		КонтактноеЛицоСсылка = ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КонтактноеЛицоСсылка) Тогда
		Возврат КонтактноеЛицоСсылка;
	КонецЕсли;
	
	КонтактноеЛицоОбъект = Справочники.КонтактныеЛица.СоздатьЭлемент();
	КонтактноеЛицоОбъект.ОбъектВладелец = Объект.Получатель;
	КонтактноеЛицоОбъект.Наименование = ?(ЗначениеЗаполнено(Наименование), Наименование, Лев(ТелефонКонтактногоЛица, 18));
	КИСтрока = КонтактноеЛицоОбъект.КонтактнаяИнформация.Добавить();
	КИСтрока.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон;
	КИСтрока.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонКонтактногоЛица;
	КИСтрока.НомерТелефона = "+7" + Телефон;
	КИСтрока.Представление = "+7" + Телефон;
	КонтактноеЛицоОбъект.Записать();
	
	Возврат КонтактноеЛицоОбъект.Ссылка;
		
КонецФункции	

