Функция ТелефонЗаполнен(ВладелецКонтактнойИформации)
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "
		|ВЫБРАТЬ
		|	КонтактнаяИнформация.НомерТелефона КАК НомерТелефона,
		|	КонтактнаяИнформация.НомерТелефонаБезКодов КАК НомерТелефонаБезКодов,
		|	КонтактнаяИнформация.Значение КАК Значение
		|ИЗ
		|	Справочник.@ВладелецКИ@.КонтактнаяИнформация КАК КонтактнаяИнформация
		|ГДЕ
		|	КонтактнаяИнформация.Тип = &Тип
		|	И КонтактнаяИнформация.Вид = &Вид
		|	И КонтактнаяИнформация.Ссылка = &Ссылка";
	
	Если ТипЗнч(ВладелецКонтактнойИформации) = Тип("СправочникСсылка.КонтактныеЛица") Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "@ВладелецКИ@", "КонтактныеЛица");
	ИначеЕсли ТипЗнч(ВладелецКонтактнойИформации) = Тип("СправочникСсылка.Контрагенты") Тогда
	    ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "@ВладелецКИ@", "Контрагенты");
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса; 
	
    Если ТипЗнч(ВладелецКонтактнойИформации) = Тип("СправочникСсылка.КонтактныеЛица") Тогда
		Запрос.УстановитьПараметр("Вид", Справочники.ВидыКонтактнойИнформации.ТелефонКонтактногоЛица);
	ИначеЕсли ТипЗнч(ВладелецКонтактнойИформации) = Тип("СправочникСсылка.Контрагенты") Тогда
	    Запрос.УстановитьПараметр("Вид", Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Тип", Перечисления.ТипыКонтактнойИнформации.Телефон);
	Запрос.УстановитьПараметр("Ссылка", ВладелецКонтактнойИформации); 

	ТЗКИ = Запрос.Выполнить().Выгрузить();
	
	Если ТЗКИ.Количество() > 0 Тогда
		Возврат ИСТИНА;
	Иначе
		Возврат ЛОЖЬ;
	КонецЕсли;	
		 
КонецФункции	 
 
