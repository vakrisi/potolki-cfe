&После("ЗаполнитьПоЗаказуПокупателяИлиРеализацииТоваровИУслуг")
Процедура НВД_ЗаполнитьПоЗаказуПокупателяИлиРеализацииТоваровИУслуг(ДанныеЗаполнения)
	
	МассивДокументов = Новый Массив;
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказПокупателя") Или ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.РеализацияТоваровИУслуг") Тогда
		МассивДокументов.Добавить(ДанныеЗаполнения);		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("Массив") Тогда
		МассивДокументов = ДанныеЗаполнения;
	Иначе
		Возврат;
	КонецЕсли;
	
	СуммаДоставки = 0;
	
	Для Каждого ЭлементМассива из МассивДокументов Цикл
		
		Если Получатель <> ЭлементМассива.Контрагент Тогда
			Текст = НСтр("ru = 'Контрагенты в выделенных документах различаются, создание документа невозможно'");
			ВызватьИсключение Текст;
		КонецЕсли;
		
		Если Организация <> ЭлементМассива.Организация Тогда
			Текст = НСтр("ru = 'Организации в выделенных документах различаются, создание документа невозможно'");
			ВызватьИсключение Текст;
		КонецЕсли;
		
		Для Каждого ТекущаяСтрокаТоварыОснования Из ЭлементМассива.Товары Цикл
			
			Если ТекущаяСтрокаТоварыОснования.Номенклатура =ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.Номенклатура.Доставка") ИЛИ
				ТекущаяСтрокаТоварыОснования.Номенклатура =ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.Номенклатура.Доставка2") ИЛИ
				ТекущаяСтрокаТоварыОснования.Номенклатура =ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.Номенклатура.Доставка3") ИЛИ
				ТекущаяСтрокаТоварыОснования.Номенклатура =ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.Номенклатура.Доставка4") ИЛИ
				ТекущаяСтрокаТоварыОснования.Номенклатура =ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.Номенклатура.Доставка5") Тогда
				СуммаДоставки = СуммаДоставки + ТекущаяСтрокаТоварыОснования.Сумма;
			КонецЕсли;			
		КонецЦикла;
		
	КонецЦикла;
	
	СтоимостьДоставки = СуммаДоставки;
	
КонецПроцедуры
